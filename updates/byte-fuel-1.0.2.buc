 .lg.bw{font-size:44px;margin:6px 0 10px}\n.thg{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}.thopt{border:2px solid var(--bd);border-radius:14px;padding:8px;cursor:pointer;text-align:center;background:#fff;transition:transform .15s}.thopt:hover{transform:translateY(-2px)}.thopt.on{border-color:var(--blue);box-shadow:0 0 0 3px color-mix(in srgb,var(--blue) 25%,transparent)}\n.thp{height:64px;border-radius:10px;position:relative;overflow:hidden;margin-bottom:6px;display:grid;place-items:center}.thp i{position:absolute;left:8px;right:8px;height:12px;border-radius:6px}.thp i:first-child{top:12px}.thp i:last-of-type{bottom:12px;opacity:.9}.thp input{width:46px;height:46px;border:3px solid #fff;border-radius:50%;padding:0;cursor:pointer;background:none}\n.fg{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}.fopt{border:2px solid var(--bd);border-radius:12px;padding:10px 12px;cursor:pointer;background:#fff}.fopt.on{border-color:var(--blue);background:color-mix(in srgb,var(--blue) 7%,#fff)}.fopt b{display:block;font-size:15px}.fopt span{display:block;font-size:17px;margin:4px 0}.fopt small{color:var(--mut);font-size:11px;font-family:\"Segoe UI\",Tahoma,sans-serif}\n/* أيقونات لامعة */\n.gi{--c1:#6aa8ff;--c2:#2457ff;position:relative;display:inline-grid;place-items:center;width:36px;height:36px;border-radius:11px;flex-shrink:0;overflow:hidden;color:#fff;font-style:normal;\n background:linear-gradient(145deg,var(--c1),var(--c2));border:1px solid rgba(255,255,255,.45);\n box-shadow:0 4px 12px -2px var(--c2),inset 0 1px 1px rgba(255,255,255,.75),inset 0 -3px 6px rgba(0,0,0,.22);transition:transform .2s,box-shadow .2s}\n.gi::before{content:'';position:absolute;left:2px;right:2px;top:1px;height:48%;border-radius:10px 10px 50% 50%/10px 10px 26% 26%;background:linear-gradient(180deg,rgba(255,255,255,.75),rgba(255,255,255,.08));pointer-events:none}\n.gi::after{content:'';position:absolute;top:-60%;left:-80%;width:45%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85),transparent);transform:rotate(25deg);animation:gshine 4.5s ease-in-out infinite;pointer-events:none}\n.gi svg{position:relative;z-index:1;filter:drop-shadow(0 1.5px 1.5px rgba(0,0,0,.35));opacity:1!important}\n.gi.lg{width:44px;height:44px;border-radius:13px}\n@keyframes gshine{0%,70%{left:-80%}100%{left:150%}}\n.nav a:hover .gi,.ptitle .gi:hover,.box h3 .gi:hover{transform:translateY(-2px) scale(1.06)}\n.nav a.on .gi{box-shadow:0 0 0 2px rgba(255,255,255,.9),0 0 18px 2px var(--c1),inset 0 1px 1px rgba(255,255,255,.75)}\n.kgi{position:relative;display:grid;place-items:center;width:66px;height:66px;border-radius:50%;overflow:hidden;flex-shrink:0;\n background:radial-gradient(circle at 35% 28%,rgba(255,255,255,.75),rgba(255,255,255,.22) 45%,rgba(255,255,255,.08) 70%);border:1.5px solid rgba(255,255,255,.7);box-shadow:0 6px 16px rgba(0,0,0,.25),inset 0 -4px 10px rgba(0,0,0,.18)}\n.kgi::after{content:'';position:absolute;top:-60%;left:-80%;width:45%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);transform:rotate(25deg);animation:gshine 3.8s ease-in-out infinite}\n.kgi svg{filter:drop-shadow(0 2px 3px rgba(0,0,0,.35)) drop-shadow(0 0 6px rgba(255,255,255,.6))}\n.pump>span svg{filter:drop-shadow(0 3px 4px rgba(0,0,0,.25)) drop-shadow(0 0 8px currentColor)}\n.topbar .bell svg{filter:drop-shadow(0 0 6px #ffd166)}\n@media (prefers-reduced-motion:reduce){.gi::after,.kgi::after{animation:none;display:none}}\n@media (max-width:1100px){.kpis{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}}\n@media (max-width:760px){\n html,body{overflow-x:hidden}\n .app{display:block}\n .side{position:fixed;right:0;top:0;z-index:40;transition:transform .2s;transform:translateX(105%);visibility:hidden}\n .side.open{transform:none;visibility:visible;box-shadow:-10px 0 30px rgba(0,0,0,.4)}\n .kpi{padding:12px}.kpi svg{width:32px;height:32px}.kpi .t{font-size:13px}\n .burger{display:block}\n .hero{height:150px}.hero .img{width:100%;max-width:none;aspect-ratio:auto;background-size:cover!important;opacity:.35}\n .hero .ttl{right:16px;top:58px} .topbar{right:auto;left:14px;top:12px}.hero h1{font-size:21px}\n .kpis{grid-template-columns:1fr 1fr;gap:10px}.kpi .v{font-size:20px}\n .content{padding:12px}\n}\n</style>\n</head>\n<body>\n<div id=\"root\"></div>\n<div id=\"modal\"></div>\n<script>\n'use strict';\n/* ================= أساسيات ================= */\nconst APP_VER='1.0.2',UPD_URL='https://alaqamihsan-ux.github.io/byteprog/updates/byte-fuel.json';\nconst KEY='byte_fuel_db_v1',SNAP='byte_fuel_snaps_v1',SES='byte_fuel_ses';\nconst COPY='© حقوق النشر والطبع محفوظة — المهندس احسان العكام — بايت للبرمجة';\nconst $=s=>document.querySelector(s);\nconst uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);\nconst r2=n=>Math.round((+n||0)*100)/100;\nconst fmt=n=>r2(n).toLocaleString('en-US');\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction today(d){d=d||new Date();const z=new Date(d.getTime()-d.getTimezoneOffset()*60000);return z.toISOString().slice(0,10)}\nconst nowT=()=>{const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')};\nconst t12=t=>{if(!t)return'';let[h,m]=t.split(':').map(Number);const ap=h>=12?'م':'ص';h=h%12||12;return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+' '+ap};\nconst month=d=>(d||today()).slice(0,7);\nconst cur=()=>db.settings.cur||'د.ع';\nconst money=n=>`<span class=\"num\">${fmt(n)}</span>`;\nconst ZK='byte_fuel_zoom';\nfunction getZoom(){let z=100;try{z=parseInt(localStorage.getItem(ZK))||100}catch(e){}return Math.min(150,Math.max(50,z))}\nfunction applyZoom(z){z=Math.min(150,Math.max(50,Math.round(z/5)*5));document.body.style.zoom=z/100;document.documentElement.style.setProperty('--z',z/100);return z}\nfunction setZoom(z){z=applyZoom(z);try{localStorage.setItem(ZK,z)}catch(e){}const l=document.getElementById('zl');if(l)l.textContent=z+'%';const r=document.getElementById('zr');if(r)r.value=z}\nconst NOZ='<svg viewBox=\"0 0 32 32\" width=\"26\" height=\"26\"><path fill=\"currentColor\" d=\"M3 9.5c0-1.4 1.1-2.5 2.5-2.5h9.8c.7 0 1.3.3 1.8.7l3.4 3.3H26c.6 0 1 .4 1 1v1.6c0 .6-.4 1-1 1h-4l-1.6 2.6c-.3.5-.8.8-1.4.8H8.2c-.6 0-1.1-.3-1.4-.8L5.4 15H5.5C4.1 15 3 13.9 3 12.5z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" d=\"M24 14.5c2.8 1.2 4 3.6 3.6 7.5\"/><circle cx=\"27.4\" cy=\"25\" r=\"1.6\" fill=\"currentColor\"/><path fill=\"#fff\" opacity=\".45\" d=\"M6 8.6h8.6c.5 0 .9.2 1.2.5l1.4 1.4H6.2c-.6 0-.9-.6-.6-1z\"/></svg>';\nconst DAYS=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];\nfunction hp(s){let h=5381;s='BYTE-FUEL|'+s;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return(h>>>0).toString(36)}\n\n/* ================= أيقونات ================= */\nconst I={\nhome:'<path d=\"M3 11l9-8 9 8M5 9.5V21h5v-6h4v6h5V9.5\"/>',\npump:'<path d=\"M4 21V5a2 2 0 012-2h7a2 2 0 012 2v16M3 21h13M7 6.5h5v4H7z\"/><path d=\"M15 9h2l2 2v7a1.5 1.5 0 003 0V8l-3-3\"/>',\ntruck:'<path d=\"M2 6h11v10H2zM13 10h4l3 3v3h-7\"/><circle cx=\"6\" cy=\"18\" r=\"2\"/><circle cx=\"17\" cy=\"18\" r=\"2\"/>',\ntank:'<path d=\"M4 7c0-2.7 16-2.7 16 0v10c0 2.7-16 2.7-16 0zM4 7c0 2.7 16 2.7 16 0M4 12c0 2.7 16 2.7 16 0\"/>',\nbox:'<path d=\"M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10\"/>',\nusers:'<circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M2 21v-1a7 7 0 0114 0v1M16 3.3a4 4 0 010 7.4M22 21v-1a6 6 0 00-4-5.7\"/>',\nmoney:'<rect x=\"2.5\" y=\"6\" width=\"19\" height=\"12\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M6 9v.01M18 15v.01\"/>',\nbag:'<path d=\"M9 3h6l-2 4h-2zM6 21h12a2 2 0 002-2c0-6-4-12-8-12S4 13 4 19a2 2 0 002 2z\"/><path d=\"M12 11v6M10 12.5h3a1 1 0 010 2h-2a1 1 0 000 2h3\"/>',\nbook:'<path d=\"M4 4h12a3 3 0 013 3v14H7a3 3 0 01-3-3zM4 18a3 3 0 013-3h12\"/>',\nchart:'<path d=\"M4 20V11M10 20V5M16 20v-7M21 20H3\"/><path d=\"M4 8l6-4 6 5 5-4\"/>',\nlog:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>',\nlock:'<rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 018 0v4\"/>',\ngear:'<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1\"/>',\ndb:'<path d=\"M4 6c0-3.3 16-3.3 16 0v12c0 3.3-16 3.3-16 0zM4 6c0 3.3 16 3.3 16 0M4 12c0 3.3 16 3.3 16 0\"/>',\npower:'<path d=\"M12 3v9M6.3 6.3a8 8 0 1011.4 0\"/>',\nbell:'<path d=\"M6 16v-5a6 6 0 0112 0v5l2 2H4zM10 21h4\"/>',\ncart:'<path d=\"M3 4h2l2.5 11h11L21 7H6.2\"/><circle cx=\"9\" cy=\"19.5\" r=\"1.3\"/><circle cx=\"18\" cy=\"19.5\" r=\"1.3\"/>',\ncoins:'<ellipse cx=\"12\" cy=\"6\" rx=\"7\" ry=\"3\"/><path d=\"M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3\"/>',\nclock:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>',\nplus:'<path d=\"M12 5v14M5 12h14\"/>',\nprint:'<path d=\"M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z\"/>',\nmenu:'<path d=\"M3 6h18M3 12h18M3 18h18\"/>',\nlist:'<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/>',\nuser:'<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0116 0\"/>',\nreceipt:'<path d=\"M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2zM9 8h6M9 12h6\"/>'\n};\nconst GC={print:['#9fb3c8','#475569'],home:['#ffb26b','#ff5e62'],pump:['#3df5b4','#00a86b'],clock:['#ffe066','#ff9800'],truck:['#5fd0ff','#1e6bff'],tank:['#4ff0ff','#0089c2'],box:['#d19bff','#7b2ff7'],\n users:['#ff9ac4','#e8306d'],cart:['#ffc56b','#ff6a00'],money:['#6ff59a','#0e9f52'],bag:['#ff8fa8','#d7263d'],user:['#8fb4ff','#3a50ff'],chart:['#4ff5dc','#079b8f'],\n log:['#c6f76a','#5aa312'],lock:['#ffd76b','#d98200'],gear:['#b3b9ff','#5b4bff'],db:['#ff9be3','#b316b8'],power:['#ff8a8a','#c81d25'],list:['#7fdcff','#2a7fff'],plus:['#7ef0a8','#16a34a'],receipt:['#ffe08a','#e09a00']};\nconst gi=(n,s=20,c='')=>{const g=GC[n]||['#7aa9ff','#2457ff'];return`<i class=\"gi ${c}\" style=\"--c1:${g[0]};--c2:${g[1]}\">${ic(n,s)}</i>`};\nconst ic=(n,s=22)=>`<svg viewBox=\"0 0 24 24\" width=\"${s}\" height=\"${s}\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${I[n]||''}</svg>`;\n\n/* ================= البيانات ================= */\nlet db,me=null,page='home',st={},DEMO=false;\nfunction blank(){return{settings:{name:'محطة الوقود',address:'',phone:'',cur:'د.ع',low:20,shiftNo:1,\n expCats:['كهرباء','مولدة','صيانة','نظافة','ضيافة','نقل','ضرائب ورسوم','أخرى'],revCats:['غسل سيارات','بدل خدمات','إيجار','أخرى'],demoAuto:false,demoLoaded:false,demoFuels:null,autoBk:{on:true,min:60,mode:'internal'},print:null,lanes:[{k:'A',color:'#1565d8'},{k:'B',color:'#eab308'},{k:'C',color:'#dc2626'},{k:'D',color:'#7c3aed'}]},\n users:[],employees:[],fuels:[],tanks:[],disps:[],pumps:[],shifts:[],sales:[],receipts:[],dips:[],items:[],moves:[],\n suppliers:[],customers:[],debts:[],cash:[],advances:[],payroll:[],log:[]}}\nfunction load(){try{db=JSON.parse(localStorage.getItem(KEY))}catch(e){db=null}if(!db||typeof db!=='object')db=blank();migrate()}\nfunction migrate(){const b=blank();for(const k in b)if(db[k]==null)db[k]=b[k];for(const k in b.settings)if(db.settings[k]==null)db.settings[k]=b.settings[k];\n if(!db.users.length)db.users.push({id:uid(),name:'المدير العام',user:'admin',pass:hp('admin'),role:'admin',perms:[],active:true});\n if(!db.fuels.length)db.fuels.push({id:uid(),name:'بنزين عادي',price:0,cost:0,color:'#16a34a'},{id:uid(),name:'بنزين محسن',price:0,cost:0,color:'#dc2626'},{id:uid(),name:'كاز',price:0,cost:0,color:'#1d4ed8'});\n db.pumps.forEach(p=>{if(p.active==null)p.active=true;if(p.meter==null)p.meter=0});\n // كل مضخة بيها عدادين: يمين ويسار\n db.pumps.slice().forEach(p=>{if(p.dispId&&byId(db.disps,p.dispId))return;const base=String(p.name||'مضخة').replace(/ — (يمين|يسار)$/,'');\n  const d={id:uid(),name:base};if(p.px!=null){d.px=p.px;d.py=p.py}if(p.demo)d.demo=true;db.disps.push(d);delete p.px;delete p.py;\n  p.dispId=d.id;p.side='R';p.name=base+' — يمين';\n  d.lane=(db.settings.lanes&&db.settings.lanes[0]||{k:'A'}).k;const L={id:uid(),name:base+' — يسار',dispId:d.id,side:'L',tankId:p.tankId,fuelId:p.fuelId,meter:p.demo?Math.round(p.meter*0.97):0,active:p.active};if(p.demo)L.demo=true;db.pumps.push(L)});\n db.items.forEach(i=>{if(i.min==null)i.min=0});\n if(!Array.isArray(db.settings.lanes)||!db.settings.lanes.length)db.settings.lanes=blank().settings.lanes;\n {const OLD={1:'#f97316',2:'#7c3aed',3:'#0d9488'};db.settings.lanes.forEach((l,i)=>{if(OLD[i]&&l.color===OLD[i])l.color=LANEPAL[i]})}\n db.settings.print=Object.assign(defPrint(),db.settings.print||{});db.settings.print.map=Object.assign(defPrint().map,(db.settings.print||{}).map||{});\n if(!db.settings.autoBk||typeof db.settings.autoBk!=='object')db.settings.autoBk={on:true,min:60,mode:'internal'};\n db.disps.forEach(d=>{if(!d.lane||!db.settings.lanes.some(l=>l.k===d.lane))d.lane=db.settings.lanes[0].k});\n}\nfunction persist(){try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){alert('تعذر الحفظ: مساحة التخزين ممتلئة. صدّر نسخة احتياطية واحذف السجلات القديمة.')}\n try{let sn=JSON.parse(localStorage.getItem(SNAP)||'[]');const d=today();if(!sn.some(x=>x.d===d)){sn.push({d,t:nowT(),data:JSON.stringify(db)});sn=sn.slice(-5);localStorage.setItem(SNAP,JSON.stringify(sn))}}catch(e){}\n if(typeof NET!=='undefined'&&NET.on){netQueue();netBadge()}}\nfunction save(act,det){if(act){const L={id:uid(),date:today(),time:nowT(),u:me?me.name:'-',a:act,d:det||''};if(DEMO)L.demo=true;db.log.unshift(L);if(db.log.length>6000)db.log.length=6000}persist()}\n\n/* ================= الصلاحيات والقائمة ================= */\nconst NAV=[\n['home','الرئيسية','home'],['sales','مبيعات الوقود','pump'],['shifts','الشفتات والعدادات','clock'],['purchases','مشتريات الوقود','truck'],\n['tanks','إدارة الخزانات والمضخات','tank'],['stock','المخزون (زيوت ومواد)','box'],['customers','حسابات العملاء والديون','users'],\n['cash','الصندوق والحسابات','money'],['exprev','المصاريف والإيرادات','bag'],\n['employees','الموظفون والرواتب','user'],['reports','التقارير والإحصائيات','chart'],['log','سجل العمليات','log'],\n['settings','الإعدادات','gear']];\nconst XPERM=[['suppliers','المجهزين والموردين (داخل المشتريات)'],['users','المستخدمين والصلاحيات (داخل الإعدادات)'],['backup','النسخ الاحتياطي (داخل الإعدادات)'],['del','حذف العمليات والسجلات']];\nconst can=k=>me&&(me.role==='admin'||k==='home'||(me.perms||[]).includes(k));\n\n/* ================= مساعدات ================= */\nconst byId=(a,id)=>a.find(x=>x.id===id);\nconst fuelOf=id=>byId(db.fuels,id)||{name:'-',price:0,cost:0,color:'#888'};\nconst nm=(a,id,d='-')=>(byId(a,id)||{}).name||d;\nconst pumpShift=pid=>db.shifts.find(s=>s.status==='open'&&s.readings.some(r=>r.pumpId===pid));\nconst lit=r=>Math.max(0,r2((+r.end||0)-(+r.start||0)));\nfunction addCash(o){const c=Object.assign({id:uid(),date:today(),time:nowT(),by:me?me.name:'-',note:''},o);c.amount=r2(c.amount);if(DEMO)c.demo=true;db.cash.push(c);return c}\nconst cashBal=()=>r2(db.cash.reduce((a,c)=>a+(c.type==='in'?c.amount:-c.amount),0));\nconst KIND={sale:'مبيعات وقود',stock:'مبيعات مواد',cap:'رأس مال',dep:'إيداع',wd:'سحب',exp:'مصروف',rev:'إيراد',sup:'دفع لمورد',cust:'قبض من عميل',adv:'سلفة موظف',sal:'راتب',short:'عجز شفت',over:'زيادة شفت',oin:'وارد آخر',oout:'صادر آخر'};\nfunction custBal(c){let b=+c.opening||0;\n db.sales.forEach(s=>{if(s.pay==='credit'&&s.customerId===c.id)b+=s.amount});\n db.moves.forEach(m=>{if(m.type==='out'&&m.pay==='credit'&&m.customerId===c.id)b+=m.amount});\n db.debts.forEach(d=>{if(d.customerId===c.id)b+=d.amount});\n db.cash.forEach(x=>{if(x.kind==='cust'&&x.customerId===c.id)b-=x.amount});return r2(b)}\nfunction supBal(s){let b=+s.opening||0;\n db.receipts.forEach(r=>{if(r.supplierId===s.id)b+=r.total});\n db.moves.forEach(m=>{if(m.type==='in'&&m.supplierId===s.id)b+=m.amount});\n db.cash.forEach(x=>{if(x.type==='out'&&x.supplierId===s.id)b-=x.amount});return r2(b)}\nconst pendAdv=eid=>r2(db.advances.filter(a=>a.empId===eid&&!a.payrollId).reduce((s,a)=>s+a.amount,0));\nfunction tbl(h,rows,foot){if(!rows.length)return`<div class=\"tw\"><div class=\"empty\">لا توجد بيانات</div></div>`;\n return`<div class=\"tw\"><table><thead><tr>${h.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody>${foot?`<tfoot><tr>${foot.map(c=>`<th>${c}</th>`).join('')}</tr></tfoot>`:''}</table></div>`}\nconst fmtIn=v=>{if(v===''||v==null)return'';const n=parseFloat(String(v).replace(/,/g,''));if(isNaN(n))return String(v);return n.toLocaleString('en-US',{maximumFractionDigits:3})};\nconst RLM='\\u200F';\nconst fmtDate=v=>{v=String(v||'');let m=v.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);if(m)return m[3]+RLM+'/'+m[2]+RLM+'/'+m[1];m=v.match(/^(\\d{4})-(\\d{2})$/);if(m)return m[2]+RLM+'/'+m[1];return v};\nfunction fixDates(root){if(!root)return;const doc=root.ownerDocument||document;const w=doc.createTreeWalker(root,4,null);const re=/(^|[^\\d\\-\\/:])(\\d{4})-(\\d{2})(?:-(\\d{2}))?(?![\\d\\-])/g;let n;const L=[];\n while(n=w.nextNode()){const p=n.parentNode;if(!p||/^(SCRIPT|STYLE|TEXTAREA|OPTION)$/.test(p.nodeName))continue;if(/\\d{4}-\\d{2}/.test(n.nodeValue))L.push(n)}\n L.forEach(n=>{n.nodeValue=n.nodeValue.replace(re,(a,pre,y,mo,d)=>pre+(d?d+RLM+'/'+mo+RLM+'/'+y:mo+RLM+'/'+y))})}\nconst fi=(l,id,v='',t='text',x='')=>(t==='date'||t==='month')?`<div class=\"f\"><label>${l}</label><div class=\"dti-w\"><input id=\"${id}\" type=\"${t}\" class=\"dti\" value=\"${esc(v)}\" onclick=\"try{this.showPicker()}catch(e){}\" ${x}><span class=\"dts\" dir=\"rtl\">${esc(fmtDate(v))}</span></div></div>`:t==='number'?`<div class=\"f\"><label>${l}</label><input id=\"${id}\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" class=\"nf\" value=\"${esc(fmtIn(v))}\" ${x}></div>`:`<div class=\"f\"><label>${l}</label><input id=\"${id}\" type=\"${t}\" value=\"${esc(v)}\" ${x}></div>`;\nconst ltSplit=v=>{if(v===''||v==null)return['','',''];const n=r2(parseFloat(String(v).replace(/,/g,''))||0);const i=Math.floor(n+1e-9),f=Math.round((n-i)*100);const fs=String(f).padStart(2,'0');return[fmtIn(i),f?fs[0]:'',f?fs[1]:'']};\nconst ltIn=(id,v,x='',ph='')=>{const[a,b,c]=ltSplit(v);const dis=/\\bdisabled\\b/.test(x)?'disabled':'';return`<div class=\"ltw\"><input id=\"${id}\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" class=\"nf lt\" value=\"${esc(a)}\" ${ph?`placeholder=\"${esc(ph)}\"`:''} ${x}><b class=\"ldot\">.</b><input id=\"${id}_f1\" class=\"lf\" data-for=\"${id}\" inputmode=\"numeric\" maxlength=\"1\" value=\"${b}\" placeholder=\"0\" title=\"أجزاء اللتر\" ${dis}><input id=\"${id}_f2\" class=\"lf\" data-for=\"${id}\" inputmode=\"numeric\" maxlength=\"1\" value=\"${c}\" placeholder=\"0\" title=\"أجزاء اللتر\" ${dis}><small class=\"lml\">لتر</small></div>`};\nconst fl=(l,id,v='',x='')=>`<div class=\"f\"><label>${l} <small style=\"color:#94a3b8;font-weight:500\">(+ أجزاء اللتر اختياري)</small></label>${ltIn(id,v,x)}</div>`;\nfunction setNF(id,v){const e=document.getElementById(id);if(!e)return;if(e.classList.contains('lt')){const[a,b,c]=ltSplit(v);e.value=a;const f1=document.getElementById(id+'_f1'),f2=document.getElementById(id+'_f2');if(f1)f1.value=b;if(f2)f2.value=c}else e.value=fmtIn(v)}\ndocument.addEventListener('input',e=>{const el=e.target;if(!el||!el.classList||!el.classList.contains('lf'))return;el.value=el.value.replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/\\D/g,'').slice(-1);\n if(el.value&&el.id.endsWith('_f1')){const n=document.getElementById(el.dataset.for+'_f2');if(n){n.focus();n.select()}}const m=document.getElementById(el.dataset.for);if(m)m.dispatchEvent(new Event('input',{bubbles:true}))},true);\ndocument.addEventListener('keydown',e=>{const el=e.target;if(!el||!el.classList)return;\n if(el.classList.contains('lt')&&(e.key==='.'||e.key==='٫')){e.preventDefault();const n=document.getElementById(el.id+'_f1');if(n){n.focus();n.select()}}\n if(el.classList.contains('lf')&&e.key==='Backspace'&&!el.value&&el.id.endsWith('_f2')){const n=document.getElementById(el.dataset.for+'_f1');if(n)n.focus()}\n if(el.classList.contains('lf')&&e.key==='Enter'){const m=document.getElementById(el.dataset.for);if(m)m.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}))}},true);\n['input','change'].forEach(ev=>document.addEventListener(ev,e=>{const el=e.target;if(el&&el.classList&&el.classList.contains('dti')){const sp=el.nextElementSibling;if(sp)sp.textContent=fmtDate(el.value)}},true));\ndocument.addEventListener('input',e=>{const el=e.target;if(!el||!el.classList||!el.classList.contains('nf'))return;\n let v=el.value.replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/٫/g,'.');const pos=el.selectionStart==null?v.length:el.selectionStart;\n const before=v.slice(0,pos).replace(/[^\\d.]/g,'').length;let neg=/^\\s*-/.test(v);v=v.replace(/[^\\d.]/g,'');const i=v.indexOf('.');if(i>=0)v=v.slice(0,i+1)+v.slice(i+1).replace(/\\./g,'');\n let[a,b]=v.split('.');a=(a||'').replace(/^0+(?=\\d)/,'');const out=(neg?'-':'')+a.replace(/\\B(?=(\\d{3})+(?!\\d))/g,',')+(b!==undefined?'.'+b:'');\n if(out!==el.value){el.value=out;let c=0,k=0;while(k<out.length&&c<before){if(/[\\d.]/.test(out[k]))c++;k++}try{el.setSelectionRange(k+(neg?1:0)*(k===0?1:0),k+(neg?1:0)*(k===0?1:0))}catch(x){}}},true);\nconst fs=(l,id,opts,sel='',x='')=>`<div class=\"f\"><label>${l}</label><select id=\"${id}\" ${x}>${opts.map(o=>`<option value=\"${esc(o[0])}\" ${String(o[0])===String(sel)?'selected':''}>${esc(o[1])}</option>`).join('')}</select></div>`;\nconst ft=(l,id,v='')=>`<div class=\"f\" style=\"flex-basis:100%\"><label>${l}</label><textarea id=\"${id}\" rows=\"3\">${esc(v)}</textarea></div>`;\nconst V=id=>{const e=document.getElementById(id);if(!e)return'';let v=(e.classList.contains('nf')?e.value.replace(/,/g,''):e.value).trim();\n if(e.classList.contains('lt')){const a=(document.getElementById(id+'_f1')||{}).value||'',b=(document.getElementById(id+'_f2')||{}).value||'';if((a||b)&&!v.includes('.'))v=(v||'0')+'.'+(a||'0')+(b||'0')}return v};\nconst N=id=>r2(parseFloat(V(id))||0);\nconst opt=(a,blankTxt)=>(blankTxt!=null?[['',blankTxt]]:[]).concat(a.map(x=>[x.id,x.name]));\nconst tabs=(key,list)=>`<div class=\"tabs\">${list.map(([k,t])=>`<a class=\"${(st[key]||list[0][0])===k?'on':''}\" onclick=\"st['${key}']='${k}';render()\">${t}</a>`).join('')}</div>`;\nconst tab=(key,def)=>st[key]||def;\nfunction delBtn(fn,id){return can('del')?`<button class=\"btn sm r\" onclick=\"${fn}('${id}')\">حذف</button>`:''}\n\n/* ================= النافذة المنبثقة والطباعة ================= */\nlet MOK=null;\nlet MPRINT=false;\nfunction modal(title,body,ok,okTxt='حفظ',extra=''){MOK=ok;MDIRTY=false;MPRINT=false;$('#modal').innerHTML=`<div class=\"mbox\"><h3><span>${title}</span><button class=\"mx\" onclick=\"closeM()\" title=\"إغلاق\" aria-label=\"إغلاق\">✕</button></h3><div class=\"mbody\">${body}</div><div class=\"mfoot\">${ok?`<button class=\"btn g\" onclick=\"mOk()\">${okTxt}</button>`:''}${extra}<button class=\"btn s\" onclick=\"closeM()\">إغلاق</button></div></div>`;$('#modal').style.display='flex';fixDates($('#modal .mbody'));const f=$('#modal input,#modal select');if(f)f.focus()}\nlet MDIRTY=false;\nfunction closeM(force){if(MDIRTY&&force!==true&&!confirm('أكو تعديلات ما محفوظة. تغلق بدون حفظ؟'))return;MDIRTY=false;$('#modal').style.display='none';if(NET.needRender)setTimeout(softRender,50);$('#modal').innerHTML='';MOK=null}\nfunction mOk(){try{if(MOK&&MOK()!==false){closeM(true);render()}}catch(e){alert(e.message)}MPRINT=false}\nfunction need(c,msg){if(!c)throw new Error(msg)}\nconst PKINDS=[['moves','وصولات بيع وشراء المواد'],['pay','وصولات استلام المبالغ (دفع الديون)'],['shift','تقرير الشفت'],['shiftday','تقرير الشفتات اليومي'],['meter','فورمة قراءة العدادات'],['stmt','كشوف حساب العملاء والموردين'],['reports','التقارير والجداول'],['pump','تقرير المضخة']];\nfunction defPrint(){return{posW:80,orient:'portrait',a4m:10,fs:12,posFs:11,header:true,footer:'',copies:1,map:{pay:'pos',moves:'pos',shift:'pos',shiftday:'a4',meter:'a4',stmt:'a4',reports:'a4',pump:'a4'}}}\nfunction printHTML(title,html,raw,kind){const s=db.settings,P=s.print||defPrint(),fmtP=(P.map||{})[kind||'reports']||'a4',pos=fmtP==='pos';const W=+P.posW||80;\n const pageCss=pos?`@page{size:${W}mm auto;margin:2mm}body{width:${W-6}mm;margin:0 auto;font-size:${+P.posFs||11}px}h2{font-size:15px}h3{font-size:12.5px;margin:8px 0 4px}table{font-size:${(+P.posFs||11)-0.5}px}th,td{padding:2px 3px;border-color:#000}.hd{display:block!important;text-align:center}.hd>div{margin-bottom:3px}svg{max-width:100%!important}.pg{page-break-after:auto!important}.dsp table.mt td{display:block;width:auto!important}`\n  :`@page{size:A4 ${P.orient==='landscape'?'landscape':'portrait'};margin:${+P.a4m||10}mm}body{font-size:${+P.fs||12}px}`;\n const fr=document.createElement('iframe');fr.style.cssText='position:fixed;width:0;height:0;border:0';document.body.appendChild(fr);\n fr.contentDocument.write(`<html dir=\"rtl\"><head><meta charset=\"utf-8\"><title>${esc(title)}</title><style>body{font-family:Tahoma,Arial;font-size:12px;margin:${pos?'0':'0'};color:#000}h2{margin:0 0 4px;font-size:18px}h3{font-size:14px;margin:12px 0 6px}table{width:100%;border-collapse:collapse;margin-bottom:8px}th,td{border:1px solid #999;padding:4px 6px;text-align:right}th{background:#eee}.num{direction:ltr;text-align:right}.hd{display:flex;justify-content:space-between;border-bottom:2px solid #000;padding-bottom:6px;margin-bottom:10px}.ft{margin-top:12px;font-size:10px;text-align:center;color:#555}.ft2{margin-top:8px;text-align:center;font-weight:bold}.tag{font-weight:bold}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}${pageCss}</style></head><body>${raw||P.header===false?'':`<div class=\"hd\"><div><h2>${esc(s.name)}</h2>${esc(s.address)} ${esc(s.phone)}</div><div><b>${esc(title)}</b><br>${today()} ${t12(nowT())}</div></div>`}${html}${P.footer?`<div class=\"ft2\">${esc(P.footer)}</div>`:''}<div class=\"ft\">${COPY}</div></body></html>`);\n fr.contentDocument.close();fixDates(fr.contentDocument.body);window.__lastPrint={kind,fmt:fmtP,html:fr.contentDocument.documentElement.outerHTML};setTimeout(()=>{fr.contentWindow.focus();fr.contentWindow.print();setTimeout(()=>fr.remove(),1500)},250)}\nfunction printBox(id,title,kind){const e=document.getElementById(id);if(e)printHTML(title,e.innerHTML,false,kind||(id==='cst'||id==='sst'?'stmt':id==='shv'?'shift':id==='ddv'?'pump':'reports'))}\n\n/* ================= تسجيل الدخول ================= */\nfunction loginView(){$('#root').innerHTML=`<div class=\"login\"><div class=\"lbox\"><div class=\"lg bw\">BYTE<sup>®</sup></div><p>بايت لمحطات الوقود — ${esc(db.settings.name)}</p>\n${fi('اسم المستخدم','lu','')}${fi('كلمة المرور','lp','','password','onkeydown=\"if(event.key===\\'Enter\\')doLogin()\"')}\n<button class=\"btn\" style=\"width:100%;justify-content:center;padding:11px\" onclick=\"doLogin()\">دخول</button><div class=\"copy\">${COPY}</div></div></div>`;$('#lu').focus()}\nfunction doLogin(){const u=db.users.find(x=>x.user===V('lu')&&x.active!==false);if(!u||u.pass!==hp(V('lp'))){alert('اسم المستخدم أو كلمة المرور غير صحيحة');return}\n me=u;sessionStorage.setItem(SES,u.id);save('تسجيل دخول',u.user);page='home';render()}\nfunction logout(){if(!confirm('تسجيل الخروج؟'))return;save('تسجيل خروج',me.user);me=null;sessionStorage.removeItem(SES);render()}\n\n/* ================= التنبيهات ================= */\nfunction alerts(){const a=[],low=+db.settings.low||20;autoBkAlerts(a);\n db.tanks.forEach(t=>{const p=t.capacity?t.qty/t.capacity*100:0;if(p<low)a.push(`الخزان «${t.name}» منخفض: ${fmt(t.qty)} لتر (${Math.round(p)}%)`)});\n db.fuels.forEach(f=>{if(!(f.price>0))a.push(`لم يتم تحديد سعر بيع «${f.name}» — من إدارة الخزانات`)});\n if(me&&me.role==='admin'&&me.pass===hp('admin'))a.push('كلمة مرور المدير ما زالت الافتراضية (admin) — غيّرها من الإعدادات');\n db.shifts.filter(s=>s.status==='open'&&s.date<today()).forEach(s=>a.push(`الشفت رقم ${s.no} مفتوح منذ ${s.date}`));\n db.items.forEach(i=>{if(i.min>0&&i.qty<=i.min)a.push(`المادة «${i.name}» قاربت على النفاد: ${fmt(i.qty)} ${esc(i.unit||'')}`)});\n return a}\nfunction showAlerts(){const a=alerts();modal('التنبيهات',a.length?`<ul style=\"margin:0;padding-right:18px;line-height:2\">${a.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:'<div class=\"empty\">لا توجد تنبيهات</div>')}\n\n/* ================= الرسم العام ================= */\nfunction render(){const ls=licEval();if(!ls.ok&&!ls.trial){gateView();return}if(!me){if(ls.trial&&!LIC.skip){gateView();return}loginView();return}\n if(page==='suppliers'){page='purchases';st.pt='sup'}if(page==='backup'||page==='users'){st.stt=page==='users'?'usr':'bk';page='settings'}if(!can(page)&&!(page==='settings'&&(can('backup')||can('users')))&&!(page==='purchases'&&can('suppliers')))page='home';\n const nav=NAV.filter(n=>n[0]==='purchases'?(can('purchases')||can('suppliers')):n[0]==='settings'?(can('settings')||can('backup')||can('users')):can(n[0])).map(n=>`<a class=\"${page===n[0]?'on':''}\" onclick=\"go('${n[0]}')\">${gi(n[2],20)}<span>${n[1]}</span></a>`).join('');\n const al=alerts().length;let body='';\n try{body=(P[page]||P.home)()}catch(e){console.error(e);body=`<div class=\"warn\">خطأ في عرض الصفحة: ${esc(e.message)}</div>`}\n $('#root').innerHTML=`<div class=\"app\"><aside class=\"side\" id=\"side\"><div class=\"logo\"><b class=\"bw\">BYTE<sup>®</sup></b><span>للحلول البرمجية</span></div><nav class=\"nav\">${nav}<a class=\"out\" onclick=\"logout()\">${gi('power',20)}<span>تسجيل الخروج</span></a></nav><div class=\"foot\">${COPY}</div></aside>\n <div class=\"main\"><header class=\"hero\"><div class=\"img\"></div><button class=\"burger\" onclick=\"$('#side').classList.toggle('open')\">${ic('menu')}</button>\n <div class=\"ttl\"><h1>${ic('pump',38)} نظام إدارة محطة الوقود</h1><p>${esc(db.settings.name)} • إدارة المبيعات • المخزون • الحسابات • التقارير</p></div>\n <div class=\"topbar\">${(LIC.st||{}).trial&&me.role==='admin'?`<span class=\"trb\" onclick=\"st.stt='lic';go('settings')\">تجريبي: ${LIC.st.left} يوم</span>`:''}${NET.on?`<span id=\"netb\" class=\"netb\" onclick=\"st.stt='net';go('settings')\"><i></i><span></span></span>`:''}<span class=\"x\" title=\"تسجيل الخروج\" onclick=\"logout()\">${ic('power',20)}</span><span class=\"bell\" onclick=\"showAlerts()\">${ic('bell',22)}${al?`<i>${al}</i>`:''}</span><span class=\"usr\">${esc(me.name)} ${ic('user',22)}</span></div></header>\n <section class=\"content\">${body}</section></div></div>`;fixDates($('#root'));netBadge()}\nfunction go(p){page=p;const s=$('#side');if(s)s.classList.remove('open');render();window.scrollTo(0,0)}\nconst P={};\nconst head=(t,icon,btns='')=>`<div class=\"ptitle\"><h2>${gi(icon,24,'lg')} ${t}</h2><div class=\"row\">${btns}</div></div>`;\n\n/* ================= الرئيسية ================= */\nfunction salesOn(d){return db.sales.filter(s=>s.date===d)}\nfunction dayProfit(d){let p=0;salesOn(d).forEach(s=>p+=s.amount-s.liters*(s.cost||0));\n db.moves.forEach(m=>{if(m.type==='out'&&m.date===d)p+=m.amount-m.qty*(m.cost||0)});\n db.cash.forEach(c=>{if(c.date===d){if(c.kind==='rev'||c.kind==='over')p+=c.amount;if(c.kind==='exp'||c.kind==='short')p-=c.amount}});return r2(p)}\nP.home=()=>{const d=today(),m=month(d);\n const tankQ=db.tanks.reduce((a,t)=>a+(+t.qty||0),0);\n const buys=db.receipts.filter(r=>month(r.date)===m).reduce((a,r)=>a+r.total,0)+db.moves.filter(x=>x.type==='in'&&month(x.date)===m).reduce((a,x)=>a+x.amount,0);\n const sales=salesOn(d).reduce((a,s)=>a+s.amount,0)+db.moves.filter(x=>x.type==='out'&&x.date===d).reduce((a,x)=>a+x.amount,0);\n const kpi=(c,t,v,u,i,go2)=>`<div class=\"kpi ${c}\" ${go2?`onclick=\"${go2}\" title=\"اضغط للتفاصيل\"`:''}><div><div class=\"t\">${t}</div><div class=\"v\">${typeof v==='number'?fmt(v):v} <small>${u}</small></div></div><i class=\"kgi\">${ic(i,38)}</i></div>`;\n const cD=r2(db.customers.reduce((a,c)=>{const b=custBal(c);return a+(b>0?b:0)},0)),sD=r2(db.suppliers.reduce((a,x)=>{const b=supBal(x);return a+(b>0?b:0)},0));const toDebts=\"st.rt='debts';go('reports')\";\n let h=kpi('k1','أرصدة الوقود في الخزانات',tankQ,'لتر','pump',can('tanks')?\"st.tt='tanks';go('tanks')\":'')+kpi('k2','إجمالي المشتريات (هذا الشهر)',buys,cur(),'cart',can('reports')?\"st.rt='purch';st.prm='';go('reports')\":can('purchases')?\"st.pt='rc';go('purchases')\":'')+kpi('k3','إجمالي المبيعات اليوم',sales,cur(),'bag',can('reports')?\"st.rt='salesr';st.srf='';st.srt='';go('reports')\":can('sales')?\"go('sales')\":'')+kpi('k4','صافي الربح اليوم',dayProfit(d),cur(),'coins',can('reports')?\"st.rt='day';go('reports')\":'')\n  +kpi('k7','الشفتات المفتوحة',db.shifts.filter(x=>x.status==='open').length,'شفت','clock',can('shifts')?\"go('shifts')\":'')+kpi('k8','العدادات الشغالة',`${db.pumps.filter(x=>x.active&&pumpShift(x.id)).length} / ${db.pumps.filter(x=>x.active).length}`,'مستلم','pump',can('shifts')?\"go('shifts')\":'')+kpi('k5','ديون العملاء (لنا)',cD,cur(),'users',can('reports')?toDebts:'')+kpi('k6','ديون الموردين (علينا)',sD,cur(),'truck',can('reports')?toDebts:'');\n const free=!!db.settings.pumpLayout,ed=!!st.pumpEdit&&can('tanks');if(free)placePumps();\n const pumps=db.disps.map(d=>{const ms=dispMeters(d);const any=ms.some(m=>m.active);\n  const sides=ms.map(m=>{const f=fuelOf(m.fuelId),sh=pumpShift(m.id);return`<div class=\"sd ${m.active?'on':'off'}\"><span class=\"sl\">${SIDE[m.side]||''}</span><span class=\"pi\" style=\"color:${m.active?f.color:'#9ca3af'}\">${ic('pump',30)}</span><small>${esc(f.name)}</small><small class=\"w\">${sh?esc(nm(db.employees,sh.empId)):'&nbsp;'}</small><small class=\"tm\">${sh?'من '+t12(sh.openTime):'&nbsp;'}</small><small class=\"num mt\">${fmt(m.meter)}</small><button class=\"st\" ${can('tanks')&&!ed?`onclick=\"togglePump('${m.id}')\"`:''}>${m.active?'يعمل':'متوقف'}</button></div>`}).join('');\n  return`<div class=\"pump disp ${any?'on':'off'}\" id=\"pc_${d.id}\" style=\"border-top:4px solid ${laneC(d.lane)};${free?`left:min(${r2((d.px||0)*100)}%,calc(100% - ${PW*getPS()/100}px));top:${d.py||0}px`:''}\" onpointerdown=\"pumpDown(event,'${d.id}')\" oncontextmenu=\"return false\" title=\"${ed?'':'اضغط للتقرير التفصيلي'+(can('tanks')?' • اضغط مطولاً 5 ثواني لترتيب المضخات':'')}\"><span class=\"hb\"></span><div class=\"pin\"><b>${lnTag(d.lane,1)} ${esc(d.name)}</b><div class=\"sides\">${sides}</div></div></div>`}).join('')||`<div class=\"empty\">لا توجد مضخات — أضفها من «إدارة الخزانات والمضخات»</div>`;\n const tanks=db.tanks.map(t=>{const f=fuelOf(t.fuelId);const pc=t.capacity?Math.max(0,Math.min(100,Math.round(t.qty/t.capacity*100))):0;\n  const low=pc<(+db.settings.low||20);return`<div class=\"tank gt ${low?'low':''}\" style=\"--c:${f.color};--ct:${txtOn(f.color)}\" onclick=\"openTank('${t.id}')\" title=\"اضغط للتفاصيل\"><div class=\"th\"><span class=\"nz\">${NOZ}</span><b>${esc(t.name)}</b></div><div class=\"orb\"><div class=\"liq\" style=\"height:${pc}%\"><i class=\"wv\"></i><i class=\"wv w2\"></i></div><i class=\"gl\"></i><span>${pc}%</span></div><div class=\"q\"><span class=\"num\">${fmt(t.qty)}</span> لتر</div><div class=\"c\">السعة: <span class=\"num\">${fmt(t.capacity)}</span> لتر</div><div class=\"fn\">${esc(f.name)}</div></div>`}).join('')||`<div class=\"empty\">لا توجد خزانات</div>`;\n const days=[];for(let i=6;i>=0;i--){const x=new Date();x.setDate(x.getDate()-i);const k=today(x);days.push([DAYS[x.getDay()],salesOn(k).reduce((a,s)=>a+s.amount,0)])}\n const mx=Math.max(1,...days.map(x=>x[1]));\n const chart=`<div class=\"chart\">${days.map(x=>`<div class=\"bar\"><em>${x[1]?fmt(x[1]):''}</em><div style=\"height:${x[1]/mx*85}%\"></div></div>`).join('')}</div><div class=\"blabels\">${days.map(x=>`<span>${x[0]}</span>`).join('')}</div>`;\n const rec=db.sales.slice().sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time)).slice(0,8).map(s=>{const f=fuelOf(s.fuelId);return[`${ic('clock',15)} ${t12(s.time)}`,`<span class=\"dot\" style=\"background:${f.color}\"></span>${esc(f.name)}`,`<span class=\"num\">${fmt(s.liters)}</span>`,money(s.price),money(s.amount),esc(nm(db.pumps,s.pumpId)),s.pay==='credit'?`<span class=\"tag ty\">آجل</span>`:`<span class=\"tag tg\">نقد</span>`]});\n const demo=(db.settings.demoLoaded&&me.role==='admin'?`<div class=\"warn\">البرنامج يحتوي حالياً على <b>بيانات تجريبية</b> للعرض (موظفين، مواد، خزانات، مبيعات...). عند بدء العمل الفعلي امسحها من <a href=\"#\" onclick=\"st.stt='demo';go('settings');return false\">الإعدادات ← البيانات المؤقتة</a>.</div>`:'')+(!db.tanks.length&&!db.sales.length&&me.role==='admin'?`<div class=\"warn\">البرنامج فارغ. ابدأ بإضافة الخزانات والمضخات وأسعار الوقود من «إدارة الخزانات والمضخات»، أو <a href=\"#\" onclick=\"loadDemo();return false\">حمّل بيانات تجريبية</a> حتى تشوف شكل البرنامج.</div>`:'');\n return demo+`<div class=\"kpis\">${h}</div><div class=\"grid2\"><div class=\"box\"><h3>${gi('pump',19)} حالة مضخات الوقود${db.disps.length?`<button class=\"btn sm s\" style=\"margin-right:auto\" onclick=\"printMeterForm()\" title=\"طباعة فورمة العدادات لقارئ المقاييس\">${ic('print',16)} طباعة فورمة العدادات</button>`:''}</h3>${db.disps.length?`<div class=\"row\" style=\"margin:-4px 0 10px\">${psCtl()}</div>`:''}${ed?`<div class=\"pedit\">${ic('pump',18)} وضع ترتيب المضخات: اسحب كل مضخة لمكانها حسب ترتيب المحطة<span style=\"flex:1\"></span><button class=\"btn sm g\" onclick=\"exitPumpEdit()\">حفظ الترتيب</button><button class=\"btn sm s\" onclick=\"resetPumpLayout()\">ترتيب تلقائي</button></div>`:''}<div class=\"pumps disps ${free?'free':''} ${ed?'edit':''}\" id=\"pumpsBox\" ${free?`style=\"height:${pumpsH(ed)}px\"`:''}>${pumps}</div>${can('tanks')&&!ed&&db.disps.length?`<p class=\"phint\">اضغط مطولاً (5 ثواني) على أي مضخة حتى ترتّب مواقعها حسب المحطة.</p>`:''}</div><div class=\"box\"><h3>${gi('tank',19)} مستوى خزانات الوقود</h3><div class=\"tanks\">${tanks}</div></div></div>\n <div class=\"grid2\"><div class=\"box\"><h3>${gi('list',19)} آخر عمليات البيع</h3>${tbl(['الوقت','نوع الوقود','الكمية (لتر)','سعر اللتر','المبلغ','المضخة','الدفع'],rec)}</div><div class=\"box\"><h3>${gi('chart',19)} مبيعات آخر 7 أيام (${cur()})</h3>${chart}</div></div>`};\nfunction togglePump(id){const p=byId(db.pumps,id);p.active=!p.active;save('تغيير حالة مضخة',p.name+': '+(p.active?'يعمل':'متوقف'));render()}\n\n\nconst SIDE={R:'يمين',L:'يسار'};const LANEPAL=['#1565d8','#eab308','#dc2626','#7c3aed','#16a34a','#f97316','#0d9488','#db2777','#0891b2','#78350f'];\nconst txtOn=c=>{const h=String(c||'').replace('#','');if(h.length<6)return'#fff';const r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16);return(r*299+g*587+b*114)/1000>165?'#1f2937':'#fff'};\nconst laneC=k=>((db.settings.lanes||[]).find(l=>l.k===k)||{color:'#64748b'}).color;\nconst laneOfM=m=>{const d=m&&byId(db.disps,m.dispId);return d?d.lane:''};\nconst lnTag=(k,big)=>k?`<span class=\"ln${big?' big':''}\" style=\"background:${laneC(k)};color:${txtOn(laneC(k))}\">${esc(k)}</span>`:'';\nconst laneIdx=k=>{const i=(db.settings.lanes||[]).findIndex(l=>l.k===k);return i<0?99:i};\nconst mSort=(a,b)=>{const da=byId(db.disps,a.dispId)||{},dbb=byId(db.disps,b.dispId)||{};return laneIdx(da.lane)-laneIdx(dbb.lane)||db.disps.indexOf(da)-db.disps.indexOf(dbb)||(a.side==='R'?0:1)-(b.side==='R'?0:1)};\nconst mLabel=m=>`${lnTag(laneOfM(m))} ${esc(m.name)}`;const PSK='byte_fuel_psize';\nfunction getPS(){let z=100;try{z=parseInt(localStorage.getItem(PSK))||100}catch(e){}return Math.min(150,Math.max(50,z))}\nfunction applyPS(z){z=Math.min(150,Math.max(50,Math.round(z/5)*5));document.documentElement.style.setProperty('--ps',z/100);return z}\nfunction setPS(z,re){z=applyPS(z);try{localStorage.setItem(PSK,z)}catch(e){}document.querySelectorAll('.psl').forEach(e=>e.textContent=z+'%');document.querySelectorAll('.psr').forEach(e=>{if(+e.value!==z)e.value=z});if(re)render()}\nconst psCtl=()=>`<span class=\"psz\" onpointerdown=\"event.stopPropagation()\">حجم المضخات <button class=\"btn sm s\" onclick=\"setPS(getPS()-10,1)\">−</button><input class=\"psr\" type=\"range\" min=\"50\" max=\"150\" step=\"5\" value=\"${getPS()}\" oninput=\"setPS(+this.value)\" onchange=\"setPS(+this.value,1)\"><button class=\"btn sm s\" onclick=\"setPS(getPS()+10,1)\">+</button><b class=\"psl num\">${getPS()}%</b></span>`;\nconst dispMeters=d=>db.pumps.filter(p=>p.dispId===d.id).sort((a,b)=>(a.side==='R'?0:1)-(b.side==='R'?0:1));\n/* ترتيب مواقع المضخات بالسحب (ضغط مطوّل 5 ثواني) */\nlet HOLD=null,DRG=null;const PH=200,PW=230;\nfunction placePumps(){const un=db.disps.filter(p=>p.px==null||p.py==null);if(!un.length)return;const K=getPS()/100;let y=db.disps.filter(p=>p.py!=null).reduce((a,p)=>Math.max(a,p.py+PH*K+20),0);un.forEach((p,k)=>{p.px=(k%3)*0.34;p.py=y+Math.floor(k/3)*(PH*K+20)})}\nfunction pumpsH(ed){const k=getPS()/100;return db.disps.reduce((a,p)=>Math.max(a,(p.py||0)+PH*k+20),170)+(ed?180:0)}\nfunction cancelHold(){if(HOLD){clearTimeout(HOLD.t);HOLD.el.classList.remove('holding');HOLD=null}}\nfunction pumpDown(e,id){if((e.button||0)>0)return;const el=e.currentTarget;\n if(st.pumpEdit){if(!can('tanks'))return;e.preventDefault();const box=$('#pumpsBox'),r=el.getBoundingClientRect();try{el.setPointerCapture(e.pointerId)}catch(x){}DRG={el,id,box,dx:e.clientX-r.left,dy:e.clientY-r.top,moved:false};el.classList.add('drag');return}\n cancelHold();const cn=can('tanks');if(cn)el.classList.add('holding');HOLD={el,id,t0:Date.now(),btn:!!(e.target.closest&&e.target.closest('.st')),x0:e.clientX,y0:e.clientY,t:cn?setTimeout(()=>{if(!HOLD)return;HOLD.el.classList.remove('holding');HOLD=null;enterPumpEdit()},5000):null}}\nfunction enterPumpEdit(){const box=$('#pumpsBox');if(box&&!db.settings.pumpLayout){const W=box.clientWidth||1;db.disps.forEach(p=>{const el=document.getElementById('pc_'+p.id);if(el){p.px=r2(el.offsetLeft/W*10000)/10000;p.py=el.offsetTop}});db.settings.pumpLayout=true}\n st.pumpEdit=true;try{navigator.vibrate&&navigator.vibrate(80)}catch(x){}render()}\nfunction exitPumpEdit(){st.pumpEdit=false;save('ترتيب مواقع المضخات','');render()}\nfunction resetPumpLayout(){if(!confirm('إرجاع المضخات للترتيب التلقائي؟'))return;db.disps.forEach(p=>{delete p.px;delete p.py});db.settings.pumpLayout=false;st.pumpEdit=false;save('إرجاع ترتيب المضخات التلقائي','');render()}\ndocument.addEventListener('pointermove',e=>{if(HOLD&&Math.hypot(e.clientX-HOLD.x0,e.clientY-HOLD.y0)>12)cancelHold();\n if(!DRG)return;e.preventDefault();const{el,box}=DRG,R=box.getBoundingClientRect(),sc=R.width/(box.clientWidth||1),er=el.getBoundingClientRect();\n let x=e.clientX-R.left-DRG.dx,y=e.clientY-R.top-DRG.dy;x=Math.max(0,Math.min(R.width-er.width,x));y=Math.max(0,y);\n const xs=Math.round(x/sc/10)*10,ys=Math.round(y/sc/10)*10;DRG.px=Math.min(xs,box.clientWidth-el.offsetWidth)/(box.clientWidth||1);DRG.py=ys;DRG.moved=true;\n el.style.left=(DRG.px*100)+'%';el.style.top=ys+'px';const need=ys+PH+200;if(need>box.offsetHeight)box.style.height=need+'px'},{passive:false});\nfunction endPtr(e){if(HOLD){const h=HOLD;cancelHold();if(e&&e.type==='pointerup'&&!h.btn&&!st.pumpEdit&&Date.now()-h.t0<700)setTimeout(()=>openDisp(h.id),0)}if(!DRG)return;const{el,id,moved}=DRG;el.classList.remove('drag');if(moved){const p=byId(db.disps,id);if(p){p.px=DRG.px;p.py=DRG.py;persist()}}DRG=null;const b=$('#pumpsBox');if(b)b.style.height=pumpsH(true)+'px'}\ndocument.addEventListener('pointerup',endPtr);document.addEventListener('pointercancel',endPtr);\n/* ================= مبيعات الوقود ================= */\nfunction mkSale(o){const p=byId(db.pumps,o.pumpId);need(p,'اختر المضخة');const f=fuelOf(p.fuelId),t=byId(db.tanks,p.tankId);\n const sh=o.shiftId!==undefined?o.shiftId:(pumpShift(p.id)||{}).id||'';\n const s={id:uid(),date:o.date||today(),time:o.time||nowT(),pumpId:p.id,fuelId:p.fuelId,tankId:p.tankId||'',liters:r2(o.liters),price:r2(o.price!=null?o.price:f.price),cost:r2(f.cost||0),pay:o.pay||'cash',customerId:o.customerId||'',shiftId:sh,auto:!!o.auto,note:o.note||'',by:me?me.name:'النظام'};if(DEMO)s.demo=true;\n s.amount=r2(o.amount!=null?o.amount:s.liters*s.price);\n if(t)t.qty=r2(t.qty-s.liters);db.sales.push(s);\n if(s.pay==='cash')addCash({type:'in',kind:'sale',amount:s.amount,ref:s.id,date:s.date,time:s.time,note:`${f.name} ${fmt(s.liters)} لتر — ${nm(db.pumps,p.id)}`});\n return s}\nfunction saleCalc(src){const p=byId(db.pumps,V('sp'));const pr=p?fuelOf(p.fuelId).price:0;$('#spr').value=pr?fmt(pr):'';\n if(!pr)return;if(src==='l')setNF('sa',V('sl')?r2(N('sl')*pr):'');else if(src==='a')setNF('sl',V('sa')?r2(N('sa')/pr):'')}\nfunction doSale(){try{const p=byId(db.pumps,V('sp'));need(p,'اختر المضخة');need(p.active,'المضخة متوقفة');const f=fuelOf(p.fuelId);need(f.price>0,'حدد سعر الوقود أولاً');\n const l=N('sl');need(l>0,'أدخل الكمية أو المبلغ');const pay=V('spay');const c=V('sc');if(pay==='credit')need(c,'اختر العميل للبيع الآجل');\n const s=mkSale({pumpId:p.id,liters:l,amount:N('sa')||undefined,pay,customerId:pay==='credit'?c:''});\n st.lastPump=p.id;save('بيع وقود',`${f.name} ${fmt(l)} لتر بمبلغ ${fmt(s.amount)} (${pay==='credit'?'آجل: '+nm(db.customers,c):'نقد'})`);render();setTimeout(()=>{const e=$('#sl');if(e)e.focus()},30)}catch(e){alert(e.message)}}\nfunction delSale(id){const s=byId(db.sales,id);if(!s||!confirm('حذف عملية البيع وإرجاع الكمية للخزان؟'))return;const t=byId(db.tanks,s.tankId);if(t)t.qty=r2(t.qty+s.liters);\n db.cash=db.cash.filter(c=>c.ref!==id);db.sales=db.sales.filter(x=>x.id!==id);save('حذف بيع وقود',`${fuelOf(s.fuelId).name} ${fmt(s.liters)} لتر ${fmt(s.amount)}`);render()}\nP.sales=()=>{const d=st.sd||today();const ap=db.pumps.filter(p=>p.active);\n const form=`<div class=\"box\"><h3>${gi('plus',19)} تسجيل عملية بيع</h3><div class=\"row\">\n ${fs('المضخة','sp',ap.map(p=>[p.id,p.name+' — '+fuelOf(p.fuelId).name]),st.lastPump||'','onchange=\"saleCalc(\\'l\\')\"')}\n <div class=\"f\"><label>سعر اللتر</label><input id=\"spr\" disabled></div>\n ${fl('الكمية (لتر)','sl','','oninput=\"saleCalc(\\'l\\')\" onkeydown=\"if(event.key===\\'Enter\\')doSale()\"')}\n ${fi('المبلغ','sa','','number','oninput=\"saleCalc(\\'a\\')\" onkeydown=\"if(event.key===\\'Enter\\')doSale()\"')}\n ${fs('الدفع','spay',[['cash','نقد'],['credit','آجل (دين)']],'','onchange=\"$(\\'#scw\\').style.display=this.value===\\'credit\\'?\\'\\':\\'none\\'\"')}\n <div id=\"scw\" style=\"display:none;flex:1;min-width:150px\">${fs('العميل','sc',opt(db.customers.filter(c=>!c.deleted),'— اختر —'))}</div>\n <button class=\"btn g\" onclick=\"doSale()\">${ic('plus',18)} تسجيل البيع</button></div>\n <p style=\"color:var(--mut);font-size:12.5px;margin:8px 0 0\">تسجيل كل عملية اختياري: إذا الشفت مفتوح، عند إغلاقه يحسب البرنامج فرق العداد غير المسجل كبيع نقدي تلقائياً.</p></div>`;\n const list=db.sales.filter(s=>s.date===d).reverse();const tl=list.reduce((a,s)=>a+s.liters,0),ta=list.reduce((a,s)=>a+s.amount,0),tc=list.filter(s=>s.pay==='credit').reduce((a,s)=>a+s.amount,0);\n const rows=list.map(s=>[t12(s.time),`<span class=\"dot\" style=\"background:${fuelOf(s.fuelId).color}\"></span>${esc(fuelOf(s.fuelId).name)}`,esc(nm(db.pumps,s.pumpId)),`<span class=\"num\">${fmt(s.liters)}</span>`,money(s.price),money(s.amount),s.pay==='credit'?`<span class=\"tag ty\">آجل: ${esc(nm(db.customers,s.customerId))}</span>`:`<span class=\"tag tg\">نقد</span>`,s.auto?'<span class=\"tag tb\">فرق عداد</span>':'',s.shiftId?esc((byId(db.shifts,s.shiftId)||{}).no||''):'',esc(s.by),delBtn('delSale',s.id)]);\n setTimeout(()=>{if($('#sp'))saleCalc('l')},0);\n return head('مبيعات الوقود','pump')+(ap.length?form:`<div class=\"warn\">لا توجد مضخات عاملة. أضف المضخات من «إدارة الخزانات والمضخات».</div>`)+\n `<div class=\"box\"><div class=\"row\" style=\"justify-content:space-between;margin-bottom:10px\"><div style=\"max-width:200px\">${fi('التاريخ','sdd',d,'date','onchange=\"st.sd=this.value;render()\"')}</div><button class=\"btn s\" onclick=\"printBox('salesT','مبيعات الوقود ${d}')\">${ic('print',18)} طباعة</button></div>\n <div id=\"salesT\"><div class=\"sum\"><div><span>عدد العمليات</span><b>${list.length}</b></div><div><span>اللترات</span><b>${fmt(tl)}</b></div><div><span>المبلغ الكلي</span><b>${fmt(ta)}</b></div><div><span>منها آجل</span><b>${fmt(tc)}</b></div></div>\n ${tbl(['الوقت','الوقود','المضخة','لتر','السعر','المبلغ','الدفع','','الشفت','بواسطة',''],rows)}</div></div>`};\n\n/* ================= الشفتات والعدادات ================= */\nP.shifts=()=>{const open=db.shifts.filter(s=>s.status==='open');const d=st.shd||today(),hf=st.shf||'00:00',ht=st.sht||'23:59';\n const oc=open.map(s=>{const recL=s.readings.map(r=>db.sales.filter(x=>x.shiftId===s.id&&x.pumpId===r.pumpId).reduce((a,x)=>a+x.liters,0));\n  return`<div class=\"box\"><div class=\"row\" style=\"justify-content:space-between\"><h3 style=\"margin:0\">${gi('clock',19)} شفت رقم ${s.no} — ${esc(nm(db.employees,s.empId))}</h3><div class=\"row\"><button class=\"btn o\" onclick=\"closeShift('${s.id}')\">إغلاق الشفت وقراءة العدادات</button><button class=\"btn\" onclick=\"editOpenShift('${s.id}')\">تعديل الفتح</button><button class=\"btn s\" onclick=\"printMeterForm('${s.id}')\">${ic('print',16)} فورمة العدادات</button>${can('del')?`<button class=\"btn r\" onclick=\"delShiftAll('${s.id}')\">مسح الشفت</button>`:''}</div></div>\n  <p style=\"color:var(--mut);margin:6px 0 10px\">فُتح ${s.date} الساعة ${t12(s.openTime)} بواسطة ${esc(s.openBy)}</p>\n  ${tbl(['المضخة','الوقود','عداد البداية','السعر','مبيعات مسجلة (لتر)'],s.readings.map((r,i)=>[mLabel(byId(db.pumps,r.pumpId)||{name:'-'}),esc(fuelOf(r.fuelId).name),`<span class=\"num\">${fmt(r.start)}</span>`,money(r.price),`<span class=\"num\">${fmt(recL[i])}</span>`]))}</div>`}).join('');\n const ct=s=>(s.closeDate&&s.closeDate>s.date)?'24:00':(s.closeTime||'23:59');\n const closed=db.shifts.filter(s=>s.status==='closed'&&s.date===d&&s.openTime<=ht&&ct(s)>=hf).sort((a,b)=>(a.openTime||'').localeCompare(b.openTime||''));\n const rows=closed.map(s=>[s.no,esc(nm(db.employees,s.empId)),t12(s.openTime),t12(s.closeTime)+(s.closeDate&&s.closeDate>s.date?' <span class=\"tag ty\">'+s.closeDate+'</span>':''),`<span class=\"num\">${fmt(shiftHrs(s))}</span>`,`<span class=\"num\">${fmt(s.liters)}</span>`,money(s.total),money(s.credit),money(s.expected),money(s.received),`<span class=\"num ${s.diff<0?'neg':s.diff>0?'pos':''}\">${fmt(s.diff)}</span>`,`<button class=\"btn sm s\" onclick=\"viewShift('${s.id}')\">عرض</button> <button class=\"btn sm\" onclick=\"editClosedShift('${s.id}')\">تعديل</button> <button class=\"btn sm o\" onclick=\"reopenShift('${s.id}')\">إعادة فتح</button>${can('del')?` <button class=\"btn sm r\" onclick=\"delShiftAll('${s.id}')\">مسح</button>`:''}`]);\n return head('الشفتات والعدادات','clock',`<button class=\"btn g\" onclick=\"openShift()\">${ic('plus',18)} فتح شفت جديد</button>`)+(oc||'')+\n`<div class=\"box\"><div class=\"row\" style=\"justify-content:space-between;margin-bottom:10px;align-items:flex-end\"><h3 style=\"margin:0\">${gi('chart',19)} تقرير الشفتات اليومي</h3><div class=\"row\">${fi('اليوم','shdd',d,'date','onchange=\"st.shd=this.value;render()\"')}${fi('من الساعة','shff',hf,'time','onchange=\"st.shf=this.value;render()\"')}${fi('إلى الساعة','shtt',ht,'time','onchange=\"st.sht=this.value;render()\"')}<button class=\"btn s\" onclick=\"st.shd='';st.shf='';st.sht='';render()\">اليوم كامل</button><button class=\"btn s\" onclick=\"printShiftDay()\">${ic('print',18)} طباعة</button></div></div>\n <div id=\"shDay\">${shiftDayHTML(closed,rows,d,hf,ht)}</div></div>`};\nconst shiftHrs=s=>{if(!s.openTime||!s.closeTime)return 0;const a=new Date(s.date+'T'+s.openTime),b=new Date((s.closeDate&&s.closeDate>=s.date?s.closeDate:s.date)+'T'+s.closeTime);let h=(b-a)/3600000;if(h<0)h+=24;return r2(h)};\nfunction shiftDayHTML(closed,rows,d,hf,ht,print){const T=closed.reduce((a,s)=>({l:a.l+(s.liters||0),t:a.t+(s.total||0),c:a.c+(s.credit||0),e:a.e+(s.expected||0),r:a.r+(s.received||0),df:a.df+(s.diff||0),h:a.h+shiftHrs(s)}),{l:0,t:0,c:0,e:0,r:0,df:0,h:0});\n const ids=new Set(closed.map(s=>s.id));const hs={};db.sales.filter(x=>x.shiftId&&ids.has(x.shiftId)).forEach(x=>{const h=(x.time||'00:00').slice(0,2);if(x.time&&(x.time<hf||x.time>ht))return;hs[h]=hs[h]||{n:0,l:0,a:0,sh:new Set()};hs[h].n++;hs[h].l+=x.liters;hs[h].a+=x.amount;hs[h].sh.add((byId(db.shifts,x.shiftId)||{}).no)});\n const hr=Object.keys(hs).sort().map(h=>{const v=hs[h];return[`${t12(h+':00')} — ${t12(String((+h+1)%24).padStart(2,'0')+':00')}`,v.n,`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a),[...v.sh].join('، ')]});\n const r=print?rows.map(x=>x.slice(0,-1)):rows;const h=['رقم','العامل','الفتح','الإغلاق','الساعات','اللترات','المبيعات','آجل','النقد المتوقع','المستلم','الفرق'].concat(print?[]:['']);\n return`<p style=\"margin:0 0 8px;color:var(--mut)\">${d} (${DAYS[new Date(d+'T12:00').getDay()]}) — من ${t12(hf)} إلى ${t12(ht)}</p>\n <div class=\"sum\"><div><span>عدد الشفتات</span><b>${closed.length}</b></div><div><span>ساعات العمل</span><b>${fmt(T.h)}</b></div><div><span>اللترات</span><b>${fmt(T.l)}</b></div><div><span>المبيعات</span><b>${fmt(T.t)}</b></div><div><span>النقد المتوقع</span><b>${fmt(T.e)}</b></div><div><span>المستلم</span><b>${fmt(T.r)}</b></div><div><span>الفرق</span><b class=\"${T.df<0?'neg':T.df>0?'pos':''}\">${fmt(T.df)}</b></div></div>\n ${tbl(h,r,closed.length?['المجموع','','','',`<span class=\"num\">${fmt(T.h)}</span>`,`<span class=\"num\">${fmt(T.l)}</span>`,money(T.t),money(T.c),money(T.e),money(T.r),`<span class=\"num\">${fmt(T.df)}</span>`].concat(print?[]:['']):null)}\n <h3 style=\"margin-top:14px\">${print?'':gi('clock',19)} المبيعات حسب الساعات</h3>${tbl(['الساعة','عدد العمليات','اللترات','المبلغ','الشفت'],hr)}\n <p style=\"color:var(--mut);font-size:12px\">فرق العداد غير المسجل يُحسب بساعة إغلاق الشفت.</p>`}\nfunction printShiftDay(){const d=st.shd||today(),hf=st.shf||'00:00',ht=st.sht||'23:59';const ct=s=>(s.closeDate&&s.closeDate>s.date)?'24:00':(s.closeTime||'23:59');\n const closed=db.shifts.filter(s=>s.status==='closed'&&s.date===d&&s.openTime<=ht&&ct(s)>=hf).sort((a,b)=>(a.openTime||'').localeCompare(b.openTime||''));\n const rows=closed.map(s=>[s.no,esc(nm(db.employees,s.empId)),t12(s.openTime),t12(s.closeTime),`<span class=\"num\">${fmt(shiftHrs(s))}</span>`,`<span class=\"num\">${fmt(s.liters)}</span>`,money(s.total),money(s.credit),money(s.expected),money(s.received),`<span class=\"num\">${fmt(s.diff)}</span>`,'']);\n printHTML('تقرير الشفتات اليومي '+d,shiftDayHTML(closed,rows,d,hf,ht,true),false,'shiftday')}\nfunction lnAll(c,k,v){document.querySelectorAll('.'+c).forEach(x=>{if(x.dataset.ln===k)x.checked=v})}\nfunction laneGroups(list,cls,chk){list=list.slice().sort(mSort);const g={};list.forEach(p=>{const k=laneOfM(p)||'-';(g[k]=g[k]||[]).push(p)});\n return Object.keys(g).sort((a,b)=>laneIdx(a)-laneIdx(b)).map(k=>`<div class=\"lnh\" style=\"background:${laneC(k)};color:${txtOn(laneC(k))}\">المجموعة ${esc(k)} <span style=\"font-weight:600;opacity:.9\">(${g[k].length} عداد)</span><label><input type=\"checkbox\" ${chk?'checked':''} onchange=\"lnAll('${cls}','${esc(k)}',this.checked)\"> تحديد الكل</label></div>\n <div class=\"chk\">${g[k].map(p=>`<label class=\"lnl\" style=\"--lc:${laneC(k)}\"><input type=\"checkbox\" class=\"${cls}\" data-ln=\"${esc(k)}\" value=\"${p.id}\" ${chk?'checked':''}> ${lnTag(k)} ${esc(p.name)} — <span style=\"color:${fuelOf(p.fuelId).color};font-weight:700\">${esc(fuelOf(p.fuelId).name)}</span> <span class=\"num\" style=\"margin-right:auto\">${fmt(p.meter)}</span></label>`).join('')}</div>`).join('')}\nfunction openShift(){const busy=new Set(db.shifts.filter(s=>s.status==='open').flatMap(s=>s.readings.map(r=>r.pumpId)));const free=db.pumps.filter(p=>p.active&&!busy.has(p.id));\n if(!db.employees.filter(e=>e.active!==false).length){alert('أضف العمال أولاً من «الموظفون والرواتب»');return}if(!free.length){alert('لا توجد مضخات عاملة متاحة (كلها متوقفة أو داخل شفت مفتوح)');return}\n modal('فتح شفت جديد',`<div class=\"row\">${fs('العامل','oe',opt(db.employees.filter(e=>e.active!==false)))}${fi('التاريخ','od',today(),'date')}</div><h4>المضخات وعدادات البداية</h4>${laneGroups(free,'op',true)}\n <p style=\"color:var(--mut);font-size:12.5px\">عداد البداية يؤخذ من آخر قراءة مسجلة للمضخة. لتعديله: إدارة الخزانات ← المضخات.</p>`,()=>{\n  const ids=[...document.querySelectorAll('.op:checked')].map(x=>x.value).sort((a,b)=>mSort(byId(db.pumps,a),byId(db.pumps,b)));need(ids.length,'اختر مضخة واحدة على الأقل');\n  const bad=ids.map(i=>byId(db.pumps,i)).filter(p=>!(fuelOf(p.fuelId).price>0));need(!bad.length,'حدد سعر الوقود للمضخة: '+(bad[0]||{}).name);\n  const s={id:uid(),no:db.settings.shiftNo++,date:V('od')||today(),openTime:nowT(),openBy:me.name,empId:V('oe'),status:'open',readings:ids.map(i=>{const p=byId(db.pumps,i);return{pumpId:p.id,fuelId:p.fuelId,tankId:p.tankId,price:fuelOf(p.fuelId).price,start:+p.meter||0,end:null}})};\n  db.shifts.push(s);save('فتح شفت',`رقم ${s.no} — ${nm(db.employees,s.empId)}`)},'فتح الشفت')}\nfunction closeCalc(id){const s=byId(db.shifts,id);let tot=0,cashExp=0,html='';\n s.readings.forEach((r,i)=>{const end=parseFloat(V('ce'+i));const ml=isNaN(end)?0:Math.max(0,end-r.start);const sl=db.sales.filter(x=>x.shiftId===id&&x.pumpId===r.pumpId&&!x.auto);const rec=sl.reduce((a,x)=>a+x.liters,0);const rem=r2(ml-rec);\n  const v=document.getElementById('cr'+i);if(v)v.innerHTML=`صرف العداد ${fmt(ml)} لتر • مسجل ${fmt(rec)} • ${rem>=0?'يُحسب بيع نقدي '+fmt(rem)+' لتر = '+fmt(rem*(typeof pr!=\"undefined\"?pr:r.price)):'<span class=\"neg\">المسجل أكثر من العداد بـ '+fmt(-rem)+'</span>'}`;\n  tot+=sl.reduce((a,x)=>a+x.amount,0)+Math.max(0,rem)*r.price;cashExp+=sl.filter(x=>x.pay==='cash').reduce((a,x)=>a+x.amount,0)+Math.max(0,rem)*r.price});\n const rc=N('crc'),diff=r2(rc-cashExp),emp=V('crc')==='';$('#csum').innerHTML=`<div class=\"sum\"><div><span>إجمالي مبيعات الشفت</span><b>${fmt(tot)}</b></div><div><span>النقد المتوقع (المفروض يسلّمه العامل)</span><b>${fmt(cashExp)}</b></div><div><span>${emp?'العجز / الزيادة':diff<0?'عجز على العامل':diff>0?'زيادة':'مطابق ✓'}</span><b class=\"${emp?'':diff<0?'neg':diff>0?'pos':'pos'}\">${emp?'<span style=\"font-size:13px;color:var(--mut)\">أدخل النقد المستلم</span>':fmt(diff)}</b></div></div>${emp?`<div class=\"warn\" style=\"margin:8px 0 0\">العجز يُحسب بعد ما تكتب المبلغ اللي سلّمه العامل فعلاً. <button class=\"btn sm g\" onclick=\"setNF('crc','${cashExp}');$('#crc').dispatchEvent(new Event('input'))\">العامل سلّم المبلغ كامل (${fmt(cashExp)})</button></div>`:''}`}\n/* --- مساعدات تعديل ومسح الشفتات --- */\nconst laterShift=(s,pid)=>db.shifts.some(x=>x.id!==s.id&&x.no>s.no&&x.readings.some(r=>r.pumpId===pid));\nfunction rmSale(id){const s=byId(db.sales,id);if(!s)return;const t=byId(db.tanks,s.tankId);if(t)t.qty=r2(t.qty+s.liters);db.cash=db.cash.filter(c=>c.ref!==id);db.sales=db.sales.filter(x=>x.id!==id)}\nfunction checkUndo(s){need(!db.advances.some(a=>a.shiftId===s.id&&a.payrollId),'عجز هذا الشفت مسجل كسلفة واستُقطع من راتب — ما ينفع التعديل')}\nfunction undoClose(s){checkUndo(s);\n db.sales.filter(x=>x.shiftId===s.id&&x.auto).map(x=>x.id).forEach(rmSale);\n db.cash=db.cash.filter(c=>c.ref!==s.id);db.advances=db.advances.filter(a=>a.shiftId!==s.id);\n s.readings.forEach(r=>{const p=byId(db.pumps,r.pumpId);if(p&&!laterShift(s,r.pumpId))p.meter=r.start;r.end=null});\n s.status='open';['liters','total','credit','expected','received','diff','closeTime','closeDate','closeBy'].forEach(k=>delete s[k])}\nfunction applyClose(s,ends,rcv,adv){let liters=0;\n s.readings.forEach((r,i)=>{r.end=ends[i];const ml=r2(r.end-r.start);liters+=ml;const rec=db.sales.filter(x=>x.shiftId===s.id&&x.pumpId===r.pumpId).reduce((a,x)=>a+x.liters,0);const rem=r2(ml-rec);\n  const p=byId(db.pumps,r.pumpId);\n  if(rem>0.001&&p){const keep=[p.fuelId,p.tankId];p.fuelId=r.fuelId;if(r.tankId)p.tankId=r.tankId;mkSale({pumpId:r.pumpId,liters:rem,price:r.price,pay:'cash',shiftId:s.id,auto:true,date:s.date,time:s.closeTime||nowT(),note:'فرق عداد شفت '+s.no});p.fuelId=keep[0];p.tankId=keep[1]}\n  if(p&&!laterShift(s,r.pumpId))p.meter=r.end});\n const sl=db.sales.filter(x=>x.shiftId===s.id);s.liters=r2(liters);s.total=r2(sl.reduce((a,x)=>a+x.amount,0));s.credit=r2(sl.filter(x=>x.pay==='credit').reduce((a,x)=>a+x.amount,0));\n s.expected=r2(s.total-s.credit);s.received=rcv;s.diff=r2(rcv-s.expected);s.status='closed';s.closeTime=s.closeTime||nowT();s.closeDate=s.closeDate||today();s.closeBy=me.name;\n if(s.diff<0){addCash({type:'out',kind:'short',amount:-s.diff,ref:s.id,date:s.date,note:'عجز شفت '+s.no+' — '+nm(db.employees,s.empId)});\n  if(adv)db.advances.push({id:uid(),empId:s.empId,date:s.date,amount:-s.diff,note:'عجز شفت رقم '+s.no,shiftId:s.id})}\n if(s.diff>0)addCash({type:'in',kind:'over',amount:s.diff,ref:s.id,date:s.date,note:'زيادة شفت '+s.no})}\nfunction readEnds(s,lock){return s.readings.map((r,i)=>{if(lock&&lock[i])return r.end;const e=parseFloat(V('ce'+i));need(!isNaN(e),'أدخل عداد النهاية لكل المضخات');need(e>=(lock?(parseFloat(V('cs'+i))||0):r.start),'عداد النهاية أقل من البداية: '+nm(db.pumps,r.pumpId));return e})}\nfunction closeShift(id){const s=byId(db.shifts,id);\n modal(`إغلاق الشفت رقم ${s.no} — ${esc(nm(db.employees,s.empId))}`,s.readings.map((r,i)=>`<div class=\"row\" style=\"margin-bottom:8px\"><div class=\"f\"><label>${mLabel(byId(db.pumps,r.pumpId)||{name:'-'})} — ${esc(fuelOf(r.fuelId).name)} (بداية ${fmt(r.start)})</label>${ltIn('ce'+i,'',`oninput=\"closeCalc('${id}')\"`,'عداد النهاية')}</div><div class=\"f\" style=\"flex:2\"><label>&nbsp;</label><div id=\"cr${i}\" style=\"padding:8px 0;color:var(--mut)\"></div></div></div>`).join('')+\n `<div class=\"row\">${fi('النقد المستلم من العامل','crc','','number',`oninput=\"closeCalc('${id}')\"`)}</div><div id=\"csum\" style=\"margin-top:10px\"></div>\n <label style=\"display:flex;gap:6px;align-items:center\"><input type=\"checkbox\" id=\"cadv\" checked> إذا أكو عجز، يُسجل كسلفة على العامل</label>`,()=>{\n  const ends=readEnds(s);if(V('crc')===''&&!confirm('ما كتبت النقد المستلم من العامل.\\nإذا تكمل يعني العامل ما سلّم شي، وراح ينسجل عجز بكامل المبلغ.\\nمتابعة؟'))return false;const rcv=N('crc');applyClose(s,ends,rcv,$('#cadv').checked);\n  save('إغلاق شفت',`رقم ${s.no}: مبيعات ${fmt(s.total)}، مستلم ${fmt(rcv)}، فرق ${fmt(s.diff)}`);setTimeout(()=>viewShift(id),50)},'إغلاق الشفت');setTimeout(()=>closeCalc(id),0)}\n/* تعديل بيانات الفتح (شفت مفتوح) */\nfunction editOpenShift(id){const s=byId(db.shifts,id);\n const busy=new Set(db.shifts.filter(x=>x.status==='open'&&x.id!==id).flatMap(x=>x.readings.map(r=>r.pumpId)));const mine=new Set(s.readings.map(r=>r.pumpId));\n const free=db.pumps.filter(p=>p.active&&!busy.has(p.id)&&!mine.has(p.id));\n modal(`تعديل فتح الشفت رقم ${s.no}`,`<div class=\"row\">${fs('العامل','xe',opt(db.employees.filter(e=>e.active!==false||e.id===s.empId)),s.empId)}${fi('التاريخ','xd',s.date,'date')}${fi('وقت الفتح','xt',s.openTime,'time')}</div>\n <h4>المضخات وعدادات البداية</h4>${s.readings.map((r,i)=>{const has=db.sales.some(x=>x.shiftId===id&&x.pumpId===r.pumpId);return`<div class=\"row\" style=\"margin-bottom:8px\"><div class=\"f\" style=\"flex:2\"><label>المضخة</label><div style=\"padding:8px 0\">${mLabel(byId(db.pumps,r.pumpId)||{name:'-'})} — ${esc(fuelOf(r.fuelId).name)}</div></div>${fl('عداد البداية','xs'+i,r.start)}${fi('سعر اللتر','xp'+i,r.price,'number')}<label style=\"display:flex;gap:6px;align-items:center;min-width:120px;${has?'color:#9ca3af':''}\"><input type=\"checkbox\" id=\"xr${i}\" ${has?'disabled title=\"عليها مبيعات مسجلة\"':''}> إزالة من الشفت</label></div>`}).join('')}\n ${free.length?`<h4>إضافة مضخات للشفت</h4>${laneGroups(free,'xa',false)}`:''}`,()=>{\n  const keep=s.readings.filter((r,i)=>!$('#xr'+i)||!$('#xr'+i).checked);const add=[...document.querySelectorAll('.xa:checked')].map(x=>byId(db.pumps,x.value));\n  need(keep.length+add.length,'لازم تبقى مضخة واحدة على الأقل');\n  const vals=s.readings.map((r,i)=>{if(!keep.includes(r))return null;const st=parseFloat(V('xs'+i));need(!isNaN(st)&&st>=0,'عداد البداية غير صحيح');const pr=N('xp'+i);need(pr>0,'سعر اللتر غير صحيح');return[st,pr]});\n  add.forEach(p=>need(fuelOf(p.fuelId).price>0,'حدد سعر الوقود للمضخة: '+p.name));\n  s.readings.forEach((r,i)=>{if(!vals[i])return;r.start=vals[i][0];r.price=vals[i][1];const p=byId(db.pumps,r.pumpId);if(p&&!laterShift(s,r.pumpId))p.meter=r.start});\n  add.forEach(p=>keep.push({pumpId:p.id,fuelId:p.fuelId,tankId:p.tankId,price:fuelOf(p.fuelId).price,start:+p.meter||0,end:null}));\n  s.readings=keep;s.empId=V('xe');s.date=V('xd')||s.date;s.openTime=V('xt')||s.openTime;\n  save('تعديل فتح شفت',`رقم ${s.no} — ${nm(db.employees,s.empId)}`)},'حفظ التعديل')}\n/* تعديل بيانات الإغلاق (شفت مغلق) */\nfunction editClosedShift(id){const s=byId(db.shifts,id);try{checkUndo(s)}catch(e){alert(e.message);return}\n const lock=s.readings.map(r=>laterShift(s,r.pumpId));const hadAdv=db.advances.some(a=>a.shiftId===id);\n modal(`تعديل الشفت رقم ${s.no}`,`<div class=\"row\">${fs('العامل','xe',opt(db.employees.filter(e=>e.active!==false||e.id===s.empId)),s.empId)}${fi('التاريخ','xd',s.date,'date')}${fi('وقت الفتح','xt',s.openTime,'time')}${fi('وقت الإغلاق','xc',s.closeTime||'','time')}</div>\n <h4>العدادات</h4>`+s.readings.map((r,i)=>`<div class=\"row\" style=\"margin-bottom:8px\"><div class=\"f\"><label>${mLabel(byId(db.pumps,r.pumpId)||{name:'-'})} — بداية</label>${ltIn('cs'+i,r.start,`${lock[i]?'disabled':''} oninput=\"closeCalcE('${id}')\"`)}</div><div class=\"f\"><label>نهاية</label>${ltIn('ce'+i,r.end,`${lock[i]?'disabled':''} oninput=\"closeCalcE('${id}')\"`)}</div>${fi('سعر اللتر','cp'+i,r.price,'number',`${lock[i]?'disabled':''} oninput=\"closeCalcE('${id}')\"`)}<div class=\"f\" style=\"flex:2\"><label>&nbsp;</label><div id=\"cr${i}\" style=\"padding:8px 0;color:var(--mut)\">${lock[i]?'مقفل: أكو شفت بعده على نفس المضخة':''}</div></div></div>`).join('')+\n `<div class=\"row\">${fi('النقد المستلم من العامل','crc',s.received,'number',`oninput=\"closeCalcE('${id}')\"`)}</div><div id=\"csum\" style=\"margin-top:10px\"></div>\n <label style=\"display:flex;gap:6px;align-items:center\"><input type=\"checkbox\" id=\"cadv\" ${hadAdv||s.diff>=0?'checked':''}> إذا أكو عجز، يُسجل كسلفة على العامل</label>`,()=>{\n  const ends=readEnds(s,lock);const starts=s.readings.map((r,i)=>{if(lock[i])return r.start;const v=parseFloat(V('cs'+i));need(!isNaN(v)&&v>=0,'عداد البداية غير صحيح');return v});\n  const prices=s.readings.map((r,i)=>lock[i]?r.price:N('cp'+i));need(prices.every(x=>x>0),'سعر اللتر غير صحيح');const rcv=N('crc');const adv=$('#cadv').checked;const old=s.diff;\n  undoClose(s);s.readings.forEach((r,i)=>{r.start=starts[i];r.price=prices[i]});s.empId=V('xe');s.date=V('xd')||s.date;s.openTime=V('xt')||s.openTime;s.closeTime=V('xc')||nowT();\n  applyClose(s,ends,rcv,adv);save('تعديل إغلاق شفت',`رقم ${s.no}: مبيعات ${fmt(s.total)}، مستلم ${fmt(rcv)}، فرق ${fmt(old)} ← ${fmt(s.diff)}`);setTimeout(()=>viewShift(id),50)},'حفظ التعديل');\n setTimeout(()=>closeCalcE(id),0)}\nfunction closeCalcE(id){const s=byId(db.shifts,id);let tot=0,cashExp=0;\n s.readings.forEach((r,i)=>{const st=parseFloat(V('cs'+i)),end=parseFloat(V('ce'+i)),pr=parseFloat(V('cp'+i))||r.price;const ml=isNaN(end)||isNaN(st)?0:Math.max(0,end-st);\n  const sl=db.sales.filter(x=>x.shiftId===id&&x.pumpId===r.pumpId&&!x.auto);const rec=sl.reduce((a,x)=>a+x.liters,0);const rem=r2(ml-rec);\n  const v=document.getElementById('cr'+i);if(v&&!v.textContent.startsWith('مقفل'))v.innerHTML=`صرف العداد ${fmt(ml)} لتر • مسجل ${fmt(rec)} • ${rem>=0?'يُحسب بيع نقدي '+fmt(rem)+' لتر = '+fmt(rem*(typeof pr!=\"undefined\"?pr:r.price)):'<span class=\"neg\">المسجل أكثر من العداد بـ '+fmt(-rem)+'</span>'}`;\n  tot+=sl.reduce((a,x)=>a+x.amount,0)+Math.max(0,rem)*pr;cashExp+=sl.filter(x=>x.pay==='cash').reduce((a,x)=>a+x.amount,0)+Math.max(0,rem)*pr});\n const rc=N('crc'),diff=r2(rc-cashExp),emp=V('crc')==='';$('#csum').innerHTML=`<div class=\"sum\"><div><span>إجمالي مبيعات الشفت</span><b>${fmt(tot)}</b></div><div><span>النقد المتوقع (المفروض يسلّمه العامل)</span><b>${fmt(cashExp)}</b></div><div><span>${emp?'العجز / الزيادة':diff<0?'عجز على العامل':diff>0?'زيادة':'مطابق ✓'}</span><b class=\"${emp?'':diff<0?'neg':diff>0?'pos':'pos'}\">${emp?'<span style=\"font-size:13px;color:var(--mut)\">أدخل النقد المستلم</span>':fmt(diff)}</b></div></div>${emp?`<div class=\"warn\" style=\"margin:8px 0 0\">العجز يُحسب بعد ما تكتب المبلغ اللي سلّمه العامل فعلاً. <button class=\"btn sm g\" onclick=\"setNF('crc','${cashExp}');$('#crc').dispatchEvent(new Event('input'))\">العامل سلّم المبلغ كامل (${fmt(cashExp)})</button></div>`:''}`}\n/* إعادة فتح شفت مغلق */\nfunction reopenShift(id){const s=byId(db.shifts,id);\n if(s.readings.some(r=>laterShift(s,r.pumpId))){alert('ما ينفع إعادة الفتح: أكو شفت بعده على نفس المضخات. استعمل «تعديل» بدلها.');return}\n if(db.shifts.some(x=>x.status==='open'&&x.readings.some(r=>s.readings.some(q=>q.pumpId===r.pumpId)))){alert('أكو شفت مفتوح على نفس المضخات — أغلقه أولاً');return}\n if(!confirm(`إعادة فتح الشفت رقم ${s.no}؟\\nيُلغى الإغلاق (فرق العداد، العجز/الزيادة، وسلفة العجز) ويرجع الشفت مفتوح، والمبيعات المسجلة يدوياً تبقى.`))return;\n try{undoClose(s)}catch(e){alert(e.message);return}save('إعادة فتح شفت','رقم '+s.no);render()}\n/* مسح الشفت بالكامل */\nfunction delShiftAll(id){const s=byId(db.shifts,id);if(!s)return;try{checkUndo(s)}catch(e){alert(e.message);return}\n const sl=db.sales.filter(x=>x.shiftId===id);\n if(!confirm(`مسح الشفت رقم ${s.no} بالكامل؟\\n\\nيُحذف الشفت مع كل مبيعاته (${sl.length} عملية، ${fmt(sl.reduce((a,x)=>a+x.liters,0))} لتر) وترجع الكميات للخزانات، وتنحذف حركات الصندوق والعجز والسلفة المرتبطة بيه، وترجع عدادات المضخات لقراءة البداية.\\n\\nما ينفع التراجع. متابعة؟`))return;\n if(s.status==='closed')undoClose(s);\n db.sales.filter(x=>x.shiftId===id).map(x=>x.id).forEach(rmSale);\n s.readings.forEach(r=>{const p=byId(db.pumps,r.pumpId);if(p&&!laterShift(s,r.pumpId))p.meter=r.start});\n db.shifts=db.shifts.filter(x=>x.id!==id);closeM();save('مسح شفت بالكامل',`رقم ${s.no} — ${nm(db.employees,s.empId)} (${sl.length} عملية بيع)`);render()}\nfunction viewShift(id){const s=byId(db.shifts,id);const sl=db.sales.filter(x=>x.shiftId===id);\n const html=`<p><b>شفت رقم ${s.no}</b> — العامل: ${esc(nm(db.employees,s.empId))} — ${s.date} من ${t12(s.openTime)} إلى ${t12(s.closeTime)}</p>\n ${tbl(['المضخة','الوقود','البداية','النهاية','اللترات','السعر','القيمة'],s.readings.map(r=>[esc(nm(db.pumps,r.pumpId)),esc(fuelOf(r.fuelId).name),`<span class=\"num\">${fmt(r.start)}</span>`,`<span class=\"num\">${fmt(r.end)}</span>`,`<span class=\"num\">${fmt(lit(r))}</span>`,money(r.price),money(lit(r)*r.price)]))}\n <h4>المبيعات الآجلة</h4>${tbl(['العميل','لتر','المبلغ'],sl.filter(x=>x.pay==='credit').map(x=>[esc(nm(db.customers,x.customerId)),`<span class=\"num\">${fmt(x.liters)}</span>`,money(x.amount)]))}\n <table style=\"margin-top:10px\"><tr><th>إجمالي المبيعات</th><td class=\"num\">${fmt(s.total)}</td><th>الآجل</th><td class=\"num\">${fmt(s.credit)}</td></tr><tr><th>النقد المتوقع</th><td class=\"num\">${fmt(s.expected)}</td><th>المستلم</th><td class=\"num\">${fmt(s.received)}</td></tr><tr><th>الفرق</th><td class=\"num ${s.diff<0?'neg':''}\" colspan=\"3\">${fmt(s.diff)} ${s.diff<0?'(عجز)':s.diff>0?'(زيادة)':''}</td></tr></table>\n <p style=\"margin-top:20px\">توقيع العامل: ................ &nbsp;&nbsp;&nbsp; توقيع المحاسب: ................</p>`;\n modal('تفاصيل الشفت رقم '+s.no,`<div id=\"shv\">${html}</div><div class=\"row\"><button class=\"btn s\" onclick=\"printBox('shv','تقرير شفت رقم ${s.no}')\">${ic('print',18)} طباعة</button><button class=\"btn\" onclick=\"closeM();editClosedShift('${s.id}')\">تعديل</button>${can('del')?`<button class=\"btn r\" onclick=\"delShiftAll('${s.id}')\">مسح الشفت</button>`:''}</div>`)}\n\n\n\n\n/* ================= نافذة الخزان التفصيلية ================= */\nfunction openTank(id){const t=byId(db.tanks,id);if(!t)return;const f=fuelOf(t.fuelId),cn=can('tanks'),d=today(),m=month(d);\n const pc=t.capacity?Math.max(0,Math.min(100,Math.round(t.qty/t.capacity*100))):0,over=t.capacity&&t.qty>t.capacity;\n const sl=db.sales.filter(x=>x.tankId===id);const sum=a=>({l:r2(a.reduce((q,x)=>q+x.liters,0)),a:r2(a.reduce((q,x)=>q+x.amount,0))});\n const td=sum(sl.filter(x=>x.date===d)),mo=sum(sl.filter(x=>month(x.date)===m));\n let w=0;for(let i=0;i<7;i++){const x=new Date();x.setDate(x.getDate()-i);const k=today(x);w+=sl.filter(s=>s.date===k).reduce((q,s)=>q+s.liters,0)}const avg=r2(w/7),days=avg>0?Math.floor(t.qty/avg):null;\n const ms=db.pumps.filter(p=>p.tankId===id).sort(mSort);\n const rc=db.receipts.filter(r=>r.tankId===id).sort((a,b)=>b.date.localeCompare(a.date)).slice(0,10).map(r=>[r.date,esc(r.inv||''),esc(nm(db.suppliers,r.supplierId)),`<span class=\"num\">${fmt(r.liters)}</span>`,money(r.cost),money(r.total)]);\n const dp=db.dips.filter(x=>x.tankId===id).slice(-10).reverse().map(x=>[x.date+' '+t12(x.time),`<span class=\"num\">${fmt(x.book)}</span>`,`<span class=\"num\">${fmt(x.real)}</span>`,`<span class=\"num ${x.diff<0?'neg':'pos'}\">${fmt(x.diff)}</span>`,esc(x.by||'')]);\n const box=(a,b,c='')=>`<div><span>${a}</span><b class=\"${c}\" ${/[\\u0600-\\u06FF]/.test(b)?'style=\"direction:rtl;text-align:right\"':''}>${b}</b></div>`;\n const body=`<div id=\"tdv\"><div class=\"dd-h\" style=\"align-items:center\"><div class=\"tank gt\" style=\"--c:${f.color};--ct:${txtOn(f.color)};cursor:default;padding:6px 14px;min-width:190px;transform:none\"><div class=\"orb big\"><div class=\"liq\" style=\"height:${pc}%\"><i class=\"wv\"></i><i class=\"wv w2\"></i></div><i class=\"gl\"></i><span>${pc}%</span></div><div class=\"fn\">${esc(f.name)}</div></div>\n <div style=\"flex:1\"><h2 style=\"margin:0 0 6px;color:#0b2259;display:flex;gap:8px;align-items:center\"><span style=\"color:${f.color};filter:drop-shadow(0 0 6px ${f.color})\">${NOZ}</span>${esc(t.name)}</h2>\n ${over?`<div class=\"warn\" style=\"margin:0 0 8px\">⚠ الرصيد الدفتري (${fmt(t.qty)}) أكثر من سعة الخزان (${fmt(t.capacity)}). سوّي قياس يدوي حتى يتصحح.</div>`:''}\n <div class=\"sum\">${box('الرصيد الحالي (لتر)',fmt(t.qty))}${box('السعة (لتر)',fmt(t.capacity))}${box('الفراغ المتبقي (لتر)',fmt(Math.max(0,(t.capacity||0)-t.qty)))}${box('قيمة الرصيد بالكلفة',fmt(t.qty*(f.cost||0)))}\n ${box('مبيعات اليوم (لتر)',fmt(td.l))}${box('مبيعات اليوم ('+cur()+')',fmt(td.a))}${box('مبيعات الشهر (لتر)',fmt(mo.l))}${box('مبيعات الشهر ('+cur()+')',fmt(mo.a))}\n ${box('معدل الصرف اليومي (آخر 7 أيام)',fmt(avg)+' لتر')}${box('يكفي تقريباً',days==null?'—':days+' يوم',days!=null&&days<3?'neg':'')}${box('سعر البيع / الكلفة',fmt(f.price)+' / '+fmt(f.cost))}${box('نسبة التنبيه',(+db.settings.low||20)+'%')}</div></div></div>\n ${cn?`<div class=\"row\" style=\"margin:6px 0 10px\">${fi('اسم الخزان','tdn',t.name,'text','oninput=\"ddDirty()\"')}${fs('نوع الوقود','tdf',opt(db.fuels),t.fuelId,'oninput=\"ddDirty()\"')}${fi('السعة (لتر)','tdc',t.capacity,'number','oninput=\"ddDirty()\"')}</div>\n <div class=\"row\" style=\"margin-bottom:6px\"><button class=\"btn o\" onclick=\"closeM(true);dipTank('${t.id}')\">قياس يدوي</button><button class=\"btn\" onclick=\"closeM(true);addReceipt('${t.id}')\">${ic('truck',18)} استلام وقود لهذا الخزان</button></div>`:''}\n <h4 class=\"ddt\">${gi('pump',18)} العدادات المرتبطة بالخزان</h4>${tbl(['المجموعة','العداد','آخر قراءة','الحالة','المستلم'],ms.map(p=>{const sh=pumpShift(p.id);return[lnTag(laneOfM(p)),esc(p.name),`<span class=\"num\">${fmt(p.meter)}</span>`,p.active?'<span class=\"tag tg\">يعمل</span>':'<span class=\"tag tx\">متوقف</span>',sh?`${esc(nm(db.employees,sh.empId))} — من ${t12(sh.openTime)}`:'—']}))}\n <h4 class=\"ddt\">${gi('truck',18)} آخر استلامات الوقود</h4>${tbl(['التاريخ','الوصل','المورد','اللترات','سعر اللتر','القيمة'],rc)}\n <h4 class=\"ddt\">${gi('tank',18)} سجل القياس اليدوي</h4>${tbl(['الوقت','الدفتري','الفعلي','الفرق','بواسطة'],dp)}</div>\n <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn s\" onclick=\"printBox('tdv','تقرير الخزان ${esc(t.name).replace(/'/g,'')}','reports')\">${ic('print',18)} طباعة التقرير</button></div>`;\n modal('تفاصيل الخزان — '+esc(t.name),body,cn?()=>{if(!MDIRTY)return true;need(V('tdn'),'أدخل اسم الخزان');const old=t.fuelId;t.name=V('tdn');t.fuelId=V('tdf')||t.fuelId;t.capacity=N('tdc');\n  db.pumps.forEach(p=>{if(p.tankId===t.id&&!pumpShift(p.id))p.fuelId=t.fuelId});save('تعديل خزان من التفاصيل',`${t.name}: السعة ${fmt(t.capacity)}${old!==t.fuelId?' — تغيير نوع الوقود':''}`)}:null,'حفظ التعديلات');\n const b=$('#modal .mbox');if(b)b.style.width='min(1050px,100%)'}\n/* ================= نافذة المضخة التفصيلية ================= */\nfunction openDisp(id){const d=byId(db.disps,id);if(!d)return;const ms=dispMeters(d),ids=new Set(ms.map(m=>m.id)),cn=can('tanks');const t=today(),m=month(t);\n const sumS=f=>{const l=db.sales.filter(f);return{n:l.length,l:r2(l.reduce((a,x)=>a+x.liters,0)),a:r2(l.reduce((a,x)=>a+x.amount,0))}};\n const tk=db.tanks.map(x=>[x.id,x.name+' — '+fuelOf(x.fuelId).name]);\n const side=mm=>{const f=fuelOf(mm.fuelId),sh=pumpShift(mm.id),rd=sh&&sh.readings.find(r=>r.pumpId===mm.id),lock=!!sh;\n  const td=sumS(x=>x.pumpId===mm.id&&x.date===t),mo=sumS(x=>x.pumpId===mm.id&&month(x.date)===m);\n  const last=db.shifts.filter(x=>x.status==='closed'&&x.readings.some(r=>r.pumpId===mm.id)).sort((a,b)=>b.no-a.no)[0];\n  return`<div class=\"dd-sd ${mm.active?'on':''}\"><div class=\"top\"><span class=\"sl\" style=\"display:inline-block;font-size:13px;font-weight:800;color:#fff;background:#0d2a66;border-radius:7px;padding:2px 10px\">العداد ${SIDE[mm.side]}</span><span class=\"pi\" style=\"color:${mm.active?f.color:'#9ca3af'}\">${ic('pump',38)}</span><b style=\"color:${f.color}\">${esc(f.name)}</b><span class=\"tag ${mm.active?'tg':'tx'}\" style=\"margin-right:auto\">${mm.active?'يعمل':'متوقف'}</span></div>\n  <div class=\"rcv ${sh?'':'no'}\">${sh?`${ic('user',20)} <span>مستلمها: <b>${esc(nm(db.employees,sh.empId))}</b></span><span>${ic('clock',18)} من الساعة <b>${t12(sh.openTime)}</b>${sh.date!==today()?` (${sh.date})`:''}</span><span class=\"tag tb\">شفت ${sh.no}</span>`:`${ic('user',20)} ما مستلمها أحد حالياً (لا يوجد شفت مفتوح)`}</div>\n  <div class=\"sum\"><div><span>قراءة العداد الحالية</span><b>${fmt(mm.meter)}</b></div><div><span>مدة الاستلام</span><b style=\"font-size:14px\">${sh?shiftAge(sh):'—'}</b></div>\n  <div><span>مبيعات اليوم (لتر)</span><b>${fmt(td.l)}</b></div><div><span>مبيعات اليوم (${cur()})</span><b>${fmt(td.a)}</b></div>\n  <div><span>مبيعات الشهر (لتر)</span><b>${fmt(mo.l)}</b></div><div><span>مبيعات الشهر (${cur()})</span><b>${fmt(mo.a)}</b></div>\n  ${rd?`<div><span>بداية الشفت الحالي</span><b>${fmt(rd.start)}</b></div><div><span>مسجل بالشفت (لتر)</span><b>${fmt(db.sales.filter(x=>x.shiftId===sh.id&&x.pumpId===mm.id).reduce((a,x)=>a+x.liters,0))}</b></div>`:''}\n  ${last?`<div style=\"grid-column:1/-1\"><span>آخر شفت مغلق</span><b style=\"font-size:14px\">رقم ${last.no} — ${last.date} — ${esc(nm(db.employees,last.empId))}</b></div>`:''}</div>\n  ${cn?`<div class=\"row\">${fs('الخزان المرتبط','dt'+mm.side,tk,mm.tankId,lock?'disabled':'oninput=\"ddDirty()\"')}${fl('قراءة العداد','dm'+mm.side,mm.meter,lock?'disabled':'oninput=\"ddDirty()\"')}${fs('الحالة','da'+mm.side,[['1','يعمل'],['0','متوقف']],mm.active!==false?'1':'0','oninput=\"ddDirty()\"')}</div>${lock?`<p style=\"color:#b45309;font-size:12px;margin:6px 0 0\">العداد داخل شفت مفتوح — الخزان والقراءة تتعدل بعد إغلاق الشفت.</p>`:''}`:''}</div>`};\n const shs=db.shifts.filter(x=>x.status==='closed'&&x.readings.some(r=>ids.has(r.pumpId))).sort((a,b)=>b.no-a.no).slice(0,10);\n const shRows=shs.flatMap(x=>x.readings.filter(r=>ids.has(r.pumpId)).map(r=>{const mm=byId(db.pumps,r.pumpId)||{};return[x.no,x.date,esc(nm(db.employees,x.empId)),SIDE[mm.side]||'',`<span class=\"num\">${fmt(r.start)}</span>`,`<span class=\"num\">${fmt(r.end)}</span>`,`<span class=\"num\">${fmt(lit(r))}</span>`,money(lit(r)*r.price)]}));\n const sl=db.sales.filter(x=>ids.has(x.pumpId)).sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time)).slice(0,12).map(x=>[x.date,t12(x.time),SIDE[(byId(db.pumps,x.pumpId)||{}).side]||'',`<span class=\"dot\" style=\"background:${fuelOf(x.fuelId).color}\"></span>${esc(fuelOf(x.fuelId).name)}`,`<span class=\"num\">${fmt(x.liters)}</span>`,money(x.amount),x.pay==='credit'?`<span class=\"tag ty\">آجل</span>`:x.auto?'<span class=\"tag tb\">فرق عداد</span>':'<span class=\"tag tg\">نقد</span>']);\n const tot=sumS(x=>ids.has(x.pumpId)&&month(x.date)===m);\n const body=`<div id=\"ddv\"><div class=\"dd-h\">${gi('pump',38,'xl')}<div><h2>${lnTag(d.lane,1)} ${esc(d.name)}</h2><div style=\"color:var(--mut)\">${ms.length} عداد • مبيعات الشهر: <b class=\"num\">${fmt(tot.l)}</b> لتر = <b class=\"num\">${fmt(tot.a)}</b> ${cur()}</div></div><span class=\"dd-dirty\" id=\"ddd\">● تعديلات غير محفوظة</span></div>\n ${cn?`<div class=\"row\" style=\"margin-bottom:12px\">${fi('اسم المضخة','dn',d.name,'text','oninput=\"ddDirty()\"')}${fs('المجموعة','dl',db.settings.lanes.map(l=>[l.k,l.k]),d.lane,'oninput=\"ddDirty()\"')}</div>`:''}\n <div class=\"dd-sides\">${ms.map(side).join('')}</div>\n <h4 class=\"ddt\">${gi('clock',18)} آخر الشفتات على هذه المضخة</h4>${tbl(['الشفت','التاريخ','العامل','العداد','البداية','النهاية','اللترات','القيمة'],shRows)}\n <h4 class=\"ddt\">${gi('list',18)} آخر عمليات البيع</h4>${tbl(['التاريخ','الوقت','العداد','الوقود','لتر','المبلغ','الدفع'],sl)}</div>\n <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn s\" onclick=\"printBox('ddv','تقرير ${esc(d.name).replace(/'/g,'')}')\">${ic('print',18)} طباعة التقرير</button></div>`;\n modal('تقرير المضخة — '+esc(d.name),body,cn?()=>{\n  if(!MDIRTY)return true;need(V('dn'),'أدخل اسم المضخة');const nmv=V('dn');\n  ms.forEach(mm=>{const lock=!!pumpShift(mm.id);if(!lock){const t=byId(db.tanks,V('dt'+mm.side));need(t,'اختر الخزان');const mv=parseFloat(V('dm'+mm.side));need(!isNaN(mv)&&mv>=0,'قراءة العداد غير صحيحة')}});\n  d.name=nmv;d.lane=V('dl')||d.lane;\n  ms.forEach(mm=>{const lock=!!pumpShift(mm.id);mm.name=d.name+' — '+SIDE[mm.side];mm.active=V('da'+mm.side)==='1';if(!lock){const t=byId(db.tanks,V('dt'+mm.side));mm.tankId=t.id;mm.fuelId=t.fuelId;mm.meter=N('dm'+mm.side)}});\n  save('تعديل مضخة من التقرير',`${d.name}: `+ms.map(mm=>`${SIDE[mm.side]} ${fmt(mm.meter)} ${mm.active?'يعمل':'متوقف'}`).join(' • '))}:null,'حفظ التعديلات');\n const b=$('#modal .mbox');if(b)b.style.width='min(1050px,100%)'}\nfunction shiftAge(sh){const a=new Date(sh.date+'T'+(sh.openTime||'00:00'));let mn=Math.max(0,Math.round((Date.now()-a)/60000));const h=Math.floor(mn/60);mn%=60;return(h?h+' ساعة ':'')+mn+' دقيقة'}\nfunction ddDirty(){MDIRTY=true;const e=$('#ddd');if(e)e.classList.add('on')}\n\n/* ================= إعدادات الطباعة ================= */\nfunction printSetBox(){const P=db.settings.print;const opt2=[['a4','طابعة A4'],['pos','طابعة POS (وصولات)']];\n return`<div class=\"box\"><h3>${gi('print',19)} نوع الطابعة لكل ملف طباعة</h3><p style=\"color:var(--mut);font-size:12.5px;margin-top:0\">اختار لكل نوع من الطباعة يطلع على ورق A4 لو على طابعة الوصولات POS.</p>\n ${tbl(['الملف','الطابعة','تجربة'],PKINDS.map(([k,n])=>[`<b>${n}</b>`,`<select id=\"pm_${k}\" style=\"border:1px solid #c7d2e3;border-radius:8px;padding:6px 8px;min-width:190px\">${opt2.map(o=>`<option value=\"${o[0]}\" ${P.map[k]===o[0]?'selected':''}>${o[1]}</option>`).join('')}</select>`,`<button class=\"btn sm s\" onclick=\"testPrint('${k}')\">${ic('print',14)} طباعة تجريبية</button>`]))}</div>\n <div class=\"grid2\" style=\"grid-template-columns:1fr 1fr\"><div class=\"box\"><h3>${gi('print',19)} إعدادات طابعة A4</h3><div class=\"row\">${fs('اتجاه الورقة','pa_or',[['portrait','عمودي'],['landscape','أفقي']],P.orient)}${fi('الهوامش (ملم)','pa_m',P.a4m,'number')}${fi('حجم الخط','pa_fs',P.fs,'number')}</div></div>\n <div class=\"box\"><h3>${gi('receipt',19)} إعدادات طابعة POS</h3><div class=\"row\">${fs('عرض الورق','pp_w',[['80','80 ملم'],['58','58 ملم']],String(P.posW))}${fi('حجم الخط','pp_fs',P.posFs,'number')}</div></div></div>\n <div class=\"box\"><h3>رأس وذيل الطباعة</h3><div class=\"row\"><label style=\"display:flex;gap:6px;align-items:center;font-weight:700;min-width:260px\"><input type=\"checkbox\" id=\"ph_on\" ${P.header!==false?'checked':''}> طباعة اسم المحطة والعنوان بالرأس</label>${fi('نص أسفل الطباعة (اختياري)','ph_ft',P.footer||'','text','placeholder=\"مثلاً: شكراً لزيارتكم\"')}</div>\n <p style=\"color:var(--mut);font-size:12.5px\">اختيار الطابعة نفسها يصير من نافذة الطباعة بالمتصفح، والمتصفح يتذكر آخر طابعة اخترتها. إذا عندك طابعتين، اختار طابعة الوصولات أول مرة تطبع وصل، وطابعة A4 أول مرة تطبع تقرير.</p>\n <button class=\"btn g\" onclick=\"savePrintSet()\">حفظ إعدادات الطباعة</button></div>`}\nfunction savePrintSet(){const P=db.settings.print;PKINDS.forEach(([k])=>{const e=$('#pm_'+k);if(e)P.map[k]=e.value});P.orient=V('pa_or');P.a4m=N('pa_m')||10;P.fs=N('pa_fs')||12;P.posW=+V('pp_w')||80;P.posFs=N('pp_fs')||11;P.header=$('#ph_on').checked;P.footer=V('ph_ft');\n save('إعدادات الطباعة',PKINDS.map(([k,n])=>n+': '+(P.map[k]==='pos'?'POS':'A4')).join('، '));alert('تم حفظ إعدادات الطباعة');render()}\nfunction testPrint(k){const e=$('#pm_'+k);const keep=db.settings.print.map[k];if(e)db.settings.print.map[k]=e.value;const n=(PKINDS.find(x=>x[0]===k)||[0,''])[1];\n printHTML('طباعة تجريبية — '+n,`<h3>${esc(n)}</h3><table><tr><th>البند</th><th>الكمية</th><th>المبلغ</th></tr><tr><td>بنزين عادي</td><td class=\"num\">40</td><td class=\"num\">${fmt(44000)}</td></tr><tr><td>دهن محرك</td><td class=\"num\">1</td><td class=\"num\">${fmt(25000)}</td></tr></table><p>نوع الطابعة: <b>${db.settings.print.map[k]==='pos'?'POS '+db.settings.print.posW+' ملم':'A4'}</b></p>`,false,k);db.settings.print.map[k]=keep}\n\n/* ================= دفع ديون المشتريات ووصل استلام مبلغ ================= */\nfunction tafqeet(n){n=Math.floor(Math.abs(+n||0));if(!n)return'صفر';const O=['','واحد','اثنان','ثلاثة','أربعة','خمسة','ستة','سبعة','ثمانية','تسعة','عشرة','أحد عشر','اثنا عشر','ثلاثة عشر','أربعة عشر','خمسة عشر','ستة عشر','سبعة عشر','ثمانية عشر','تسعة عشر'],\n T=['','','عشرون','ثلاثون','أربعون','خمسون','ستون','سبعون','ثمانون','تسعون'],H=['','مائة','مائتان','ثلاثمائة','أربعمائة','خمسمائة','ستمائة','سبعمائة','ثمانمائة','تسعمائة'];\n const u=x=>{const h=Math.floor(x/100),r=x%100,p=[];if(h)p.push(H[h]);if(r){if(r<20)p.push(O[r]);else{const o=r%10;p.push(o?O[o]+' و'+T[Math.floor(r/10)]:T[Math.floor(r/10)])}}return p.join(' و')};\n const S=[[1e9,'مليار','ملياران','مليارات'],[1e6,'مليون','مليونان','ملايين'],[1e3,'ألف','ألفان','آلاف']],P=[];\n for(const[v,a,b,c]of S){const k=Math.floor(n/v);if(k){P.push(k===1?a:k===2?b:k<=10?u(k)+' '+c:u(k)+' '+a);n%=v}}if(n)P.push(u(n));return P.join(' و')}\nconst curWord=()=>/د\\.?ع|دينار/.test(cur())?'دينار عراقي':cur();\nfunction payReceipt(id){const r=byId(db.receipts,id);if(!r)return;const rem=r2(r.total-r.paid),sup=byId(db.suppliers,r.supplierId)||{name:'-'};\n modal('دفع دين — '+esc(sup.name),`<div class=\"sum\"><div><span>قيمة الحمولة</span><b>${fmt(r.total)}</b></div><div><span>المدفوع سابقاً</span><b class=\"pos\">${fmt(r.paid)}</b></div><div><span>المتبقي (دين)</span><b class=\"neg\">${fmt(rem)}</b></div><div><span>رصيد الصندوق</span><b>${fmt(cashBal())}</b></div></div>\n <p style=\"margin:0 0 8px;color:var(--mut)\">${esc(fuelOf(r.fuelId).name)} ${fmt(r.liters)} لتر — ${esc(nm(db.tanks,r.tankId))}${r.inv?' — وصل رقم '+esc(r.inv):''} — بتاريخ ${r.date}</p>\n <div class=\"row\">${fi('التاريخ','yd',today(),'date')}${fi('المبلغ المدفوع','ya',rem,'number')}${fi('ملاحظات','yn')}</div>\n <div class=\"row\" style=\"margin-top:6px\"><button class=\"btn sm s\" onclick=\"setNF('ya',${rem})\">تسديد كامل (${fmt(rem)})</button></div>`,()=>{\n  const a=N('ya');need(a>0,'أدخل المبلغ');need(a<=rem+0.001,'المبلغ أكثر من الدين المتبقي ('+fmt(rem)+')');if(a>cashBal()&&!confirm('رصيد الصندوق ('+fmt(cashBal())+') أقل من المبلغ. متابعة؟'))return false;\n  const c=addCash({type:'out',kind:'sup',amount:a,supplierId:r.supplierId,ref:r.id,recId:r.id,date:V('yd')||today(),note:'تسديد دين شراء وقود — '+fuelOf(r.fuelId).name+' '+fmt(r.liters)+' لتر'+(r.inv?' — وصل '+r.inv:'')+(V('yn')?' — '+V('yn'):'')});\n  c.vno=db.settings.payNo=(+db.settings.payNo||0)+1;r.paid=r2(r.paid+a);\n  save('تسديد دين مورد',`${sup.name}: ${fmt(a)} — المتبقي ${fmt(r.total-r.paid)}`);if(MPRINT){MPRINT=false;setTimeout(()=>printPayV(c.id),80)}},'حفظ الدفع',`<button class=\"btn\" onclick=\"MPRINT=true;mOk()\">${ic('print',18)} حفظ وطباعة وصل</button>`)}\nfunction recPays(id){const L=db.cash.filter(c=>c.ref===id&&c.vno);modal('وصولات الدفع',tbl(['رقم الوصل','التاريخ','المبلغ',''],L.map(c=>[c.vno,c.date,money(c.amount),`<button class=\"btn sm\" onclick=\"printPayV('${c.id}')\">${ic('print',14)} طباعة</button>`])))}\nfunction printPayV(cid){const c=byId(db.cash,cid);if(!c)return;const S=db.settings,sup=byId(db.suppliers,c.supplierId)||{name:'-',phone:''};const r=c.recId?byId(db.receipts,c.recId):null;\n const html=`<style>.vc{max-width:520px;margin:0 auto;font-size:13.5px;line-height:1.9}.vc h2{text-align:center;margin:0}.vc .c{text-align:center}.vc .t{font-size:18px;font-weight:900;text-align:center;border:2px solid #000;border-radius:8px;padding:4px;margin:10px 0}.vc .amt{font-size:22px;font-weight:900;border:2px dashed #000;border-radius:8px;padding:4px 10px;display:inline-block}.vc .ln{border-top:1px dashed #000;margin:10px 0}.vc table td{border:0;padding:4px 0}.vc .sg{display:flex;justify-content:space-between;margin-top:26px}</style>\n <div class=\"vc\"><h2>${esc(S.name)}</h2><div class=\"c\">${esc(S.address||'')} ${esc(S.phone||'')}</div>\n <div class=\"t\">وصل استلام مبلغ رقم ${c.vno||''}</div>\n <div>التاريخ: <b>${c.date}</b> &nbsp;&nbsp; الوقت: <b>${t12(c.time||nowT())}</b></div>\n <div>استلم السيد / الجهة: <b>${esc(sup.name)}</b> ${sup.phone?`— ${esc(sup.phone)}`:''}</div>\n <div>من: <b>${esc(S.name)}</b></div>\n <div>مبلغاً وقدره: <span class=\"amt\"><span class=\"num\" style=\"direction:ltr;unicode-bidi:isolate\">${fmt(c.amount)}</span> ${cur()}</span></div>\n <div>كتابةً: <b>${tafqeet(c.amount)} ${curWord()} فقط لا غير</b></div>\n <div>وذلك عن: <b>${esc(c.note||'تسديد دين')}</b></div>\n ${r?`<div class=\"ln\"></div><table><tr><td>قيمة الحمولة:</td><td class=\"num\"><b>${fmt(r.total)}</b></td><td>المدفوع لحد الآن:</td><td class=\"num\"><b>${fmt(r.paid)}</b></td></tr><tr><td>المتبقي من هذا الوصل:</td><td class=\"num\"><b>${fmt(r.total-r.paid)}</b></td><td>رصيد المورد الكلي:</td><td class=\"num\"><b>${fmt(supBal(sup))}</b></td></tr></table>`:`<div>رصيد المورد بعد الدفع: <b class=\"num\">${fmt(supBal(sup))}</b> ${cur()}</div>`}\n <div class=\"ln\"></div><div>بواسطة: ${esc(c.by||'')}</div>\n <div class=\"sg\"><div>توقيع المستلم<br><br>....................</div><div>توقيع المحاسب<br><br>....................</div></div></div>`;\n printHTML('وصل استلام مبلغ',html,true,'pay')}\n/* ================= فورمة العدادات لقارئ المقاييس ================= */\nfunction meterSVG(side,fuel,color,val,cap){const n=val==null?null:(+val||0);const ip=n==null?'':String(Math.floor(n)).padStart(7,'0').slice(-7),dp=n==null?'':String(Math.round((n-Math.floor(n))*100)).padStart(2,'0');\n const cells=[];for(let i=0;i<9;i++){const x=22+i*29+(i>=7?10:0);const ch=n==null?'':(i<7?ip[i]:dp[i-7]);\n  cells.push(`<rect x=\"${x}\" y=\"62\" width=\"25\" height=\"38\" rx=\"4\" fill=\"${n==null?'#fff':(i>=7?'#7f1d1d':'#111827')}\" stroke=\"#111\" stroke-width=\"1.5\"/>${ch!==''?`<text x=\"${x+12.5}\" y=\"90\" text-anchor=\"middle\" font-family=\"Consolas,'Courier New',monospace\" font-size=\"25\" font-weight=\"700\" fill=\"#fff\">${ch}</text>`:''}`)}\n return`<svg viewBox=\"0 0 310 150\" width=\"100%\" style=\"max-width:310px;display:block;margin:auto;direction:ltr\" direction=\"ltr\" xmlns=\"http://www.w3.org/2000/svg\">\n <rect x=\"2\" y=\"2\" width=\"306\" height=\"146\" rx=\"16\" fill=\"#e5e7eb\" stroke=\"#111\" stroke-width=\"2.5\"/><rect x=\"10\" y=\"10\" width=\"290\" height=\"34\" rx=\"9\" fill=\"${color}\"/>\n <text x=\"290\" y=\"33\" text-anchor=\"end\" font-family=\"Tahoma,Arial\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">العداد ${side}</text>\n <text x=\"20\" y=\"33\" text-anchor=\"start\" font-family=\"Tahoma,Arial\" font-size=\"13\" fill=\"#fff\">${esc(fuel)}</text>\n <rect x=\"14\" y=\"54\" width=\"282\" height=\"54\" rx=\"8\" fill=\"#9ca3af\" stroke=\"#111\" stroke-width=\"1.5\"/>${cells.join('')}<circle cx=\"${22+7*29+4}\" cy=\"96\" r=\"2.5\" fill=\"#111\"/>\n <text x=\"155\" y=\"134\" text-anchor=\"middle\" font-family=\"Tahoma,Arial\" font-size=\"14\" font-weight=\"700\" fill=\"#111\">${cap}</text></svg>`}\nfunction printMeterForm(shiftId){const S=db.settings;\n const shifts=db.shifts.filter(x=>x.status==='open'&&(!shiftId||x.id===shiftId));\n const groups=shifts.map(sh=>({sh,emp:nm(db.employees,sh.empId),reads:sh.readings}));\n if(!shiftId){const used=new Set(shifts.flatMap(x=>x.readings.map(r=>r.pumpId)));const rest=db.pumps.filter(p=>p.active&&!used.has(p.id));\n  if(rest.length)groups.push({sh:null,emp:'',reads:rest.map(p=>({pumpId:p.id,fuelId:p.fuelId,start:p.meter}))})}\n if(!groups.length){alert('لا توجد عدادات للطباعة');return}\n const page=g=>{const byD={};g.reads.forEach(r=>{const p=byId(db.pumps,r.pumpId);if(!p)return;(byD[p.dispId]=byD[p.dispId]||{})[p.side||'R']=r});\n  const blocks=Object.keys(byD).sort((a,b)=>laneIdx((byId(db.disps,a)||{}).lane)-laneIdx((byId(db.disps,b)||{}).lane)).map(did=>{const d=byId(db.disps,did)||{name:'-'};const col=k=>{const r=byD[did][k];const p=dispMeters(d).find(m=>m.side===k);\n    if(!r)return`<td class=\"mc off\"><div class=\"na\">العداد ${SIDE[k]}<br>${p?'ليس ضمن هذه الفورمة':'لا يوجد'}</div></td>`;const f=fuelOf(r.fuelId);\n    return`<td class=\"mc\">${meterSVG(SIDE[k],f.name,f.color,r.start,'بداية الشفت')}${meterSVG(SIDE[k],f.name,f.color,null,'نهاية الشفت (يكتبها قارئ المقاييس)')}<div class=\"lt\">اللترات المصروفة: ...............................</div></td>`};\n   return`<div class=\"dsp\" style=\"border-right:8px solid ${laneC(d.lane)}\"><div class=\"dh\"><span style=\"display:inline-block;background:${laneC(d.lane)};color:#fff;border-radius:6px;padding:0 10px;margin-left:8px;-webkit-print-color-adjust:exact;print-color-adjust:exact\">المجموعة ${esc(d.lane||'')}</span>${esc(d.name)}</div><table class=\"mt\"><tr>${col('R')}${col('L')}</tr></table></div>`}).join('');\n  return`<div class=\"pg\"><div class=\"ph\"><div><h2>${esc(S.name)}</h2><div>${esc(S.address||'')} ${esc(S.phone||'')}</div></div><div class=\"tt\">فورمة قراءة العدادات</div>\n  <div style=\"text-align:left\">${g.sh?`شفت رقم <b>${g.sh.no}</b><br>${g.sh.date} — فتح ${t12(g.sh.openTime)}`:`${today()} ${t12(nowT())}`}</div></div>\n  <table class=\"info\"><tr><th>العامل</th><td style=\"font-size:18px;font-weight:700\">${g.emp?esc(g.emp):'............................................'}</td><th>عدد العدادات</th><td>${g.reads.length}</td><th>وقت قراءة النهاية</th><td>.......................</td></tr></table>\n  ${blocks}\n  <table class=\"sig\"><tr><td>توقيع قارئ المقاييس<br><br>.......................</td><td>توقيع العامل<br><br>.......................</td><td>توقيع المحاسب<br><br>.......................</td></tr></table></div>`};\n const css=`<style>@page{size:A4;margin:10mm}.pg{page-break-after:always}.pg:last-child{page-break-after:auto}.ph{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #000;padding-bottom:6px;margin-bottom:8px}.ph .tt{font-size:20px;font-weight:900;border:2px solid #000;border-radius:8px;padding:4px 14px}\n .info th{background:#eee;width:12%}.dsp{border:1.5px solid #000;border-radius:10px;margin:8px 0;padding:6px;page-break-inside:avoid}.dh{font-size:16px;font-weight:800;margin:0 4px 4px;text-align:right}\n table.mt{border:0;margin:0}table.mt td{border:0;width:50%;vertical-align:top;padding:2px 6px}.mc svg{margin-bottom:6px!important}.mc.off .na{border:1.5px dashed #999;color:#777;border-radius:10px;padding:40px 6px;text-align:center}.lt{font-size:12px;margin-top:2px;text-align:center}\n table.sig td{border:0;text-align:center;padding-top:16px}</style>`;\n printHTML('فورمة قراءة العدادات',css+groups.map(page).join(''),true,'meter');save('طباعة فورمة العدادات',groups.map(g=>g.emp||'بدون شفت').join('، '))}\n/* ================= مشتريات الوقود ================= */\nP.purchases=()=>{const T=[];if(can('purchases'))T.push(['rc','استلام الوقود (الصهاريج)','truck']);if(can('suppliers'))T.push(['sup','المجهزين والموردين','cart']);const t=T.some(x=>x[0]===st.pt)?st.pt:T[0][0];\n const hd=head('مشتريات الوقود','truck')+`<div class=\"stabs\">${T.map(([k,n,g])=>`<a class=\"${t===k?'on':''}\" onclick=\"st.pt='${k}';render()\">${gi(g,16)}<span>${n}</span></a>`).join('')}</div>`;if(t==='sup')return hd+P.suppliers();const m=st.pm||month();const list=db.receipts.filter(r=>month(r.date)===m).slice().reverse();\n const rows=list.map(r=>[r.date,esc(r.inv||''),esc(nm(db.suppliers,r.supplierId)),esc(nm(db.tanks,r.tankId)),esc(fuelOf(r.fuelId).name),`<span class=\"num\">${fmt(r.liters)}</span>`,money(r.cost),money(r.total),rpTag(r),money(r.paid),`<span class=\"num ${r.total-r.paid>0.001?'neg':''}\">${fmt(r.total-r.paid)}</span>`,esc(r.note||''),(r.total-r.paid>0.001?`<button class=\"btn sm g\" onclick=\"payReceipt('${r.id}')\">${ic('money',14)} دفع الدين</button> `:'')+(db.cash.some(c=>c.ref===r.id&&c.vno)?`<button class=\"btn sm s\" onclick=\"recPays('${r.id}')\" title=\"وصولات الدفع\">${ic('print',14)}</button> `:'')+delBtn('delReceipt',r.id)]);\n return hd+`<div class=\"row\" style=\"justify-content:flex-end;margin-bottom:10px\"><button class=\"btn g\" onclick=\"addReceipt()\">${ic('plus',18)} استلام وقود</button></div>`+\n `<div class=\"box\"><div style=\"max-width:200px;margin-bottom:10px\">${fi('الشهر','pmm',m,'month','onchange=\"st.pm=this.value;render()\"')}</div>\n <div class=\"sum\"><div><span>عدد الشحنات</span><b>${list.length}</b></div><div><span>اللترات</span><b>${fmt(list.reduce((a,r)=>a+r.liters,0))}</b></div><div><span>القيمة</span><b>${fmt(list.reduce((a,r)=>a+r.total,0))}</b></div><div><span>المدفوع نقداً</span><b class=\"pos\">${fmt(list.reduce((a,r)=>a+r.paid,0))}</b></div><div><span>آجل (دين للموردين)</span><b class=\"neg\">${fmt(list.reduce((a,r)=>a+r.total-r.paid,0))}</b></div></div>\n ${tbl(['التاريخ','رقم الوصل','المورد','الخزان','الوقود','اللترات','سعر اللتر','القيمة','الدفع','المدفوع','المتبقي (دين)','ملاحظات',''],rows)}</div>`};\nconst rpTag=r=>{const p=r.pay||(r.paid>=r.total-0.001?'cash':'credit');return p==='cash'?'<span class=\"tag tg\">نقد</span>':`<span class=\"tag ty\">آجل${r.paid>0?' + دفعة':''}</span>`};\nfunction rcCalc(){const t=byId(db.tanks,V('rt'));if(t&&(document.activeElement.id==='rt'||V('rc')===''))setNF('rc',fuelOf(t.fuelId).cost||'');$('#rtot').value=fmt(N('rl')*N('rc'));rcPay()}\nfunction rcPay(){const p=V('rpay'),e=$('#rp'),tot=r2(N('rl')*N('rc'));if(!e)return;const lb=e.closest('.f').querySelector('label');\n if(p==='cash'){e.value=fmtIn(tot);e.disabled=true;if(lb)lb.textContent='المبلغ اللي ينزل من الصندوق (نقد كامل)'}else{e.disabled=false;if(lb)lb.textContent='دفعة مقدمة الآن (اختياري — الباقي دين للمورد)';if(e.dataset.was==='cash')e.value='0'}e.dataset.was=p;\n const w=$('#rcw');if(w)w.innerHTML=p==='cash'&&tot>cashBal()?`<div class=\"warn\" style=\"margin:8px 0 0\">⚠ رصيد الصندوق الحالي ${fmt(cashBal())} أقل من المبلغ ${fmt(tot)}</div>`:p==='credit'?`<p style=\"color:var(--mut);font-size:12.5px;margin:6px 0 0\">المبلغ ${fmt(Math.max(0,tot-N('rp')))} يصير دين على المحطة للمورد ويطلع بكشف حسابه.</p>`:''}\nfunction addReceipt(tid){if(!db.tanks.length){alert('أضف الخزانات أولاً');return}if(!db.suppliers.length){alert('أضف المورد أولاً من «مشتريات الوقود ← المجهزين والموردين»');return}\n modal('استلام وقود (تفريغ صهريج)',`<div class=\"row\">${fi('التاريخ','rd',today(),'date')}${fi('رقم الوصل/الفاتورة','ri')}${fs('المورد','rs',opt(db.suppliers))}</div>\n <div class=\"row\">${fs('الخزان','rt',db.tanks.map(t=>[t.id,t.name+' — '+fuelOf(t.fuelId).name+' (متوفر '+fmt(t.qty)+')']),tid||'','onchange=\"rcCalc()\"')}${fl('الكمية (لتر)','rl','','oninput=\"rcCalc()\"')}${fi('سعر شراء اللتر','rc','','number','oninput=\"rcCalc()\"')}<div class=\"f\"><label>القيمة</label><input id=\"rtot\" disabled></div></div>\n <div class=\"row\">${fs('طريقة الدفع','rpay',[['cash','نقد — ينزل من الصندوق'],['credit','آجل — دين للمورد']],'cash','onchange=\"rcPay()\"')}${fi('المبلغ اللي ينزل من الصندوق (نقد كامل)','rp','0','number','oninput=\"rcPay()\"')}${fi('السائق / رقم الصهريج / ملاحظات','rn')}</div><div id=\"rcw\"></div>`,()=>{\n  const t=byId(db.tanks,V('rt')),l=N('rl'),c=N('rc'),pay=V('rpay')||'cash',paid=pay==='cash'?r2(l*c):N('rp');need(pay==='cash'||paid<=r2(l*c),'الدفعة أكثر من قيمة الحمولة');need(t,'اختر الخزان');need(l>0,'أدخل الكمية');need(c>0,'أدخل سعر الشراء');\n  if(t.capacity&&t.qty+l>t.capacity&&!confirm(`الكمية تتجاوز سعة الخزان (${fmt(t.capacity)}). متابعة؟`))return false;\n  const f=fuelOf(t.fuelId);const all=db.tanks.filter(x=>x.fuelId===t.fuelId).reduce((a,x)=>a+Math.max(0,x.qty),0);f.cost=r2(((all*(f.cost||0))+l*c)/((all+l)||1));\n  const r={id:uid(),date:V('rd')||today(),inv:V('ri'),supplierId:V('rs'),tankId:t.id,fuelId:t.fuelId,liters:l,cost:c,total:r2(l*c),paid,pay,note:V('rn'),by:me.name};\n  t.qty=r2(t.qty+l);db.receipts.push(r);if(paid>0)addCash({type:'out',kind:'sup',amount:paid,supplierId:r.supplierId,ref:r.id,date:r.date,note:(pay==='cash'?'شراء وقود نقد — ':'دفعة مقدمة عن شراء وقود آجل — ')+f.name+' '+fmt(l)+' لتر'+(r.inv?' — وصل '+r.inv:'')+' — '+nm(db.suppliers,r.supplierId)});\n  save('استلام وقود',`${f.name} ${fmt(l)} لتر من ${nm(db.suppliers,r.supplierId)} بقيمة ${fmt(r.total)} — ${pay==='cash'?'نقد':'آجل'}${pay==='credit'&&paid?' (مدفوع '+fmt(paid)+')':''}`)},'حفظ الاستلام');rcCalc()}\nfunction delReceipt(id){const r=byId(db.receipts,id);if(!confirm('حذف الاستلام وخصم الكمية من الخزان؟'))return;const t=byId(db.tanks,r.tankId);if(t)t.qty=r2(t.qty-r.liters);\n db.cash=db.cash.filter(c=>c.ref!==id);db.receipts=db.receipts.filter(x=>x.id!==id);save('حذف استلام وقود',`${fmt(r.liters)} لتر — ${nm(db.suppliers,r.supplierId)}`);render()}\n\n/* ================= الخزانات والمضخات والوقود ================= */\nP.tanks=()=>{const t=tab('tt','tanks');let b='';\n if(t==='tanks')b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn g\" onclick=\"editTank()\">${ic('plus',18)} خزان جديد</button></div>`+tbl(['الخزان','الوقود','السعة','الرصيد الدفتري','النسبة',''],db.tanks.map(x=>{const pc=x.capacity?Math.round(x.qty/x.capacity*100):0;return[esc(x.name),`<span class=\"dot\" style=\"background:${fuelOf(x.fuelId).color}\"></span>${esc(fuelOf(x.fuelId).name)}`,`<span class=\"num\">${fmt(x.capacity)}</span>`,`<span class=\"num\">${fmt(x.qty)}</span>`,`<span class=\"tag ${pc<(+db.settings.low||20)?'tr':'tg'}\">${pc}%</span>`,`<button class=\"btn sm\" onclick=\"editTank('${x.id}')\">تعديل</button> <button class=\"btn sm o\" onclick=\"dipTank('${x.id}')\">قياس يدوي</button>`]}));\n if(t==='pumps')b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn g\" onclick=\"editDisp()\">${ic('plus',18)} مضخة جديدة (عداد يمين + يسار)</button></div>`+tbl(['المجموعة','المضخة','العداد','الوقود','الخزان','آخر قراءة عداد','الحالة',''],db.disps.slice().sort((a,b)=>laneIdx(a.lane)-laneIdx(b.lane)).flatMap(d=>dispMeters(d).map((p,i)=>[i?'':lnTag(d.lane,1),i?'':`<b>${esc(d.name)}</b>`,`<span class=\"tag tb\">${SIDE[p.side]||''}</span>`,`<span class=\"dot\" style=\"background:${fuelOf(p.fuelId).color}\"></span>${esc(fuelOf(p.fuelId).name)}`,esc(nm(db.tanks,p.tankId)),`<span class=\"num\">${fmt(p.meter)}</span>`,p.active?'<span class=\"tag tg\">يعمل</span>':'<span class=\"tag tx\">متوقف</span>',(i?'':`<button class=\"btn sm\" onclick=\"editDisp('${d.id}')\">تعديل المضخة</button> `)+`<button class=\"btn sm s\" onclick=\"togglePump('${p.id}')\">${p.active?'إيقاف':'تشغيل'}</button>`])));\n if(t==='fuels')b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn g\" onclick=\"editFuel()\">${ic('plus',18)} نوع وقود</button></div>`+tbl(['النوع','سعر البيع','متوسط الكلفة','الربح باللتر','اللون',''],db.fuels.map(f=>[esc(f.name),money(f.price),money(f.cost),money(f.price-f.cost),`<span class=\"dot\" style=\"background:${f.color}\"></span>`,`<button class=\"btn sm\" onclick=\"editFuel('${f.id}')\">تعديل</button>`]));\n if(t==='dips')b=tbl(['التاريخ','الخزان','الرصيد الدفتري','القياس الفعلي','الفرق','تم التعديل','بواسطة'],db.dips.slice().reverse().map(d=>[d.date+' '+t12(d.time),esc(nm(db.tanks,d.tankId)),`<span class=\"num\">${fmt(d.book)}</span>`,`<span class=\"num\">${fmt(d.real)}</span>`,`<span class=\"num ${d.diff<0?'neg':'pos'}\">${fmt(d.diff)}</span>`,d.adj?'نعم':'لا',esc(d.by)]));\n return head('إدارة الخزانات والمضخات','tank')+tabs('tt',[['tanks','الخزانات'],['pumps','المضخات'],['fuels','أنواع الوقود والأسعار'],['dips','سجل القياس اليدوي']])+`<div class=\"box\">${b}</div>`};\nfunction editTank(id){const x=id?byId(db.tanks,id):{name:'',fuelId:db.fuels[0]?.id,capacity:'',qty:0};\n modal(id?'تعديل خزان':'خزان جديد',`<div class=\"row\">${fi('اسم الخزان','tn',x.name)}${fs('نوع الوقود','tf',opt(db.fuels),x.fuelId)}${fi('السعة (لتر)','tc',x.capacity,'number')}${id?'':fl('الرصيد الحالي (لتر)','tq',x.qty)}</div>`,()=>{\n  need(V('tn'),'أدخل الاسم');const o={name:V('tn'),fuelId:V('tf'),capacity:N('tc')};if(id){Object.assign(x,o);save('تعديل خزان',o.name)}else{o.id=uid();o.qty=N('tq');db.tanks.push(o);save('إضافة خزان',o.name)}})}\nfunction dipTank(id){const t=byId(db.tanks,id);modal('قياس يدوي — '+esc(t.name),`<p>الرصيد الدفتري الحالي: <b class=\"num\">${fmt(t.qty)}</b> لتر</p><div class=\"row\">${fl('الكمية المقاسة فعلياً (لتر)','dq','')}</div><label style=\"display:flex;gap:6px;align-items:center;margin-top:8px\"><input type=\"checkbox\" id=\"dadj\" checked> تعديل رصيد الخزان حسب القياس</label>`,()=>{\n  need(V('dq')!=='','أدخل القياس');const real=N('dq');const d={id:uid(),date:today(),time:nowT(),tankId:id,book:t.qty,real,diff:r2(real-t.qty),adj:$('#dadj').checked,by:me.name};db.dips.push(d);if(d.adj)t.qty=real;save('قياس خزان',`${t.name}: دفتري ${fmt(d.book)} فعلي ${fmt(real)} فرق ${fmt(d.diff)}`)})}\nfunction editDisp(id){if(!db.tanks.length){alert('أضف الخزانات أولاً');return}const d=id?byId(db.disps,id):{name:'المضخة '+(db.disps.length+1)};\n const ms=id?dispMeters(d):[];if(ms.some(m=>pumpShift(m.id))){alert('المضخة داخل شفت مفتوح — أغلق الشفت أولاً');return}\n const get=k=>ms.find(m=>m.side===k)||{tankId:(ms[0]||{}).tankId||db.tanks[0].id,meter:0,active:true};\n const tk=db.tanks.map(t=>[t.id,t.name+' — '+fuelOf(t.fuelId).name]);\n modal(id?'تعديل مضخة':'مضخة جديدة',`<div class=\"row\">${fi('اسم/رقم المضخة','pn',d.name)}${fs('المجموعة','pln',db.settings.lanes.map(l=>[l.k,l.k]),d.lane||db.settings.lanes[0].k)}</div>`+['R','L'].map(k=>{const m=get(k);return`<h4 style=\"margin:12px 0 6px\">العداد ${SIDE[k]}</h4><div class=\"row\">${fs('الخزان المرتبط','pt'+k,tk,m.tankId)}${fl('قراءة العداد الحالية','pm'+k,m.meter)}${fs('الحالة','pa'+k,[['1','يعمل'],['0','متوقف']],m.active!==false?'1':'0')}</div>`}).join('')+\n `<p style=\"color:var(--mut);font-size:12.5px\">كل عداد يرتبط بخزان (ونوع الوقود يتبع الخزان). إذا المضخة بيها عداد واحد خلّي الثاني «متوقف».</p>`,()=>{\n  need(V('pn'),'أدخل اسم المضخة');const vals=['R','L'].map(k=>{const t=byId(db.tanks,V('pt'+k));need(t,'اختر الخزان');return{k,t,meter:N('pm'+k),active:V('pa'+k)==='1'}});\n  if(!id){d.id=uid();db.disps.push(d)}d.name=V('pn');d.lane=V('pln');\n  vals.forEach(v=>{let m=ms.find(x=>x.side===v.k);if(!m){m={id:uid(),dispId:d.id,side:v.k};db.pumps.push(m)}Object.assign(m,{name:d.name+' — '+SIDE[v.k],tankId:v.t.id,fuelId:v.t.fuelId,meter:v.meter,active:v.active})});\n  save(id?'تعديل مضخة':'إضافة مضخة',`${d.name}: يمين ${fmt(vals[0].meter)} • يسار ${fmt(vals[1].meter)}`)})}\nfunction editFuel(id){const x=id?byId(db.fuels,id):{name:'',price:'',cost:'',color:'#0ea5e9'};\n modal(id?'تعديل نوع وقود':'نوع وقود جديد',`<div class=\"row\">${fi('الاسم','fn',x.name)}${fi('سعر بيع اللتر','fp',x.price,'number')}${fi('كلفة اللتر (تتحدث تلقائياً مع الشراء)','fc',x.cost,'number')}${fi('اللون','fco',x.color,'color')}</div><p style=\"color:var(--mut);font-size:12.5px\">تغيير السعر يطبق على المبيعات الجديدة والشفتات الجديدة فقط.</p>`,()=>{\n  need(V('fn'),'أدخل الاسم');const o={name:V('fn'),price:N('fp'),cost:N('fc'),color:V('fco')};if(id){const old=x.price;Object.assign(x,o);save('تعديل وقود',`${o.name}: السعر ${fmt(old)} ← ${fmt(o.price)}`)}else{o.id=uid();db.fuels.push(o);save('إضافة نوع وقود',o.name)}\n  db.pumps.forEach(p=>{const t=byId(db.tanks,p.tankId);if(t)p.fuelId=t.fuelId})})}\n\n/* ================= المخزون (زيوت ومواد) ================= */\nP.stock=()=>{const t=tab('skt','items');let b='';\n if(t==='items')b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn g\" onclick=\"editItem()\">${ic('plus',18)} مادة جديدة</button><button class=\"btn\" onclick=\"stockMove('out')\">بيع مادة</button><button class=\"btn o\" onclick=\"stockMove('in')\">شراء / إدخال مادة</button></div>`+\n  tbl(['المادة','الوحدة','الكمية','سعر البيع','الكلفة','قيمة المخزون',''],db.items.map(i=>[esc(i.name),esc(i.unit||''),`<span class=\"num ${i.min>0&&i.qty<=i.min?'neg':''}\">${fmt(i.qty)}</span>`,money(i.price),money(i.cost),money(i.qty*i.cost),`<button class=\"btn sm\" onclick=\"editItem('${i.id}')\">تعديل</button>`]),['المجموع','','','','',money(db.items.reduce((a,i)=>a+i.qty*i.cost,0)),'']);\n if(t==='moves'){const m=st.skm||month();const l=db.moves.filter(x=>month(x.date)===m).slice().reverse();b=`<div style=\"max-width:200px;margin-bottom:10px\">${fi('الشهر','skmm',m,'month','onchange=\"st.skm=this.value;render()\"')}</div>`+\n  tbl(['التاريخ','النوع','المادة','الكمية','السعر','المبلغ','الطرف','الدفع',''],l.map(x=>[x.date,x.type==='out'?'<span class=\"tag tg\">بيع</span>':'<span class=\"tag tb\">شراء</span>',esc(nm(db.items,x.itemId)),`<span class=\"num\">${fmt(x.qty)}</span>`,money(x.price),money(x.amount),esc(x.type==='out'?nm(db.customers,x.customerId,'زبون نقدي'):nm(db.suppliers,x.supplierId,'—')),x.pay==='credit'?'آجل':'نقد',`<button class=\"btn sm s\" onclick=\"printMove('${x.id}')\">${ic('print',14)}</button> `+delBtn('delMove',x.id)]))}\n return head('المخزون (زيوت ومواد)','box')+tabs('skt',[['items','المواد'],['moves','حركة المواد']])+`<div class=\"box\">${b}</div>`};\nfunction editItem(id){const x=id?byId(db.items,id):{name:'',unit:'قطعة',qty:0,price:'',cost:'',min:0};\n modal(id?'تعديل مادة':'مادة جديدة',`<div class=\"row\">${fi('اسم المادة','in',x.name)}${fi('الوحدة','iu',x.unit)}${fi('سعر البيع','ip',x.price,'number')}${fi('الكلفة','ic',x.cost,'number')}${id?'':fi('الكمية الافتتاحية','iq',x.qty,'number')}${fi('حد التنبيه','imin',x.min,'number')}</div>`,()=>{\n  need(V('in'),'أدخل الاسم');const o={name:V('in'),unit:V('iu'),price:N('ip'),cost:N('ic'),min:N('imin')};if(id){Object.assign(x,o);save('تعديل مادة',o.name)}else{o.id=uid();o.qty=N('iq');db.items.push(o);save('إضافة مادة',o.name)}})}\nfunction mvCalc(t,init){const i=byId(db.items,V('mi'));if(i&&(init||document.activeElement.id==='mi'||V('mp')===''))setNF('mp',t==='out'?i.price:i.cost);$('#mt').value=fmt(N('mq')*N('mp'))}\nfunction stockMove(t){if(!db.items.length){alert('أضف المواد أولاً');return}const out=t==='out';\n modal(out?'بيع مادة':'شراء / إدخال مادة',`<div class=\"row\">${fi('التاريخ','md',today(),'date')}${fs('المادة','mi',db.items.map(i=>[i.id,i.name+' (متوفر '+fmt(i.qty)+')']),'',`onchange=\"mvCalc('${t}')\"`)}${fi('الكمية','mq','1','number',`oninput=\"mvCalc('${t}')\"`)}${fi(out?'سعر البيع':'سعر الشراء','mp','','number',`oninput=\"mvCalc('${t}')\"`)}<div class=\"f\"><label>المبلغ</label><input id=\"mt\" disabled></div></div>\n <div class=\"row\">${out?fs('الدفع','mpay',[['cash','نقد'],['credit','آجل على عميل']])+fs('العميل (للآجل)','mc',opt(db.customers.filter(c=>!c.deleted),'—')):fs('المورد','ms',opt(db.suppliers,'— بدون مورد —'))+fi('المدفوع الآن','mpd','0','number')}${fi('ملاحظات','mn')}</div>`,()=>{\n  const i=byId(db.items,V('mi')),q=N('mq'),p=N('mp');need(i&&q>0,'أدخل الكمية');\n  const m={id:uid(),date:V('md')||today(),type:t,itemId:i.id,qty:q,price:p,amount:r2(q*p),cost:i.cost,note:V('mn'),by:me.name};\n  if(out){if(q>i.qty&&!confirm('الكمية أكثر من المتوفر. متابعة؟'))return false;m.pay=V('mpay');m.customerId=m.pay==='credit'?V('mc'):'';need(m.pay!=='credit'||m.customerId,'اختر العميل');i.qty=r2(i.qty-q);\n   if(m.pay==='cash')addCash({type:'in',kind:'stock',amount:m.amount,ref:m.id,date:m.date,note:'بيع '+i.name+' × '+fmt(q)})}\n  else{m.supplierId=V('ms');m.pay='cash';const tot=i.qty+q;i.cost=r2((Math.max(0,i.qty)*i.cost+q*p)/(tot||1));i.qty=r2(tot);const pd=N('mpd');\n   if(m.supplierId&&pd>0)addCash({type:'out',kind:'sup',amount:pd,supplierId:m.supplierId,ref:m.id,date:m.date,note:'شراء '+i.name});\n   if(!m.supplierId&&m.amount>0)addCash({type:'out',kind:'oout',amount:m.amount,ref:m.id,date:m.date,note:'شراء '+i.name})}\n  m.no=db.settings.moveNo=(+db.settings.moveNo||0)+1;db.moves.push(m);save(out?'بيع مادة':'شراء مادة',`${i.name} × ${fmt(q)} = ${fmt(m.amount)}`);if(MPRINT){MPRINT=false;setTimeout(()=>printMove(m.id),80)}},'حفظ',`<button class=\"btn\" onclick=\"MPRINT=true;mOk()\">${ic('print',18)} حفظ وطباعة</button>`);mvCalc(t,1)}\nfunction printMove(id){const m=byId(db.moves,id);if(!m)return;const i=byId(db.items,m.itemId)||{name:'-',unit:''};const out=m.type==='out';const S=db.settings;\n const party=out?(m.customerId?nm(db.customers,m.customerId):'زبون نقدي'):(m.supplierId?nm(db.suppliers,m.supplierId):'—');\n const html=`<style>@page{margin:6mm}.rc{max-width:330px;margin:0 auto;font-size:13px}.rc h2{text-align:center;margin:0}.rc .c{text-align:center}.rc .t{font-size:16px;font-weight:900;text-align:center;border:1.5px solid #000;border-radius:6px;padding:3px;margin:8px 0}.rc table{margin:6px 0}.rc .big{font-size:20px;font-weight:900}.rc .ln{border-top:1px dashed #000;margin:8px 0}</style>\n <div class=\"rc\"><h2>${esc(S.name)}</h2><div class=\"c\">${esc(S.address||'')} ${esc(S.phone||'')}</div>\n <div class=\"t\">${out?'وصل بيع مواد':'وصل شراء / إدخال مواد'} رقم ${m.no||''}</div>\n <div>التاريخ: <b>${m.date}</b> &nbsp; الوقت: <b>${t12(nowT())}</b></div><div>${out?'العميل':'المورد'}: <b>${esc(party)}</b></div>\n <table><tr><th>المادة</th><th>الكمية</th><th>السعر</th><th>المبلغ</th></tr><tr><td>${esc(i.name)}</td><td class=\"num\">${fmt(m.qty)} ${esc(i.unit||'')}</td><td class=\"num\">${fmt(m.price)}</td><td class=\"num\">${fmt(m.amount)}</td></tr></table>\n <div class=\"ln\"></div><div>المجموع: <span class=\"big num\">${fmt(m.amount)}</span> ${cur()}</div><div>طريقة الدفع: <b>${out?(m.pay==='credit'?'آجل (دين)':'نقد'):'—'}</b></div>\n ${m.note?`<div>ملاحظات: ${esc(m.note)}</div>`:''}<div>بواسطة: ${esc(m.by||'')}</div><div class=\"ln\"></div>\n <div class=\"c\" style=\"margin-top:14px\">التوقيع: ....................</div></div>`;\n printHTML(out?'وصل بيع مواد':'وصل شراء مواد',html,true,'moves')}\nfunction delMove(id){const m=byId(db.moves,id);if(!confirm('حذف الحركة وعكس أثرها على الكمية؟'))return;const i=byId(db.items,m.itemId);if(i)i.qty=r2(i.qty+(m.type==='out'?m.qty:-m.qty));db.cash=db.cash.filter(c=>c.ref!==id);db.moves=db.moves.filter(x=>x.id!==id);save('حذف حركة مادة',nm(db.items,m.itemId)+' × '+fmt(m.qty));render()}\n\n/* ================= العملاء والديون ================= */\nP.customers=()=>{const q=(st.cq||'').toLowerCase();const l=db.customers.filter(c=>!c.deleted&&(!q||(c.name+' '+(c.phone||'')).toLowerCase().includes(q)));const tot=db.customers.filter(c=>!c.deleted).reduce((a,c)=>a+custBal(c),0);\n return head('حسابات العملاء والديون','users',`<button class=\"btn g\" onclick=\"editCust()\">${ic('plus',18)} عميل جديد</button>`)+\n `<div class=\"box\"><div class=\"row\" style=\"margin-bottom:10px\"><div style=\"max-width:280px\">${fi('بحث','cqq',st.cq||'','text','onchange=\"st.cq=this.value;render()\"')}</div><div class=\"sum\" style=\"margin:0;flex:1\"><div><span>مجموع الديون المستحقة على العملاء</span><b>${fmt(tot)}</b></div></div></div>\n ${tbl(['العميل','الهاتف','سقف الدين','الرصيد المستحق',''],l.map(c=>{const b=custBal(c);return[esc(c.name),esc(c.phone||''),money(c.limit||0),`<span class=\"num ${b>0?'neg':''}\">${fmt(b)}</span>${c.limit>0&&b>c.limit?' <span class=\"tag tr\">تجاوز السقف</span>':''}`,`<button class=\"btn sm g\" onclick=\"custPay('${c.id}')\">قبض</button> <button class=\"btn sm o\" onclick=\"custDebt('${c.id}')\">دين يدوي</button> <button class=\"btn sm s\" onclick=\"custStmt('${c.id}')\">كشف حساب</button> <button class=\"btn sm\" onclick=\"editCust('${c.id}')\">تعديل</button>${can('del')?` <button class=\"btn sm r\" onclick=\"delCust('${c.id}')\">حذف</button>`:''}`]}))}</div>`};\nfunction delCust(id){const c=byId(db.customers,id);if(!c)return;const b=custBal(c);\n const n=db.sales.filter(s=>s.customerId===id).length+db.moves.filter(m=>m.customerId===id).length+db.debts.filter(d=>d.customerId===id).length+db.cash.filter(x=>x.customerId===id).length;\n let msg=`حذف العميل «${c.name}»؟`;if(Math.abs(b)>0.001)msg+=`\\n\\n⚠ رصيده الحالي ${fmt(b)} ${cur()} ${b>0?'(دين عليه ما مسدد)':'(إله رصيد عندكم)'}.`;if(n)msg+=`\\nعنده ${n} حركة سابقة — تبقى محفوظة بالتقارير وكشوف الحساب.`;\n if(!confirm(msg))return;if(Math.abs(b)>0.001&&prompt('للتأكيد اكتب: حذف')!=='حذف')return;\n c.deleted=true;c.deletedAt=today();save('حذف عميل',`${c.name} — رصيد ${fmt(b)}`);render()}\nfunction editCust(id){const x=id?byId(db.customers,id):{name:'',phone:'',opening:0,limit:0,note:''};\n modal(id?'تعديل عميل':'عميل جديد',`<div class=\"row\">${fi('الاسم / الشركة','cn',x.name)}${fi('الهاتف','cp',x.phone)}${fi('رصيد افتتاحي (دين سابق)','co',x.opening,'number')}${fi('سقف الدين (0 = بلا حد)','cl',x.limit,'number')}${fi('ملاحظات','cno',x.note)}</div>`,()=>{\n  need(V('cn'),'أدخل الاسم');const o={name:V('cn'),phone:V('cp'),opening:N('co'),limit:N('cl'),note:V('cno')};if(id){Object.assign(x,o);save('تعديل عميل',o.name)}else{o.id=uid();db.customers.push(o);save('إضافة عميل',o.name)}})}\nfunction custPay(id){const c=byId(db.customers,id);modal('قبض من '+esc(c.name),`<p>الرصيد المستحق: <b class=\"num\">${fmt(custBal(c))}</b></p><div class=\"row\">${fi('التاريخ','pd',today(),'date')}${fi('المبلغ','pa','','number')}${fi('ملاحظات','pn')}</div>`,()=>{\n  const a=N('pa');need(a>0,'أدخل المبلغ');addCash({type:'in',kind:'cust',amount:a,customerId:id,date:V('pd')||today(),note:V('pn')||'تسديد دين — '+c.name});save('قبض من عميل',`${c.name}: ${fmt(a)}`)})}\nfunction custDebt(id){const c=byId(db.customers,id);modal('تسجيل دين يدوي على '+esc(c.name),`<div class=\"row\">${fi('التاريخ','dd',today(),'date')}${fi('المبلغ','da','','number')}${fi('البيان','dn')}</div>`,()=>{\n  const a=N('da');need(a>0,'أدخل المبلغ');need(V('dn'),'اكتب البيان');db.debts.push({id:uid(),customerId:id,date:V('dd')||today(),amount:a,note:V('dn'),by:me.name});save('دين يدوي على عميل',`${c.name}: ${fmt(a)} — ${V('dn')}`)})}\nfunction custStmt(id){const c=byId(db.customers,id);const e=[];\n db.sales.forEach(s=>{if(s.pay==='credit'&&s.customerId===id)e.push([s.date,s.time,`${fuelOf(s.fuelId).name} ${fmt(s.liters)} لتر`,s.amount,0])});\n db.moves.forEach(m=>{if(m.type==='out'&&m.pay==='credit'&&m.customerId===id)e.push([m.date,'',`${nm(db.items,m.itemId)} × ${fmt(m.qty)}`,m.amount,0])});\n db.debts.forEach(d=>{if(d.customerId===id)e.push([d.date,'',d.note,d.amount,0])});\n db.cash.forEach(x=>{if(x.kind==='cust'&&x.customerId===id)e.push([x.date,x.time,x.note||'تسديد',0,x.amount])});\n e.sort((a,b)=>(a[0]+a[1]).localeCompare(b[0]+b[1]));let bal=+c.opening||0;\n const rows=[['','','رصيد افتتاحي','','',`<span class=\"num\">${fmt(bal)}</span>`]].concat(e.map(x=>{bal+=x[3]-x[4];return[x[0],t12(x[1]),esc(x[2]),x[3]?money(x[3]):'',x[4]?money(x[4]):'',`<span class=\"num\">${fmt(bal)}</span>`]}));\n modal('كشف حساب — '+esc(c.name),`<div id=\"cst\"><p><b>العميل:</b> ${esc(c.name)} ${esc(c.phone||'')}</p>${tbl(['التاريخ','الوقت','البيان','مدين (عليه)','دائن (دفع)','الرصيد'],rows)}<p><b>الرصيد النهائي المستحق: <span class=\"num\">${fmt(bal)}</span> ${cur()}</b></p></div><button class=\"btn s\" onclick=\"printBox('cst','كشف حساب عميل')\">${ic('print',18)} طباعة</button>`)}\n\n/* ================= الموردين ================= */\nP.suppliers=()=>{const tot=db.suppliers.reduce((a,s)=>a+supBal(s),0);\n return `<div class=\"row\" style=\"justify-content:flex-end;margin-bottom:10px\"><button class=\"btn g\" onclick=\"editSup()\">${ic('plus',18)} مورد جديد</button></div>`+\n `<div class=\"box\"><div class=\"sum\"><div><span>مجموع المستحق للموردين</span><b>${fmt(tot)}</b></div></div>\n ${tbl(['المورد','الهاتف','نوع التجهيز','المستحق له',''],db.suppliers.map(s=>{const b=supBal(s);return[esc(s.name),esc(s.phone||''),esc(s.kind||''),`<span class=\"num ${b>0?'neg':''}\">${fmt(b)}</span>`,`<button class=\"btn sm g\" onclick=\"supPay('${s.id}')\">دفع</button> <button class=\"btn sm s\" onclick=\"supStmt('${s.id}')\">كشف حساب</button> <button class=\"btn sm\" onclick=\"editSup('${s.id}')\">تعديل</button>`]}))}</div>`};\nfunction editSup(id){const x=id?byId(db.suppliers,id):{name:'',phone:'',kind:'وقود',opening:0};\n modal(id?'تعديل مورد':'مورد جديد',`<div class=\"row\">${fi('الاسم / الشركة','sn',x.name)}${fi('الهاتف','sp2',x.phone)}${fi('نوع التجهيز','sk',x.kind)}${fi('رصيد افتتاحي (مستحق له)','so',x.opening,'number')}</div>`,()=>{\n  need(V('sn'),'أدخل الاسم');const o={name:V('sn'),phone:V('sp2'),kind:V('sk'),opening:N('so')};if(id){Object.assign(x,o);save('تعديل مورد',o.name)}else{o.id=uid();db.suppliers.push(o);save('إضافة مورد',o.name)}})}\nfunction supPay(id){const s=byId(db.suppliers,id);modal('دفع إلى '+esc(s.name),`<p>المستحق له: <b class=\"num\">${fmt(supBal(s))}</b> — رصيد الصندوق: <b class=\"num\">${fmt(cashBal())}</b></p><div class=\"row\">${fi('التاريخ','pd',today(),'date')}${fi('المبلغ','pa','','number')}${fi('ملاحظات','pn')}</div>`,()=>{\n  const a=N('pa');need(a>0,'أدخل المبلغ');const c=addCash({type:'out',kind:'sup',amount:a,supplierId:id,date:V('pd')||today(),note:V('pn')||'دفعة إلى '+s.name});c.vno=db.settings.payNo=(+db.settings.payNo||0)+1;save('دفع لمورد',`${s.name}: ${fmt(a)}`);if(MPRINT){MPRINT=false;setTimeout(()=>printPayV(c.id),80)}},'حفظ',`<button class=\"btn\" onclick=\"MPRINT=true;mOk()\">${ic('print',18)} حفظ وطباعة وصل</button>`)}\nfunction supStmt(id){const s=byId(db.suppliers,id);const e=[];\n db.receipts.forEach(r=>{if(r.supplierId===id)e.push([r.date,`استلام ${fuelOf(r.fuelId).name} ${fmt(r.liters)} لتر — وصل ${r.inv||''}`,r.total,0])});\n db.moves.forEach(m=>{if(m.type==='in'&&m.supplierId===id)e.push([m.date,`${nm(db.items,m.itemId)} × ${fmt(m.qty)}`,m.amount,0])});\n db.cash.forEach(x=>{if(x.type==='out'&&x.supplierId===id)e.push([x.date,x.note||'دفعة',0,x.amount])});\n e.sort((a,b)=>a[0].localeCompare(b[0]));let bal=+s.opening||0;\n const rows=[['','رصيد افتتاحي','','',`<span class=\"num\">${fmt(bal)}</span>`]].concat(e.map(x=>{bal+=x[2]-x[3];return[x[0],esc(x[1]),x[2]?money(x[2]):'',x[3]?money(x[3]):'',`<span class=\"num\">${fmt(bal)}</span>`]}));\n modal('كشف حساب — '+esc(s.name),`<div id=\"sst\"><p><b>المورد:</b> ${esc(s.name)}</p>${tbl(['التاريخ','البيان','له (مشتريات)','مدفوع','الرصيد'],rows)}<p><b>المستحق له: <span class=\"num\">${fmt(bal)}</span> ${cur()}</b></p></div><button class=\"btn s\" onclick=\"printBox('sst','كشف حساب مورد')\">${ic('print',18)} طباعة</button>`)}\n\n/* ================= الصندوق ================= */\nP.cash=()=>{const f=st.cf||today().slice(0,8)+'01',t=st.ct||today();const l=db.cash.filter(c=>c.date>=f&&c.date<=t).slice().sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time));\n const ti=l.filter(c=>c.type==='in').reduce((a,c)=>a+c.amount,0),to=l.filter(c=>c.type==='out').reduce((a,c)=>a+c.amount,0);\n const manual=['cap','dep','wd','oin','oout'];\n return head('الصندوق والحسابات','money',`<button class=\"btn g\" onclick=\"cashMove('in')\">${ic('plus',18)} إدخال للصندوق</button><button class=\"btn r\" onclick=\"cashMove('out')\">سحب من الصندوق</button>`)+\n `<div class=\"sum\"><div><span>رصيد الصندوق الحالي</span><b>${fmt(cashBal())}</b></div><div><span>الوارد للفترة</span><b class=\"pos\">${fmt(ti)}</b></div><div><span>الصادر للفترة</span><b class=\"neg\">${fmt(to)}</b></div><div><span>صافي الفترة</span><b>${fmt(ti-to)}</b></div></div>\n <div class=\"box\"><div class=\"row\" style=\"margin-bottom:10px\">${fi('من','cff',f,'date','onchange=\"st.cf=this.value;render()\"')}${fi('إلى','ctt',t,'date','onchange=\"st.ct=this.value;render()\"')}<button class=\"btn s\" onclick=\"printBox('cashT','حركة الصندوق')\">${ic('print',18)} طباعة</button></div>\n <div id=\"cashT\">${tbl(['التاريخ','الوقت','النوع','البيان','وارد','صادر','بواسطة',''],l.map(c=>[c.date,t12(c.time),`<span class=\"tag ${c.type==='in'?'tg':'tr'}\">${KIND[c.kind]||c.kind}</span>${c.cat?' '+esc(c.cat):''}`,esc(c.note||''),c.type==='in'?money(c.amount):'',c.type==='out'?money(c.amount):'',esc(c.by||''),(c.vno?`<button class=\"btn sm s\" onclick=\"printPayV('${c.id}')\" title=\"طباعة الوصل\">${ic('print',14)}</button> `:'')+(manual.concat(['exp','rev','cust','sup']).includes(c.kind)&&!c.ref?delBtn('delCash',c.id):'')]),['','','','المجموع',money(ti),money(to),'',''])}</div></div>`};\nfunction cashMove(t){const k=t==='in'?[['cap','رأس مال'],['dep','إيداع'],['oin','وارد آخر']]:[['wd','سحب (للمالك)'],['oout','صادر آخر']];\n modal(t==='in'?'إدخال مبلغ للصندوق':'سحب مبلغ من الصندوق',`<div class=\"row\">${fi('التاريخ','xd',today(),'date')}${fs('النوع','xk',k)}${fi('المبلغ','xa','','number')}${fi('البيان','xn')}</div>`,()=>{\n  const a=N('xa');need(a>0,'أدخل المبلغ');addCash({type:t,kind:V('xk'),amount:a,date:V('xd')||today(),note:V('xn')});save(t==='in'?'إدخال للصندوق':'سحب من الصندوق',`${KIND[V('xk')]}: ${fmt(a)} ${V('xn')}`)})}\nfunction delCash(id){const c=byId(db.cash,id);if(!confirm('حذف الحركة؟'))return;db.cash=db.cash.filter(x=>x.id!==id);save('حذف حركة صندوق',`${KIND[c.kind]} ${fmt(c.amount)} ${c.note||''}`);render()}\n\n/* ================= المصاريف والإيرادات ================= */\nP.exprev=()=>{const m=st.em||month();const l=db.cash.filter(c=>(c.kind==='exp'||c.kind==='rev')&&month(c.date)===m).slice().reverse();\n const te=l.filter(c=>c.kind==='exp').reduce((a,c)=>a+c.amount,0),tr=l.filter(c=>c.kind==='rev').reduce((a,c)=>a+c.amount,0);\n const bc={};l.filter(c=>c.kind==='exp').forEach(c=>bc[c.cat]=(bc[c.cat]||0)+c.amount);\n return head('المصاريف والإيرادات','bag',`<button class=\"btn r\" onclick=\"expRev('exp')\">${ic('plus',18)} مصروف</button><button class=\"btn g\" onclick=\"expRev('rev')\">${ic('plus',18)} إيراد</button>`)+\n `<div class=\"sum\"><div><span>مصاريف الشهر</span><b class=\"neg\">${fmt(te)}</b></div><div><span>إيرادات الشهر</span><b class=\"pos\">${fmt(tr)}</b></div>${Object.entries(bc).map(([k,v])=>`<div><span>${esc(k)}</span><b>${fmt(v)}</b></div>`).join('')}</div>\n <div class=\"box\"><div style=\"max-width:200px;margin-bottom:10px\">${fi('الشهر','emm',m,'month','onchange=\"st.em=this.value;render()\"')}</div>${tbl(['التاريخ','النوع','الفئة','البيان','المبلغ','بواسطة',''],l.map(c=>[c.date,c.kind==='exp'?'<span class=\"tag tr\">مصروف</span>':'<span class=\"tag tg\">إيراد</span>',esc(c.cat||''),esc(c.note||''),money(c.amount),esc(c.by||''),delBtn('delCash',c.id)]))}</div>`};\nfunction expRev(k){const cats=k==='exp'?db.settings.expCats:db.settings.revCats;\n modal(k==='exp'?'تسجيل مصروف':'تسجيل إيراد',`<div class=\"row\">${fi('التاريخ','ed',today(),'date')}${fs('الفئة','ec',cats.map(c=>[c,c]))}${fi('المبلغ','ea','','number')}${fi('البيان','en')}</div>`,()=>{\n  const a=N('ea');need(a>0,'أدخل المبلغ');addCash({type:k==='exp'?'out':'in',kind:k,cat:V('ec'),amount:a,date:V('ed')||today(),note:V('en')});save(k==='exp'?'تسجيل مصروف':'تسجيل إيراد',`${V('ec')}: ${fmt(a)} ${V('en')}`)})}\n\n/* ================= الموظفون والرواتب ================= */\nP.employees=()=>{const t=tab('et','emps');let b='';\n if(t==='emps')b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn g\" onclick=\"editEmp()\">${ic('plus',18)} موظف جديد</button></div>`+tbl(['الاسم','العمل','الهاتف','الراتب','سلف غير مستقطعة','الحالة',''],db.employees.map(e=>[esc(e.name),esc(e.job||''),esc(e.phone||''),money(e.salary),`<span class=\"num\">${fmt(pendAdv(e.id))}</span>`,e.active!==false?'<span class=\"tag tg\">فعال</span>':'<span class=\"tag tx\">متوقف</span>',`<button class=\"btn sm o\" onclick=\"addAdv('${e.id}')\">سلفة</button> <button class=\"btn sm\" onclick=\"editEmp('${e.id}')\">تعديل</button>`]));\n if(t==='adv')b=tbl(['التاريخ','الموظف','المبلغ','البيان','الحالة',''],db.advances.slice().reverse().map(a=>[a.date,esc(nm(db.employees,a.empId)),money(a.amount),esc(a.note||''),a.payrollId?'<span class=\"tag tg\">مستقطعة</span>':'<span class=\"tag ty\">قائمة</span>',!a.payrollId?delBtn('delAdv',a.id):'']));\n if(t==='pay'){const m=st.pym||month();b=`<div style=\"max-width:200px;margin-bottom:10px\">${fi('الشهر','pymm',m,'month','onchange=\"st.pym=this.value;render()\"')}</div>`+\n  tbl(['الموظف','الراتب','السلف','مكافأة','خصم','الصافي','الحالة',''],db.employees.filter(e=>e.active!==false||db.payroll.some(p=>p.empId===e.id&&p.month===m)).map(e=>{const p=db.payroll.find(x=>x.empId===e.id&&x.month===m);\n   return p?[esc(e.name),money(p.salary),money(p.adv),money(p.bonus),money(p.ded),`<b>${money(p.net)}</b>`,`<span class=\"tag tg\">مصروف ${p.date}</span>`,'']:[esc(e.name),money(e.salary),`<span class=\"num\">${fmt(pendAdv(e.id))}</span>`,'','','','<span class=\"tag ty\">غير مصروف</span>',`<button class=\"btn sm g\" onclick=\"paySal('${e.id}','${m}')\">صرف الراتب</button>`]}))}\n return head('الموظفون والرواتب','user')+tabs('et',[['emps','الموظفون'],['adv','السلف'],['pay','الرواتب']])+`<div class=\"box\">${b}</div>`};\nfunction editEmp(id){const x=id?byId(db.employees,id):{name:'',job:'عامل مضخة',phone:'',salary:'',active:true,start:today()};\n modal(id?'تعديل موظف':'موظف جديد',`<div class=\"row\">${fi('الاسم','en2',x.name)}${fi('العمل','ej',x.job)}${fi('الهاتف','ep',x.phone)}${fi('الراتب الشهري','es',x.salary,'number')}${fi('تاريخ المباشرة','est',x.start,'date')}${fs('الحالة','ea2',[['1','فعال'],['0','متوقف']],x.active!==false?'1':'0')}</div>`,()=>{\n  need(V('en2'),'أدخل الاسم');const o={name:V('en2'),job:V('ej'),phone:V('ep'),salary:N('es'),start:V('est'),active:V('ea2')==='1'};if(id){Object.assign(x,o);save('تعديل موظف',o.name)}else{o.id=uid();db.employees.push(o);save('إضافة موظف',o.name)}})}\nfunction addAdv(id){const e=byId(db.employees,id);modal('سلفة لـ '+esc(e.name),`<p>سلف قائمة: <b class=\"num\">${fmt(pendAdv(id))}</b></p><div class=\"row\">${fi('التاريخ','ad',today(),'date')}${fi('المبلغ','aa','','number')}${fi('البيان','an')}</div>`,()=>{\n  const a=N('aa');need(a>0,'أدخل المبلغ');const v={id:uid(),empId:id,date:V('ad')||today(),amount:a,note:V('an')};const c=addCash({type:'out',kind:'adv',amount:a,empId:id,date:v.date,note:'سلفة — '+e.name+' '+v.note});v.cashId=c.id;db.advances.push(v);save('سلفة موظف',`${e.name}: ${fmt(a)}`)})}\nfunction delAdv(id){const a=byId(db.advances,id);if(!confirm('حذف السلفة؟'))return;if(a.cashId)db.cash=db.cash.filter(c=>c.id!==a.cashId);db.advances=db.advances.filter(x=>x.id!==id);save('حذف سلفة',`${nm(db.employees,a.empId)}: ${fmt(a.amount)}`);render()}\nfunction salCalc(){$('#snet').value=fmt(N('ss')-N('sad')+N('sb')-N('sd'))}\nfunction paySal(id,m){const e=byId(db.employees,id);const adv=pendAdv(id);\n modal(`صرف راتب ${esc(e.name)} — ${m}`,`<div class=\"row\">${fi('الراتب','ss',e.salary,'number','oninput=\"salCalc()\"')}${fi('السلف المستقطعة','sad',adv,'number','oninput=\"salCalc()\"')}${fi('مكافأة','sb','0','number','oninput=\"salCalc()\"')}${fi('خصم','sd','0','number','oninput=\"salCalc()\"')}<div class=\"f\"><label>الصافي</label><input id=\"snet\" disabled></div></div><p style=\"color:var(--mut);font-size:12.5px\">السلف القائمة: ${fmt(adv)}. إذا استقطعت أقل منها، يبقى الباقي سلفة على الموظف.</p>`,()=>{\n  const sa=N('sad');need(sa<=adv+0.001,'السلف المستقطعة أكثر من السلف القائمة');const net=r2(N('ss')-sa+N('sb')-N('sd'));need(net>=0,'الصافي سالب');\n  const p={id:uid(),empId:id,month:m,salary:N('ss'),adv:sa,bonus:N('sb'),ded:N('sd'),net,date:today(),by:me.name};\n  let left=sa;db.advances.filter(a=>a.empId===id&&!a.payrollId).sort((a,b)=>a.date.localeCompare(b.date)).forEach(a=>{if(left<=0.001)return;if(a.amount<=left+0.001){a.payrollId=p.id;left=r2(left-a.amount)}else{db.advances.push({id:uid(),empId:id,date:a.date,amount:r2(a.amount-left),note:(a.note||'')+' (متبقي)',cashId:null});a.amount=left;a.payrollId=p.id;left=0}});\n  db.payroll.push(p);if(net>0)addCash({type:'out',kind:'sal',amount:net,empId:id,ref:p.id,note:`راتب ${m} — ${e.name}`});save('صرف راتب',`${e.name} ${m}: صافي ${fmt(net)}`)},'صرف');salCalc()}\n\n/* ================= التقارير ================= */\nfunction fuelSum(sales){const g={};sales.forEach(s=>{const k=s.fuelId;g[k]=g[k]||{l:0,a:0,c:0,p:0};g[k].l+=s.liters;g[k].a+=s.amount;if(s.pay==='credit')g[k].c+=s.amount;g[k].p+=s.amount-s.liters*(s.cost||0)});return g}\nP.reports=()=>{const t=tab('rt','day');let b='';\n if(t==='day'){const d=st.rd||today();const sl=salesOn(d),g=fuelSum(sl),cs=db.cash.filter(c=>c.date===d);const bk={};cs.forEach(c=>{const k=c.type+'|'+(KIND[c.kind]||c.kind)+(c.cat?' — '+c.cat:'');bk[k]=(bk[k]||0)+c.amount});\n  const fr=Object.entries(g).map(([k,v])=>[esc(fuelOf(k).name),`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a),money(v.a-v.c),money(v.c),money(v.p)]);const T=Object.values(g).reduce((a,v)=>({l:a.l+v.l,a:a.a+v.a,c:a.c+v.c,p:a.p+v.p}),{l:0,a:0,c:0,p:0});\n  const stk=db.moves.filter(m=>m.type==='out'&&m.date===d);const rc=db.receipts.filter(r=>r.date===d);const sh=db.shifts.filter(s=>s.status==='closed'&&s.date===d);\n  b=`<div class=\"row\" style=\"margin-bottom:10px\"><div style=\"max-width:200px\">${fi('اليوم','rdd',d,'date','onchange=\"st.rd=this.value;render()\"')}</div><button class=\"btn s\" onclick=\"printBox('rep','التقرير اليومي ${d}')\">${ic('print',18)} طباعة</button></div><div id=\"rep\">\n  <h3>مبيعات الوقود — ${d} (${DAYS[new Date(d+'T12:00').getDay()]})</h3>${tbl(['الوقود','اللترات','المبلغ','نقد','آجل','الربح'],fr,['المجموع',`<span class=\"num\">${fmt(T.l)}</span>`,money(T.a),money(T.a-T.c),money(T.c),money(T.p)])}\n  <h3>مبيعات المواد</h3>${tbl(['المادة','الكمية','المبلغ'],stk.map(m=>[esc(nm(db.items,m.itemId)),`<span class=\"num\">${fmt(m.qty)}</span>`,money(m.amount)]))}\n  <h3>الشفتات</h3>${tbl(['رقم','العامل','المبيعات','المستلم','الفرق'],sh.map(s=>[s.no,esc(nm(db.employees,s.empId)),money(s.total),money(s.received),`<span class=\"num ${s.diff<0?'neg':''}\">${fmt(s.diff)}</span>`]))}\n  <h3>الوقود الوارد</h3>${tbl(['المورد','الخزان','اللترات','القيمة','الدفع','المدفوع من الصندوق','آجل'],rc.map(r=>[esc(nm(db.suppliers,r.supplierId)),esc(nm(db.tanks,r.tankId)),`<span class=\"num\">${fmt(r.liters)}</span>`,money(r.total),rpTag(r),money(r.paid),money(r.total-r.paid)]))}\n  <h3>حركة الصندوق</h3>${tbl(['البند','وارد','صادر'],Object.entries(bk).map(([k,v])=>{const[tp,n]=k.split('|');return[esc(n),tp==='in'?money(v):'',tp==='out'?money(v):'']}),['المجموع',money(cs.filter(c=>c.type==='in').reduce((a,c)=>a+c.amount,0)),money(cs.filter(c=>c.type==='out').reduce((a,c)=>a+c.amount,0))])}\n  <div class=\"sum\" style=\"margin-top:12px\"><div><span>صافي ربح اليوم</span><b>${fmt(dayProfit(d))}</b></div><div><span>رصيد الصندوق الحالي</span><b>${fmt(cashBal())}</b></div></div></div>`}\n if(t==='month'){const m=st.rm||month();const[y,mo]=m.split('-').map(Number);const nd=new Date(y,mo,0).getDate();const rows=[];const T=[0,0,0,0,0,0];\n  for(let i=1;i<=nd;i++){const d=m+'-'+String(i).padStart(2,'0');const sl=salesOn(d);const l=sl.reduce((a,s)=>a+s.liters,0),a=sl.reduce((x,s)=>x+s.amount,0)+db.moves.filter(x=>x.type==='out'&&x.date===d).reduce((q,x)=>q+x.amount,0);\n   const ex=db.cash.filter(c=>c.date===d&&c.kind==='exp').reduce((q,c)=>q+c.amount,0),rc=db.receipts.filter(r=>r.date===d).reduce((q,r)=>q+r.total,0),pr=dayProfit(d),cr=sl.filter(s=>s.pay==='credit').reduce((q,s)=>q+s.amount,0);\n   if(!l&&!a&&!ex&&!rc)continue;[l,a,cr,ex,rc,pr].forEach((v,j)=>T[j]+=v);rows.push([d,`<span class=\"num\">${fmt(l)}</span>`,money(a),money(cr),money(ex),money(rc),money(pr)])}\n  const g=fuelSum(db.sales.filter(s=>month(s.date)===m));const sal=db.payroll.filter(p=>p.month===m).reduce((a,p)=>a+p.net,0);\n  b=`<div class=\"row\" style=\"margin-bottom:10px\"><div style=\"max-width:200px\">${fi('الشهر','rmm',m,'month','onchange=\"st.rm=this.value;render()\"')}</div><button class=\"btn s\" onclick=\"printBox('rep','التقرير الشهري ${m}')\">${ic('print',18)} طباعة</button></div><div id=\"rep\">\n  <h3>الحركة اليومية — ${m}</h3>${tbl(['اليوم','اللترات','المبيعات','منها آجل','المصاريف','المشتريات','الربح'],rows,['المجموع',`<span class=\"num\">${fmt(T[0])}</span>`,money(T[1]),money(T[2]),money(T[3]),money(T[4]),money(T[5])])}\n  <h3>حسب نوع الوقود</h3>${tbl(['الوقود','اللترات','المبلغ','الربح'],Object.entries(g).map(([k,v])=>[esc(fuelOf(k).name),`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a),money(v.p)]))}\n  <div class=\"sum\" style=\"margin-top:12px\"><div><span>الربح التشغيلي</span><b>${fmt(T[5])}</b></div><div><span>رواتب الشهر</span><b>${fmt(sal)}</b></div><div><span>صافي بعد الرواتب</span><b>${fmt(T[5]-sal)}</b></div></div></div>`}\n if(t==='debts'){const c=db.customers.map(x=>[x,custBal(x)]).filter(x=>Math.abs(x[1])>0.001).sort((a,b)=>b[1]-a[1]);const s=db.suppliers.map(x=>[x,supBal(x)]).filter(x=>Math.abs(x[1])>0.001);\n  b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn s\" onclick=\"printBox('rep','تقرير الديون والمستحقات')\">${ic('print',18)} طباعة</button></div><div id=\"rep\"><h3>ديون العملاء (لنا)</h3>${tbl(['العميل','الهاتف','المبلغ'],c.map(([x,v])=>[esc(x.name)+(x.deleted?' <span class=\"tag tx\">محذوف</span>':''),esc(x.phone||''),money(v)]),['المجموع','',money(c.reduce((a,x)=>a+x[1],0))])}\n  <h3>مستحقات الموردين (علينا)</h3>${tbl(['المورد','الهاتف','المبلغ'],s.map(([x,v])=>[esc(x.name),esc(x.phone||''),money(v)]),['المجموع','',money(s.reduce((a,x)=>a+x[1],0))])}\n  <h3>سلف الموظفين القائمة</h3>${tbl(['الموظف','المبلغ'],db.employees.filter(e=>pendAdv(e.id)>0).map(e=>[esc(e.name),money(pendAdv(e.id))]))}</div>`}\n if(t==='purch')b=purchRep();\n if(t==='salesr')b=salesRep();\n if(t==='tanks'){b=`<div class=\"row\" style=\"margin-bottom:10px\"><button class=\"btn s\" onclick=\"printBox('rep','تقرير الخزانات')\">${ic('print',18)} طباعة</button></div><div id=\"rep\">${tbl(['الخزان','الوقود','السعة','الرصيد','النسبة','قيمة الرصيد بالكلفة'],db.tanks.map(t=>[esc(t.name),esc(fuelOf(t.fuelId).name),`<span class=\"num\">${fmt(t.capacity)}</span>`,`<span class=\"num\">${fmt(t.qty)}</span>`,(t.capacity?Math.round(t.qty/t.capacity*100):0)+'%',money(t.qty*(fuelOf(t.fuelId).cost||0))]))}\n  <h3>المضخات</h3>${tbl(['المضخة','الوقود','آخر قراءة','الحالة'],db.pumps.map(p=>[esc(p.name),esc(fuelOf(p.fuelId).name),`<span class=\"num\">${fmt(p.meter)}</span>`,p.active?'يعمل':'متوقف']))}</div>`}\n return head('التقارير والإحصائيات','chart')+tabs('rt',[['day','التقرير اليومي'],['month','التقرير الشهري'],['salesr','تقرير المبيعات'],['purch','تقرير المشتريات'],['debts','الديون والمستحقات'],['tanks','الخزانات والمضخات']])+`<div class=\"box\">${b}</div>`};\n\n\n\nfunction salesRep(){const f=st.srf||today(),t=st.srt||today();const S=db.sales.filter(x=>x.date>=f&&x.date<=t),M=db.moves.filter(x=>x.type==='out'&&x.date>=f&&x.date<=t);\n const sm=a=>a.reduce((q,x)=>q+x.amount,0),sl=a=>a.reduce((q,x)=>q+x.liters,0);const fa=sm(S),ma=sm(M),cr=sm(S.filter(x=>x.pay==='credit'))+sm(M.filter(x=>x.pay==='credit'));\n const prof=S.reduce((q,x)=>q+x.amount-x.liters*(x.cost||0),0)+M.reduce((q,x)=>q+x.amount-x.qty*(x.cost||0),0);\n const g=(arr,key)=>{const o={};arr.forEach(x=>{const k=key(x);const v=o[k]=o[k]||{n:0,l:0,a:0,c:0};v.n++;v.l+=x.liters||x.qty||0;v.a+=x.amount;if(x.pay==='credit')v.c+=x.amount});return o};\n const byF=g(S,x=>x.fuelId),byP=g(S,x=>x.pumpId),byI=g(M,x=>x.itemId),byC=g(S.filter(x=>x.pay==='credit').concat(M.filter(x=>x.pay==='credit')),x=>x.customerId);\n const byH={};S.forEach(x=>{const h=(x.time||'00').slice(0,2);const v=byH[h]=byH[h]||{n:0,l:0,a:0};v.n++;v.l+=x.liters;v.a+=x.amount});\n const pm=Object.keys(byP).map(k=>byId(db.pumps,k)||{id:k,name:'-'}).sort(mSort);\n return`<div class=\"row\" style=\"margin-bottom:10px;align-items:flex-end\">${fi('من','srff',f,'date','onchange=\"st.srf=this.value;render()\"')}${fi('إلى','srtt',t,'date','onchange=\"st.srt=this.value;render()\"')}<button class=\"btn s\" onclick=\"st.srf='';st.srt='';render()\">اليوم</button><button class=\"btn s\" onclick=\"st.srf=today().slice(0,8)+'01';st.srt=today();render()\">هذا الشهر</button><button class=\"btn s\" onclick=\"printBox('rep','تقرير المبيعات')\">${ic('print',18)} طباعة</button></div><div id=\"rep\">\n <p style=\"margin:0 0 8px;color:var(--mut)\">من ${f} إلى ${t}</p>\n <div class=\"sum\"><div><span>إجمالي المبيعات</span><b>${fmt(fa+ma)}</b></div><div><span>مبيعات الوقود</span><b>${fmt(fa)}</b></div><div><span>لترات الوقود</span><b>${fmt(sl(S))}</b></div><div><span>مبيعات المواد</span><b>${fmt(ma)}</b></div><div><span>منها نقد</span><b class=\"pos\">${fmt(fa+ma-cr)}</b></div><div><span>منها آجل</span><b class=\"neg\">${fmt(cr)}</b></div><div><span>عدد العمليات</span><b>${S.length+M.length}</b></div><div><span>الربح الإجمالي</span><b>${fmt(prof)}</b></div></div>\n <h3>حسب نوع الوقود</h3>${tbl(['الوقود','العمليات','اللترات','المبلغ','آجل'],Object.entries(byF).map(([k,v])=>[`<span class=\"dot\" style=\"background:${fuelOf(k).color}\"></span>${esc(fuelOf(k).name)}`,v.n,`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a),money(v.c)]),S.length?['المجموع',S.length,`<span class=\"num\">${fmt(sl(S))}</span>`,money(fa),money(sm(S.filter(x=>x.pay==='credit')))]:null)}\n <h3>حسب المضخة والعداد</h3>${tbl(['المجموعة','العداد','العمليات','اللترات','المبلغ'],pm.map(p=>{const v=byP[p.id];return[lnTag(laneOfM(p)),esc(p.name),v.n,`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a)]}))}\n <h3>حسب الساعة</h3>${tbl(['الساعة','العمليات','اللترات','المبلغ'],Object.keys(byH).sort().map(h=>[`${t12(h+':00')} — ${t12(String((+h+1)%24).padStart(2,'0')+':00')}`,byH[h].n,`<span class=\"num\">${fmt(byH[h].l)}</span>`,money(byH[h].a)]))}\n <h3>مبيعات المواد</h3>${tbl(['المادة','العمليات','الكمية','المبلغ','آجل'],Object.entries(byI).map(([k,v])=>[esc(nm(db.items,k)),v.n,`<span class=\"num\">${fmt(v.l)}</span>`,money(v.a),money(v.c)]),M.length?['المجموع',M.length,'',money(ma),'']:null)}\n <h3>المبيعات الآجلة حسب العميل</h3>${tbl(['العميل','العمليات','المبلغ'],Object.entries(byC).map(([k,v])=>[esc(nm(db.customers,k)),v.n,money(v.a)]))}</div>`}\nfunction purchRep(){const m=st.prm||month();const R=db.receipts.filter(r=>month(r.date)===m).sort((a,b)=>a.date.localeCompare(b.date));const M=db.moves.filter(x=>x.type==='in'&&month(x.date)===m);\n const tot=R.reduce((a,r)=>a+r.total,0),pd=R.reduce((a,r)=>a+r.paid,0),lt=R.reduce((a,r)=>a+r.liters,0),mt=M.reduce((a,x)=>a+x.amount,0);\n const byF={};R.forEach(r=>{const g=byF[r.fuelId]=byF[r.fuelId]||{n:0,l:0,a:0,p:0};g.n++;g.l+=r.liters;g.a+=r.total;g.p+=r.paid});\n const byS={};R.forEach(r=>{const g=byS[r.supplierId]=byS[r.supplierId]||{n:0,l:0,a:0,p:0};g.n++;g.l+=r.liters;g.a+=r.total;g.p+=r.paid});\n return`<div class=\"row\" style=\"margin-bottom:10px\"><div style=\"max-width:200px\">${fi('الشهر','prmm',m,'month','onchange=\"st.prm=this.value;render()\"')}</div><button class=\"btn s\" onclick=\"printBox('rep','تقرير المشتريات ${m}')\">${ic('print',18)} طباعة</button>${can('purchases')?`<button class=\"btn\" onclick=\"st.pt='rc';go('purchases')\">${ic('truck',18)} صفحة المشتريات</button>`:''}</div><div id=\"rep\">\n <div class=\"sum\"><div><span>عدد الشحنات</span><b>${R.length}</b></div><div><span>لترات الوقود</span><b>${fmt(lt)}</b></div><div><span>قيمة الوقود</span><b>${fmt(tot)}</b></div><div><span>المدفوع نقداً</span><b class=\"pos\">${fmt(pd)}</b></div><div><span>آجل (دين)</span><b class=\"neg\">${fmt(tot-pd)}</b></div><div><span>مشتريات المواد</span><b>${fmt(mt)}</b></div><div><span>إجمالي المشتريات</span><b>${fmt(tot+mt)}</b></div></div>\n <h3>حسب نوع الوقود</h3>${tbl(['الوقود','الشحنات','اللترات','القيمة','معدل سعر اللتر','المدفوع','آجل'],Object.entries(byF).map(([k,g])=>[`<span class=\"dot\" style=\"background:${fuelOf(k).color}\"></span>${esc(fuelOf(k).name)}`,g.n,`<span class=\"num\">${fmt(g.l)}</span>`,money(g.a),money(g.l?g.a/g.l:0),money(g.p),money(g.a-g.p)]),R.length?['المجموع',R.length,`<span class=\"num\">${fmt(lt)}</span>`,money(tot),'',money(pd),money(tot-pd)]:null)}\n <h3>حسب المورد</h3>${tbl(['المورد','الشحنات','اللترات','القيمة','المدفوع','آجل','رصيده الكلي'],Object.entries(byS).map(([k,g])=>{const sp=byId(db.suppliers,k)||{};return[esc(sp.name||'-'),g.n,`<span class=\"num\">${fmt(g.l)}</span>`,money(g.a),money(g.p),money(g.a-g.p),sp.id?money(supBal(sp)):'']}))}\n <h3>تفاصيل الشحنات</h3>${tbl(['التاريخ','الوصل','المورد','الخزان','الوقود','اللترات','سعر اللتر','القيمة','الدفع','المدفوع','المتبقي'],R.map(r=>[r.date,esc(r.inv||''),esc(nm(db.suppliers,r.supplierId)),esc(nm(db.tanks,r.tankId)),esc(fuelOf(r.fuelId).name),`<span class=\"num\">${fmt(r.liters)}</span>`,money(r.cost),money(r.total),rpTag(r),money(r.paid),money(r.total-r.paid)]))}\n ${M.length?`<h3>مشتريات المواد (زيوت ومواد)</h3>${tbl(['التاريخ','المادة','الكمية','السعر','المبلغ','المورد'],M.map(x=>[x.date,esc(nm(db.items,x.itemId)),`<span class=\"num\">${fmt(x.qty)}</span>`,money(x.price),money(x.amount),esc(nm(db.suppliers,x.supplierId,'—'))]),['المجموع','','','',money(mt),''])}`:''}</div>`}\n/* ================= سجل العمليات ================= */\nP.log=()=>{const q=(st.lq||'').toLowerCase(),d=st.ld||'';const l=db.log.filter(x=>(!d||x.date===d)&&(!q||(x.u+' '+x.a+' '+x.d).toLowerCase().includes(q))).slice(0,500);\n return head('سجل العمليات والتعديلات','log')+`<div class=\"box\"><div class=\"row\" style=\"margin-bottom:10px\"><div style=\"max-width:260px\">${fi('بحث','lqq',st.lq||'','text','onchange=\"st.lq=this.value;render()\"')}</div><div style=\"max-width:200px\">${fi('التاريخ','ldd',d,'date','onchange=\"st.ld=this.value;render()\"')}</div></div>\n ${tbl(['التاريخ','الوقت','المستخدم','العملية','التفاصيل'],l.map(x=>[x.date,t12(x.time),esc(x.u),`<b>${esc(x.a)}</b>`,esc(x.d)]))}<p style=\"color:var(--mut);font-size:12px\">يُعرض آخر 500 عملية مطابقة.</p></div>`};\n\n/* ================= المستخدمين ================= */\nP.users=()=>`<div class=\"box\"><div class=\"row\" style=\"justify-content:space-between;margin-bottom:10px\"><h3 style=\"margin:0\">${gi('lock',19)} المستخدمين والصلاحيات</h3><button class=\"btn g\" onclick=\"editUser()\">${ic('plus',18)} مستخدم جديد</button></div>${tbl(['الاسم','اسم الدخول','النوع','الصلاحيات','الحالة',''],db.users.map(u=>[esc(u.name),esc(u.user),u.role==='admin'?'<span class=\"tag tb\">مدير</span>':'مستخدم',u.role==='admin'?'كل الصلاحيات':(u.perms||[]).map(p=>(NAV.concat(XPERM).find(n=>n[0]===p)||[])[1]).filter(Boolean).join('، '),u.active!==false?'<span class=\"tag tg\">فعال</span>':'<span class=\"tag tx\">موقوف</span>',`<button class=\"btn sm\" onclick=\"editUser('${u.id}')\">تعديل</button>`]))}</div>`;\nfunction editUser(id){const x=id?byId(db.users,id):{name:'',user:'',role:'user',perms:['sales','shifts'],active:true};\n modal(id?'تعديل مستخدم':'مستخدم جديد',`<div class=\"row\">${fi('الاسم','un',x.name)}${fi('اسم الدخول','uu',x.user)}${fi(id?'كلمة مرور جديدة (اتركها فارغة للإبقاء)':'كلمة المرور','upw','','password')}${fs('النوع','ur',[['user','مستخدم'],['admin','مدير (كل الصلاحيات)']],x.role)}${fs('الحالة','ua',[['1','فعال'],['0','موقوف']],x.active!==false?'1':'0')}</div>\n <h4>الصلاحيات (للمستخدم العادي)</h4><div class=\"chk\">${NAV.filter(n=>n[0]!=='home').concat(XPERM).map(n=>`<label><input type=\"checkbox\" class=\"up\" value=\"${n[0]}\" ${(x.perms||[]).includes(n[0])?'checked':''}> ${n[1]}</label>`).join('')}</div>`,()=>{\n  need(V('un')&&V('uu'),'أكمل الاسم واسم الدخول');need(!db.users.some(u=>u.user===V('uu')&&u.id!==id),'اسم الدخول مستخدم مسبقاً');need(id||V('upw'),'أدخل كلمة المرور');\n  const o={name:V('un'),user:V('uu'),role:V('ur'),active:V('ua')==='1',perms:[...document.querySelectorAll('.up:checked')].map(c=>c.value)};\n  if(id&&x.role==='admin'&&(o.role!=='admin'||!o.active)&&db.users.filter(u=>u.role==='admin'&&u.active!==false).length<2)throw new Error('لازم يبقى مدير فعال واحد على الأقل');\n  if(V('upw'))o.pass=hp(V('upw'));if(id){Object.assign(x,o);save('تعديل مستخدم',o.user)}else{o.id=uid();db.users.push(o);save('إضافة مستخدم',o.user)}})}\n\n/* ================= الإعدادات ================= */\nP.settings=()=>{const s=db.settings;const cs=can('settings'),cb=can('backup'),ad=me.role==='admin';const T=[];if(cs)T.push(['st','إعدادات المحطة','gear']);if(can('users'))T.push(['usr','المستخدمين والصلاحيات','lock']);if(ad)T.push(['net','الشبكة (سيرفر/كلاينت)','db'],['lic','الترخيص والتفعيل','lock'],['upd','التحديثات','power']);if(cb)T.push(['bk','النسخ الاحتياطي','db']);if(cs)T.push(['prn','الطباعة','print'],['grp','مجموعات المحطة','pump'],['scr','حجم الشاشة','chart']);T.push(['look','الخط والألوان','list']);if(ad)T.push(['demo','البيانات المؤقتة','list']);\n const t=T.some(x=>x[0]===st.stt)?st.stt:T[0][0];const hd=head('الإعدادات','gear')+`<div class=\"stabs\">${T.map(([k,n,g])=>`<a class=\"${t===k?'on':''}\" onclick=\"st.stt='${k}';render()\">${gi(g,16)}<span>${n}</span></a>`).join('')}</div>`;\n if(t==='bk')return hd+P.backup();if(t==='usr')return hd+P.users();if(t==='prn')return hd+printSetBox();if(t==='look')return hd+lookBox();if(t==='net')return hd+netBox();if(t==='upd')return hd+updBox();if(t==='lic')return hd+`<div class=\"box\"><h3>${gi('lock',19)} الترخيص والتفعيل</h3>${licPanel(false)}</div>`;const G=`<div class=\"box\"><h3>بيانات المحطة</h3><div class=\"row\">${fi('اسم المحطة','sn1',s.name)}${fi('العنوان','sa1',s.address)}${fi('الهاتف','sp1',s.phone)}${fi('العملة','sc1',s.cur)}${fi('نسبة تنبيه انخفاض الخزان %','sl1',s.low,'number')}</div>\n <div class=\"row\" style=\"margin-top:10px\">${ft('فئات المصاريف (كل فئة بسطر)','se1',s.expCats.join('\\n'))}${ft('فئات الإيرادات (كل فئة بسطر)','sr1',s.revCats.join('\\n'))}</div><button class=\"btn g\" style=\"margin-top:10px\" onclick=\"saveSet()\">حفظ الإعدادات</button></div>\n<!--S:grp--> <div class=\"box\"><h3>${gi('pump',19)} مجموعات المحطة</h3><p style=\"color:var(--mut);font-size:12.5px;margin-top:0\">كل مجموعة إلها اسم ولون، والمضخة تنحط بمجموعتها من «إدارة الخزانات ← المضخات ← تعديل المضخة».</p>\n <div id=\"lnEd\">${db.settings.lanes.map((l,i)=>`<div class=\"row lnrow\" data-old=\"${esc(l.k)}\" style=\"margin-bottom:6px;align-items:center\"><div class=\"f\" style=\"max-width:260px\"><label>اسم المجموعة</label><input class=\"lnk\" value=\"${esc(l.k)}\" maxlength=\"30\" placeholder=\"اكتب اسم المجموعة\"></div><div class=\"f\" style=\"max-width:90px\"><label>اللون</label><input class=\"lnc\" type=\"color\" value=\"${esc(l.color)}\"></div>${lnTag(l.k,1)}<span style=\"color:var(--mut);font-size:12.5px\">${db.disps.filter(d=>d.lane===l.k).length} مضخة</span><button class=\"btn sm r\" onclick=\"this.closest('.lnrow').remove()\">حذف</button></div>`).join('')}</div>\n <div class=\"row\"><button class=\"btn s\" onclick=\"addLaneRow()\">${ic('plus',16)} مجموعة جديدة</button><button class=\"btn g\" onclick=\"saveLanes()\">حفظ المجموعات</button></div></div>\n<!--S:scr--> <div class=\"box\"><h3>${gi('gear',19)} حجم الشاشة (تكبير / تصغير)</h3><div class=\"row\" style=\"align-items:center;gap:14px\">\n <button class=\"btn s\" onclick=\"setZoom(getZoom()-10)\">−</button><input id=\"zr\" type=\"range\" min=\"50\" max=\"150\" step=\"5\" value=\"${getZoom()}\" style=\"flex:1;min-width:200px;accent-color:#1565d8\" oninput=\"setZoom(+this.value)\"><button class=\"btn s\" onclick=\"setZoom(getZoom()+10)\">+</button>\n <b id=\"zl\" class=\"num\" style=\"font-size:20px;min-width:70px;text-align:center\">${getZoom()}%</b><button class=\"btn\" onclick=\"setZoom(100)\">إرجاع 100%</button></div>\n <div class=\"row\" style=\"margin-top:10px\">${[50,75,90,100,110,125,150].map(z=>`<button class=\"btn sm s\" onclick=\"setZoom(${z})\">${z}%</button>`).join('')}</div>\n <p style=\"color:var(--mut);font-size:12.5px;margin:8px 0 0\">من 50% إلى 150%. الحجم ينحفظ على هذا الجهاز ويبقى بعد إعادة الفتح.</p>\n <div class=\"row\" style=\"margin-top:14px;padding-top:12px;border-top:1px solid var(--bd)\">${psCtl()}</div></div>\n<!--S:st--> <div class=\"box\"><h3>تغيير كلمة المرور الخاصة بي</h3><div class=\"row\">${fi('كلمة المرور الحالية','op','','password')}${fi('كلمة المرور الجديدة','np','','password')}${fi('تأكيد','np2','','password')}<button class=\"btn\" onclick=\"chPass()\">تغيير</button></div></div>\n<!--S:demo--> ${me.role==='admin'?`<div class=\"box\"><h3 style=\"color:var(--red)\">${gi('db',19)} البيانات المؤقتة (التجريبية)</h3>${demoCount()?`<p>يحتوي البرنامج على <b class=\"num\">${demoCount()}</b> سجل تجريبي (موظفين، مواد، خزانات، مضخات، عملاء، موردين، مبيعات، حركات صندوق...).</p><p style=\"color:var(--mut);font-size:12.5px\">المسح يحذف البيانات التجريبية فقط، والبيانات اللي أدخلتها أنت تبقى كما هي. تُحفظ نسخة احتياطية تلقائياً قبل المسح.</p><button class=\"btn r\" onclick=\"wipeDemo()\">${ic('db',18)} مسح جميع البيانات المؤقتة</button>`:`<p style=\"color:var(--mut)\">لا توجد بيانات تجريبية في البرنامج.</p>${!db.sales.length?`<button class=\"btn s\" onclick=\"loadDemo()\">تحميل بيانات تجريبية</button>`:''}`}</div>`:''}`;const P2=G.split(/<!--S:(\\w+)-->/);const sec={st:P2[0]};for(let k=1;k<P2.length;k+=2)sec[P2[k]]=(sec[P2[k]]||'')+P2[k+1];return hd+(sec[t]||'')};\nfunction addLaneRow(){const n=document.querySelectorAll('.lnrow').length;const k=String.fromCharCode(65+Math.min(25,n));const C=LANEPAL;\n const d=document.createElement('div');d.className='row lnrow';d.style.cssText='margin-bottom:6px;align-items:center';d.innerHTML=`<div class=\"f\" style=\"max-width:260px\"><label>اسم المجموعة</label><input class=\"lnk\" value=\"\" maxlength=\"30\" placeholder=\"اكتب اسم المجموعة\"></div><div class=\"f\" style=\"max-width:90px\"><label>اللون</label><input class=\"lnc\" type=\"color\" value=\"${C[n%C.length]}\"></div><button class=\"btn sm r\" onclick=\"this.closest('.lnrow').remove()\">حذف</button>`;$('#lnEd').appendChild(d)}\nfunction saveLanes(){const rows=[...document.querySelectorAll('.lnrow')].map(r=>({k:r.querySelector('.lnk').value.trim(),color:r.querySelector('.lnc').value,old:r.dataset.old||''}));\n if(!rows.length){alert('لازم تبقى مجموعة وحدة على الأقل');return}if(rows.some(r=>!r.k)){alert('اكتب اسم كل مجموعة');return}if(new Set(rows.map(r=>r.k)).size!==rows.length){alert('أسماء المجموعات مكررة');return}\n const old=db.settings.lanes.map(l=>l.k);const ren={};document.querySelectorAll('.lnrow').forEach((r,i)=>{});\n db.disps.forEach(d=>{const r=rows.find(x=>x.old&&x.old===d.lane);if(r)d.lane=r.k});db.settings.lanes=rows.map(r=>({k:r.k,color:r.color}));db.disps.forEach(d=>{if(!rows.some(l=>l.k===d.lane))d.lane=rows[0].k});save('تعديل المجموعات',rows.map(r=>r.k).join('، '));alert('تم حفظ المجموعات');render()}\nfunction saveSet(){const s=db.settings;Object.assign(s,{name:V('sn1')||'محطة الوقود',address:V('sa1'),phone:V('sp1'),cur:V('sc1')||'د.ع',low:N('sl1')||20,\n expCats:V('se1').split('\\n').map(x=>x.trim()).filter(Boolean),revCats:V('sr1').split('\\n').map(x=>x.trim()).filter(Boolean)});if(!s.expCats.length)s.expCats=['أخرى'];if(!s.revCats.length)s.revCats=['أخرى'];save('تعديل الإعدادات','');alert('تم الحفظ');render()}\nfunction chPass(){if(me.pass!==hp(V('op'))){alert('كلمة المرور الحالية غير صحيحة');return}if(V('np').length<4){alert('كلمة المرور قصيرة (4 أحرف على الأقل)');return}if(V('np')!==V('np2')){alert('التأكيد غير مطابق');return}\n me.pass=hp(V('np'));save('تغيير كلمة المرور',me.user);alert('تم تغيير كلمة المرور');render()}\n\n/* ================= النسخ الاحتياطي ================= */\nP.backup=()=>{let sn=[];try{sn=JSON.parse(localStorage.getItem(SNAP)||'[]')}catch(e){}\n return autoBkBox()+`<div class=\"box\"><h3>نسخة احتياطية يدوية</h3><p>احفظ ملف النسخة على فلاش أو بالإيميل بشكل دوري.</p><div class=\"row\"><button class=\"btn g\" onclick=\"exportDB()\">${ic('db',18)} تصدير نسخة احتياطية</button>\n <label class=\"btn o\" style=\"cursor:pointer\">استعادة من ملف<input type=\"file\" accept=\".json\" style=\"display:none\" onchange=\"importDB(this)\"></label></div></div>\n <div class=\"box\"><h3>النسخ التلقائية (يومية داخل الجهاز — آخر 5 أيام)</h3>${tbl(['اليوم','الوقت',''],sn.slice().reverse().map((x,i)=>[x.d,t12(x.t),`<button class=\"btn sm o\" onclick=\"restoreSnap(${sn.length-1-i})\">استعادة</button>`]))}</div>\n ${me.role==='admin'?`<div class=\"box\"><h3 style=\"color:var(--red)\">منطقة الخطر</h3><div class=\"row\"><button class=\"btn r\" onclick=\"wipeDB()\">مسح كل البيانات</button>${!db.sales.length&&!db.settings.demoLoaded?`<button class=\"btn s\" onclick=\"loadDemo()\">تحميل بيانات تجريبية</button>`:''}</div></div>`:''}`};\nfunction exportDB(){const b=new Blob([JSON.stringify({app:'byte-fuel',v:1,at:new Date().toISOString(),db})],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=`byte-fuel-backup-${today()}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);save('تصدير نسخة احتياطية','')}\nfunction importDB(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const j=JSON.parse(r.result);const d=j.db||j;if(!d||!d.settings||!Array.isArray(d.users))throw 0;\n if(!confirm('سيتم استبدال كل البيانات الحالية بالنسخة المختارة. متابعة؟'))return;db=d;migrate();if(NET.on)NET.force=true;me=byId(db.users,me.id)||db.users.find(u=>u.role==='admin');save('استعادة نسخة احتياطية',f.name);alert('تمت الاستعادة');render()}catch(e){alert('الملف غير صالح')}};r.readAsText(f)}\nfunction restoreSnap(i){const sn=JSON.parse(localStorage.getItem(SNAP)||'[]');const x=sn[i];if(!x||!confirm('استعادة بيانات يوم '+x.d+'؟ ستفقد التغييرات بعدها.'))return;db=JSON.parse(x.data);migrate();if(NET.on)NET.force=true;me=byId(db.users,me.id)||db.users[0];save('استعادة نسخة تلقائية',x.d);render()}\nfunction wipeDB(){if(prompt('لمسح كل البيانات اكتب: مسح')!=='مسح')return;exportDB();const u=me;db=blank();db.settings.demoAuto=2;migrate();if(NET.on)NET.force=true;db.users=[Object.assign({},u)];me=db.users[0];save('مسح كل البيانات','');render()}\n\n\n/* ================= المزامنة / النسخ الاحتياطي التلقائي ================= */\nconst ABK='byte_fuel_autobk_last',ASN='byte_fuel_autosnaps',BKMIN=[[30,'كل نص ساعة'],[60,'كل ساعة'],[120,'كل ساعتين'],[180,'كل 3 ساعات'],[240,'كل 4 ساعات'],[300,'كل 5 ساعات'],[360,'كل 6 ساعات']];\nlet BKDIR=null,BKPERM='',BKBUSY=false;const HASFS=typeof window.showDirectoryPicker==='function';\nfunction idb(){return new Promise((ok,no)=>{const r=indexedDB.open('byte_fuel_fs',1);r.onupgradeneeded=()=>r.result.createObjectStore('h');r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}\nasync function idbGet(k){try{const d=await idb();return await new Promise(ok=>{const q=d.transaction('h').objectStore('h').get(k);q.onsuccess=()=>ok(q.result);q.onerror=()=>ok(null)})}catch(e){return null}}\nasync function idbSet(k,v){try{const d=await idb();await new Promise(ok=>{const t=d.transaction('h','readwrite');t.objectStore('h').put(v,k);t.oncomplete=ok;t.onerror=ok})}catch(e){}}\nconst bkLast=()=>{try{return JSON.parse(localStorage.getItem(ABK)||'{}')}catch(e){return{}}};\nconst bkSnaps=()=>{try{return JSON.parse(localStorage.getItem(ASN)||'[]')}catch(e){return[]}};\nconst stamp=d=>{d=d||new Date();const z=n=>String(n).padStart(2,'0');return`${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}_${z(d.getHours())}${z(d.getMinutes())}`};\nconst fmtTS=t=>{if(!t)return'—';const d=new Date(t);return fmtDate(today(d))+' '+t12(String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'))};\nasync function initBk(){if(!HASFS)return;BKDIR=await idbGet('dir');if(BKDIR){try{BKPERM=await BKDIR.queryPermission({mode:'readwrite'})}catch(e){BKPERM='denied'}}if(page==='settings'&&me)render()}\nasync function pickBkDir(){if(!HASFS){alert('المتصفح ما يدعم اختيار مجلد. استعمل Google Chrome أو Microsoft Edge، أو اختار «تنزيل ملف».');return}\n try{const d=await window.showDirectoryPicker({id:'bytefuel',mode:'readwrite'});BKDIR=d;BKPERM='granted';await idbSet('dir',d);db.settings.autoBk.mode='folder';save('اختيار مجلد النسخ التلقائي',d.name);await runAutoBk(true)}catch(e){if(e&&e.name!=='AbortError')alert('تعذر اختيار المجلد: '+e.message)}render()}\nasync function grantBk(){if(!BKDIR)return pickBkDir();try{BKPERM=await BKDIR.requestPermission({mode:'readwrite'});if(BKPERM==='granted')await runAutoBk(true)}catch(e){alert(e.message)}render()}\nasync function runAutoBk(manual){if(BKBUSY)return;BKBUSY=true;const cfg=db.settings.autoBk||{},now=Date.now();const data=JSON.stringify({app:'byte-fuel',v:1,at:new Date().toISOString(),auto:true,db});let where='داخل البرنامج',ok=true,err='';\n try{let sn=bkSnaps();sn.push({t:now,data});sn=sn.slice(-6);try{localStorage.setItem(ASN,JSON.stringify(sn))}catch(e){sn=sn.slice(-2);try{localStorage.setItem(ASN,JSON.stringify(sn))}catch(x){}}\n  if(cfg.mode==='folder'){if(BKDIR&&BKPERM==='granted'){const nm1=`bytefuel-auto-${stamp()}.json`;\n    for(const n of [nm1,'bytefuel-latest.json']){const fh=await BKDIR.getFileHandle(n,{create:true});const w=await fh.createWritable();await w.write(data);await w.close()}\n    try{const L=[];for await(const [n,h] of BKDIR.entries())if(h.kind==='file'&&/^bytefuel-auto-.*\\.json$/.test(n))L.push(n);L.sort();for(const n of L.slice(0,Math.max(0,L.length-48)))await BKDIR.removeEntry(n)}catch(e){}\n    where='المجلد: '+BKDIR.name}else{ok=false;err=BKDIR?'المجلد يحتاج سماح بالكتابة':'ما تم اختيار مجلد';where='داخل البرنامج فقط'}}\n  else if(cfg.mode==='download'){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type:'application/json'}));a.download=`bytefuel-auto-${stamp()}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),3000);where='تنزيلات المتصفح'}\n }catch(e){ok=false;err=e.message||String(e)}\n try{localStorage.setItem(ABK,JSON.stringify({t:now,ok,where,err}))}catch(e){}BKBUSY=false;\n if(manual){if(ok)alert('تم أخذ نسخة احتياطية: '+where);else alert('انحفظت نسخة داخل البرنامج، لكن: '+err)}\n if(me&&(page==='settings'||!ok))render()}\nfunction checkAutoBk(){const c=db&&db.settings.autoBk;if(!c||!c.on)return;const l=bkLast();if(!l.t||Date.now()-l.t>=(+c.min||60)*60000)runAutoBk(false)}\nsetInterval(checkAutoBk,60000);\nfunction autoBkAlerts(a){const c=db.settings.autoBk;if(!c||!c.on||!me||me.role!=='admin')return;\n if(c.mode==='folder'&&(!BKDIR||BKPERM!=='granted'))a.push('النسخ التلقائي: مجلد النسخ يحتاج '+(BKDIR?'سماح بالكتابة':'اختيار')+' — من «الإعدادات ← النسخ الاحتياطي»');\n const l=bkLast();if(l.t&&Date.now()-l.t>(+c.min||60)*2*60000)a.push('آخر نسخة احتياطية تلقائية قديمة: '+fmtTS(l.t))}\nfunction saveAutoBk(){const c=db.settings.autoBk;c.on=$('#abOn').checked;c.min=+V('abMin')||60;c.mode=V('abMode')||'internal';save('إعدادات النسخ التلقائي',`${c.on?'مفعل':'متوقف'} — كل ${c.min} دقيقة — ${c.mode}`);\n if(c.mode==='folder'&&!BKDIR&&HASFS){pickBkDir();return}alert('تم حفظ إعدادات النسخ التلقائي');render()}\nfunction restoreAuto(i){const x=bkSnaps()[i];if(!x||!confirm('استعادة النسخة التلقائية بتاريخ '+fmtTS(x.t)+'؟ ستفقد التغييرات بعدها.'))return;try{const j=JSON.parse(x.data);db=j.db||j;migrate();if(NET.on)NET.force=true;me=byId(db.users,me.id)||db.users.find(u=>u.role==='admin');save('استعادة نسخة تلقائية',fmtTS(x.t));alert('تمت الاستعادة');render()}catch(e){alert('النسخة تالفة')}}\nfunction autoBkBox(){const c=db.settings.autoBk,l=bkLast(),adm=me.role==='admin',sn=bkSnaps();const nx=c.on?(l.t?l.t+(+c.min)*60000:Date.now()):0;\n const dirSt=!HASFS?'<span class=\"tag tr\">المتصفح ما يدعم المجلدات — استعمل Chrome أو Edge</span>':BKDIR?(BKPERM==='granted'?`<span class=\"tag tg\">${ic('db',14)} ${esc(BKDIR.name)} — جاهز</span>`:`<span class=\"tag ty\">${esc(BKDIR.name)} — يحتاج سماح</span> <button class=\"btn sm o\" onclick=\"grantBk()\">سماح بالكتابة</button>`):'<span class=\"tag tx\">ما تم اختيار مجلد</span>';\n return`<div class=\"box\"><h3>${gi('db',19)} المزامنة والنسخ الاحتياطي التلقائي</h3>\n <div class=\"sum\"><div><span>الحالة</span><b style=\"font-size:16px\" class=\"${c.on?'pos':'neg'}\">${c.on?'مفعل':'متوقف'}</b></div><div><span>التكرار</span><b style=\"font-size:16px\">${(BKMIN.find(x=>x[0]===+c.min)||[0,c.min+' دقيقة'])[1]}</b></div>\n <div><span>آخر نسخة</span><b style=\"font-size:15px;direction:rtl;text-align:right\" class=\"${l.t&&!l.ok?'neg':''}\">${fmtTS(l.t)}</b></div><div><span>النسخة الجاية</span><b style=\"font-size:15px;direction:rtl;text-align:right\">${c.on?fmtTS(Math.max(nx,Date.now())):'—'}</b></div></div>\n ${l.t?`<p style=\"margin:0 0 10px;color:${l.ok?'var(--grn)':'var(--red)'};font-weight:600\">${l.ok?'✓ انحفظت في: ':'⚠ '}${esc(l.ok?l.where:(l.err+' — انحفظت داخل البرنامج'))}</p>`:''}\n ${adm?`<div class=\"row\" style=\"align-items:center\"><label style=\"display:flex;gap:6px;align-items:center;font-weight:700;min-width:160px\"><input type=\"checkbox\" id=\"abOn\" ${c.on?'checked':''}> تفعيل النسخ التلقائي</label>\n ${fs('كل كم','abMin',BKMIN,c.min)}${fs('مكان الحفظ','abMode',[['folder','مجلد على الجهاز أو فلاش'],['download','تنزيل ملف (مجلد التنزيلات)'],['internal','داخل البرنامج فقط']],c.mode)}<button class=\"btn g\" onclick=\"saveAutoBk()\">حفظ الإعدادات</button></div>\n <div class=\"row\" style=\"margin-top:10px;align-items:center\"><span style=\"font-weight:600\">مجلد النسخ:</span> ${dirSt} <button class=\"btn sm\" onclick=\"pickBkDir()\">${BKDIR?'تغيير المجلد':'اختيار مجلد'}</button><button class=\"btn sm g\" onclick=\"runAutoBk(true)\">نسخ الآن</button></div>\n <p style=\"color:var(--mut);font-size:12.5px;margin:8px 0 0\">يحدد المدير التكرار من نص ساعة إلى كل 6 ساعات. النسخ يشتغل تلقائياً طول ما البرنامج مفتوح. بالمجلد ينحفظ ملف لكل نسخة (آخر 48 نسخة) ويه ملف <b>bytefuel-latest.json</b> دائماً هو الأحدث. إذا أعدت تشغيل الجهاز، المتصفح ممكن يطلب «سماح بالكتابة» مرة وحدة.</p>`:`<p style=\"color:var(--mut)\">إعدادات النسخ التلقائي يحددها المدير.</p>`}\n ${sn.length?`<h4 style=\"margin:12px 0 6px\">آخر النسخ التلقائية داخل البرنامج</h4>${tbl(['الوقت','الحجم',''],sn.map((x,i)=>[fmtTS(x.t),Math.round(x.data.length/1024)+' KB',adm?`<button class=\"btn sm o\" onclick=\"restoreAuto(${i})\">استعادة</button>`:'']).reverse())}`:''}</div>`}\n/* ================= السيرفر والكلاينت (مزامنة عبر الشبكة) ================= */\nconst NET={on:false,ver:0,snap:null,busy:false,ok:false,last:0,err:'',info:null,needRender:false,force:false,tm:null,pend:0},NETK='byte_fuel_net_v1';\nconst DCOPY=o=>JSON.parse(JSON.stringify(o));const INCF=['qty','paid'],INCS=['shiftNo','moveNo','payNo'];\nfunction dbDiff(a,b){const ops=[];a=a||{};\n for(const k in b){if(k==='settings'||!Array.isArray(b[k]))continue;const A=Array.isArray(a[k])?a[k]:[],B=b[k];\n  if(B.some(x=>!x||x.id==null)||A.some(x=>!x||x.id==null)){if(JSON.stringify(A)!==JSON.stringify(B))ops.push({k,op:'all',v:B});continue}\n  const ma=new Map(A.map(x=>[x.id,x])),mb=new Map(B.map(x=>[x.id,x]));\n  B.forEach(x=>{const o=ma.get(x.id);if(!o){ops.push({k,op:'add',rec:x});return}if(o===x)return;const sa=JSON.stringify(o),sb=JSON.stringify(x);if(sa===sb)return;\n   const set={},inc={},un=[];for(const f in x){if(JSON.stringify(x[f])!==JSON.stringify(o[f])){if(INCF.includes(f)&&typeof x[f]==='number'&&typeof o[f]==='number')inc[f]=x[f]-o[f];else set[f]=x[f]}}for(const f in o)if(!(f in x))un.push(f);ops.push({k,op:'upd',id:x.id,set,inc,un})});\n  A.forEach(x=>{if(!mb.has(x.id))ops.push({k,op:'del',id:x.id})})}\n const sa=a.settings||{},sb=b.settings||{};for(const f in sb){if(JSON.stringify(sa[f])!==JSON.stringify(sb[f])){if(INCS.includes(f)&&typeof sb[f]==='number'&&typeof sa[f]==='number')ops.push({k:'settings',op:'inc',f,v:sb[f]-sa[f]});else ops.push({k:'settings',op:'set',f,v:sb[f]})}}\n return ops}\nfunction dbApply(S,ops){S=S||blank();ops.forEach(o=>{if(o.k==='settings'){S.settings=S.settings||{};if(o.op==='inc')S.settings[o.f]=(+S.settings[o.f]||0)+o.v;else S.settings[o.f]=DCOPY(o.v);return}\n if(o.op==='all'){S[o.k]=DCOPY(o.v);return}const A=S[o.k]=Array.isArray(S[o.k])?S[o.k]:[];\n if(o.op==='add'){if(!A.some(x=>x.id===o.rec.id)){if(o.k==='log')A.unshift(DCOPY(o.rec));else A.push(DCOPY(o.rec))}}\n else if(o.op==='del')S[o.k]=A.filter(x=>x.id!==o.id);\n else{const r=A.find(x=>x.id===o.id);if(!r)return;Object.assign(r,DCOPY(o.set));for(const f in o.inc)r[f]=r2((+r[f]||0)+o.inc[f]);o.un.forEach(f=>delete r[f])}});\n // أرقام مكررة (شفتات/وصولات) بعد الدمج\n const fix=(arr,f,ctr)=>{const seen=new Set();let mr=0;(arr||[]).forEach(x=>{if(x[f]!=null)mr=Math.max(mr,+x[f])});(arr||[]).forEach(x=>{if(x[f]==null)return;if(seen.has(x[f]))x[f]=++mr;seen.add(x[f])});const need=ctr==='shiftNo'?mr+1:mr;if((+S.settings[ctr]||0)<need||(+S.settings[ctr]||0)>need+1)S.settings[ctr]=need};\n fix(S.shifts,'no','shiftNo');fix(S.moves,'no','moveNo');fix(S.cash,'vno','payNo');return S}\nfunction netCache(){try{localStorage.setItem(NETK,JSON.stringify({ver:NET.ver,snap:NET.snap,force:NET.force}))}catch(e){}}\nasync function netFetch(){const r=await fetch('/api/db',{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);return r.json()}\nfunction repointMe(){if(me){const u=byId(db.users,me.id);me=u&&u.active!==false?u:null;if(!me)sessionStorage.removeItem(SES)}}\nfunction softRender(){const m=$('#modal'),ae=document.activeElement;if((m&&m.style.display==='flex')||(ae&&ae.closest&&ae.closest('#root')&&/INPUT|TEXTAREA|SELECT/.test(ae.tagName))||DRG||HOLD){NET.needRender=true;return}NET.needRender=false;render()}\ndocument.addEventListener('focusout',()=>setTimeout(()=>{if(NET.needRender)softRender()},200));\nfunction adoptServer(S){const raw=S.db;if(raw&&typeof raw==='object'){db=DCOPY(raw);migrate();NET.snap=raw}else{db=blank();migrate();NET.snap={settings:{}};NET.force=true}NET.ver=S.ver;try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){}netCache();repointMe()}\nasync function netInit(){const r=await fetch('/api/ping',{cache:'no-store'});const j=await r.json();if(j.app!=='byte-fuel')throw new Error('not byte-fuel');NET.on=true;NET.info=j;\n let C=null;try{C=JSON.parse(localStorage.getItem(NETK)||'null')}catch(e){}let local=null;try{local=JSON.parse(localStorage.getItem(KEY)||'null')}catch(e){}\n const S=await netFetch();\n if(C&&C.snap&&local&&(C.force||dbDiff(C.snap,local).length)){ // تغييرات محلية ما انرفعت (انقطاع سابق)\n  NET.snap=C.snap;NET.ver=C.ver;NET.force=!!C.force;db=local;migrate()}else adoptServer(S);\n NET.ok=true;NET.last=Date.now();setInterval(netPoll,3000);setTimeout(netPush,300)}\nfunction netLoadOffline(){NET.on=true;NET.ok=false;NET.err='السيرفر غير متصل — تشتغل على نسخة محلية مؤقتة';let C=null;try{C=JSON.parse(localStorage.getItem(NETK)||'null')}catch(e){}\n load();NET.snap=C&&C.snap||DCOPY(db);NET.ver=C?C.ver:0;NET.force=!!(C&&C.force);setInterval(netPoll,3000)}\nfunction netQueue(){if(!NET.on)return;netCache();clearTimeout(NET.tm);NET.tm=setTimeout(netPush,250)}\nasync function netPush(){if(!NET.on||NET.busy)return;let ops=NET.force?null:dbDiff(NET.snap,db);if(!NET.force&&!ops.length){NET.pend=0;netBadge();return}\n NET.busy=true;NET.pend=ops?ops.length:1;netBadge();\n try{for(let t=0;t<6;t++){const r=await fetch('/api/save?base='+NET.ver+'&force='+(NET.force?1:0),{method:'POST',headers:{'Content-Type':'application/json; charset=utf-8'},body:JSON.stringify(db)});\n   if(r.ok){const j=await r.json();NET.ver=j.ver;NET.snap=DCOPY(db);NET.force=false;NET.ok=true;NET.err='';NET.last=Date.now();NET.pend=0;break}\n   if(r.status===409){const S=await netFetch();const base=S.db&&typeof S.db==='object'?S.db:blank();const merged=dbApply(DCOPY(base),ops||[]);db=merged;migrate();NET.snap=base;NET.ver=S.ver;repointMe();ops=dbDiff(NET.snap,db);NET.needRender=true;continue}\n   throw new Error('HTTP '+r.status)}\n  try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){}netCache()}\n catch(e){NET.ok=false;NET.err='تعذر الحفظ على السيرفر — راح يعيد المحاولة تلقائياً';netCache()}\n finally{NET.busy=false;netBadge();if(NET.needRender)softRender();if(NET.ok&&(NET.force||dbDiff(NET.snap,db).length))setTimeout(netPush,200)}}\nasync function netPoll(){if(!NET.on||NET.busy)return;try{const r=await fetch('/api/ping',{cache:'no-store'});const j=await r.json();const was=NET.ok;NET.ok=true;NET.info=j;if(!was)NET.err='';\n  if(j.appver&&j.appver!==APP_VER&&!(NET.snap&&dbDiff(NET.snap,db).length)&&$('#modal').style.display!=='flex'){location.reload();return}\n  if(NET.force||dbDiff(NET.snap,db).length){netPush();return}\n  if(j.ver!==NET.ver){const S=await netFetch();if(NET.busy||dbDiff(NET.snap,db).length){netPush();return}adoptServer(S);NET.last=Date.now();softRender()}}\n catch(e){NET.ok=false;NET.err='السيرفر غير متصل — التغييرات تنحفظ مؤقتاً وترتفع لما يرجع الاتصال'}netBadge()}\nfunction netBadge(){const e=document.getElementById('netb');if(!e)return;const p=NET.force||(NET.snap&&dbDiff(NET.snap,db).length);e.className='netb '+(NET.ok?(p?'pend':'on'):'off');e.title=NET.ok?(p?'جاري الحفظ على السيرفر...':'متصل بالسيرفر — آخر مزامنة '+t12(String(new Date(NET.last).getHours()).padStart(2,'0')+':'+String(new Date(NET.last).getMinutes()).padStart(2,'0'))):NET.err;e.querySelector('span').textContent=NET.ok?(p?'يحفظ...':'متصل'):'غير متصل'}\nfunction netBox(){const i=NET.info||{},port=i.port||8789,ips=(i.ips||[]).filter(x=>!/^127\\./.test(x));\n if(!NET.on)return`<div class=\"box\"><h3>${gi('db',19)} الشبكة (سيرفر / كلاينت)</h3>\n <div class=\"warn\" style=\"background:#eff6ff;border-color:#93c5fd;color:#1e3a8a\">البرنامج حالياً يشتغل <b>محلي على هذا الجهاز فقط</b> (مفتوح كملف).</div>\n <h4 class=\"ddt\">طريقة تشغيل السيرفر حتى تشتغل أكثر من جهاز على نفس البيانات</h4>\n <ol style=\"line-height:2;margin-top:0\"><li>على الجهاز اللي يصير <b>سيرفر</b>: فك ملف البرنامج بمجلد ثابت، وشغّل <b>Start-ByteFuel-Server.bat</b> (أول مرة يطلب صلاحية المدير حتى يفتح المنفذ ${port} بالجدار الناري).</li>\n <li>تطلع نافذة سوداء بيها عنوان السيرفر مثل <b dir=\"ltr\">http://192.168.1.10:${port}</b> — خليها مفتوحة طول وقت الشغل.</li>\n <li>على كل جهاز ثاني (كمبيوتر، تابلت، موبايل) بنفس الشبكة: افتح المتصفح واكتب العنوان. وعلى السيرفر نفسه افتح <b dir=\"ltr\">http://localhost:${port}</b>.</li>\n <li>حتى تنقل بياناتك الحالية للسيرفر: من «النسخ الاحتياطي» هنا صدّر نسخة، وبعدها افتح عنوان السيرفر ← الإعدادات ← الشبكة ← «رفع نسخة احتياطية للسيرفر».</li></ol>\n <p style=\"color:var(--mut);font-size:12.5px\">البيانات بوضع السيرفر تنحفظ على جهاز السيرفر بمجلد <b>ByteFuel-Data</b>، ويه نسخة احتياطية تلقائية كل ساعة.</p></div>`;\n const p=NET.force||(NET.snap&&dbDiff(NET.snap,db).length);\n return`<div class=\"box\"><h3>${gi('db',19)} الشبكة (سيرفر / كلاينت)</h3>\n <div class=\"sum\"><div><span>الوضع</span><b style=\"font-size:16px\">كلاينت متصل بالسيرفر</b></div><div><span>الحالة</span><b style=\"font-size:16px\" class=\"${NET.ok?'pos':'neg'}\">${NET.ok?(p?'يحفظ...':'متصل ✓'):'غير متصل'}</b></div>\n <div><span>آخر مزامنة</span><b style=\"font-size:15px;direction:rtl;text-align:right\">${NET.last?fmtTS(NET.last):'—'}</b></div><div><span>رقم نسخة البيانات</span><b>${NET.ver}</b></div></div>\n ${NET.err?`<div class=\"warn\">${esc(NET.err)}</div>`:''}\n <p><b>اسم جهاز السيرفر:</b> ${esc(i.name||'-')}</p><p><b>عناوين الدخول من الأجهزة الثانية:</b> ${ips.length?ips.map(x=>`<span class=\"tag tb\" dir=\"ltr\" style=\"font-size:13px\">http://${esc(x)}:${port}</span>`).join(' '):'—'}</p>\n <div class=\"row\"><button class=\"btn g\" onclick=\"netPoll();netPush();setTimeout(render,600)\">مزامنة الآن</button>\n ${me.role==='admin'?`<label class=\"btn o\" style=\"cursor:pointer\">رفع نسخة احتياطية للسيرفر<input type=\"file\" accept=\".json\" style=\"display:none\" onchange=\"importDB(this)\"></label>`:''}<button class=\"btn s\" onclick=\"exportDB()\">تنزيل نسخة من السيرفر</button></div>\n <p style=\"color:var(--mut);font-size:12.5px\">كل التغييرات تنحفظ مباشرة على السيرفر وتطلع بالأجهزة الثانية خلال ثواني. إذا انقطع الاتصال، التغييرات تبقى بهذا الجهاز وترتفع لوحدها لما يرجع. «رفع نسخة احتياطية» يستبدل كل بيانات السيرفر.</p></div>`}\n\n/* ================= التحديثات (من الإنترنت أو من ملف .buc) ================= */\nconst UPD={info:null,err:'',busy:false};\nconst verCmp=(a,b)=>{a=String(a||'0').split('.').map(Number);b=String(b||'0').split('.').map(Number);for(let i=0;i<Math.max(a.length,b.length);i++){const d=(a[i]||0)-(b[i]||0);if(d)return d>0?1:-1}return 0};\nconst hexOf=u=>Array.from(u,x=>x.toString(16).padStart(2,'0')).join('');\nfunction parseBuc(txt){let j;try{j=JSON.parse(txt)}catch(e){throw new Error('ملف التحديث تالف أو مو ملف .buc')}\n if(!j||j.app!=='byte-fuel'||!j.ver||typeof j.html!=='string')throw new Error('هذا الملف مو تحديث لبرنامج بايت لمحطات الوقود');\n if(j.sha256&&hexOf(BL.sha256(j.html))!==j.sha256)throw new Error('ملف التحديث ناقص أو متغيّر (فحص السلامة فشل)');\n if(!/byte_fuel_db_v1/.test(j.html)||!/APP_VER='/.test(j.html))throw new Error('محتوى التحديث غير صالح');return j}\nasync function updCheck(){UPD.busy=true;UPD.err='';render();try{const r=await fetch(UPD_URL+'?t='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);UPD.info=await r.json()}catch(e){UPD.err='تعذر الاتصال بالإنترنت أو بموقع التحديثات'}UPD.busy=false;render()}\nasync function updOnline(){const i=UPD.info;if(!i||!i.url)return;UPD.busy=true;render();try{const r=await fetch(i.url+(i.url.includes('?')?'&':'?')+'t='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);await updApply(parseBuc(await r.text()))}catch(e){alert('فشل التحديث: '+e.message)}UPD.busy=false;render()}\nfunction updFile(inp){const f=inp.files[0];if(!f)return;const rd=new FileReader();rd.onload=async()=>{try{await updApply(parseBuc(rd.result))}catch(e){alert(e.message)}inp.value=''};rd.readAsText(f,'utf-8')}\nasync function updApply(j){const c=verCmp(j.ver,APP_VER);if(c===0&&!confirm('هذا نفس الإصدار الحالي ('+APP_VER+'). تعيد تثبيته؟'))return;if(c<0&&!confirm('هذا إصدار أقدم ('+j.ver+') من الحالي ('+APP_VER+'). متابعة؟'))return;\n if(!confirm(`تثبيت التحديث ${j.ver}؟${j.notes?'\\n\\n'+j.notes:''}\\n\\nبياناتك ما تتأثر. يُنصح تأخذ نسخة احتياطية قبل التحديث.`))return;\n try{exportDB()}catch(e){}\n if(NET.on){const r=await fetch('/api/update?ver='+encodeURIComponent(j.ver),{method:'POST',headers:{'Content-Type':'text/html; charset=utf-8'},body:j.html});if(!r.ok)throw new Error('السيرفر رفض التحديث (HTTP '+r.status+') — تأكد إن السيرفر محدّث');\n  try{save('تحديث البرنامج',APP_VER+' ← '+j.ver)}catch(e){}alert('تم تحديث السيرفر للإصدار '+j.ver+' ✓\\nكل الأجهزة المتصلة راح تتحدث تلقائياً.');setTimeout(()=>location.reload(),300);return}\n // وضع الملف المحلي: الكتابة فوق ملف البرنامج نفسه\n if(typeof window.showSaveFilePicker==='function'){let h=await idbGet('appfile');try{if(h){let p=await h.queryPermission({mode:'readwrite'});if(p!=='granted')p=await h.requestPermission({mode:'readwrite'});if(p!=='granted')h=null}}catch(e){h=null}\n  if(!h){alert('بالنافذة الجاية اختار ملف البرنامج الحالي (ByteFuel.html) حتى ينكتب التحديث فوقه.');try{h=await window.showSaveFilePicker({suggestedName:'ByteFuel.html',types:[{description:'Byte Fuel',accept:{'text/html':['.html']}}]})}catch(e){if(e&&e.name==='AbortError')return;h=null}}\n  if(h){const w=await h.createWritable();await w.write(new Blob([j.html],{type:'text/html'}));await w.close();await idbSet('appfile',h);try{save('تحديث البرنامج',APP_VER+' ← '+j.ver)}catch(e){}alert('تم التحديث للإصدار '+j.ver+' ✓\\nإذا ما انفتح الإصدار الجديد، سكّر البرنامج وافتح ملف ByteFuel.html مرة ثانية.');location.reload();return}}\n const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([j.html],{type:'text/html'}));a.download='ByteFuel.html';a.click();alert('انزل ملف ByteFuel.html الجديد. انقله مكان الملف القديم (استبدال)، وبعدها افتح البرنامج. بياناتك تبقى.')}\nfunction updBox(){const i=UPD.info,nw=i&&verCmp(i.ver,APP_VER)>0;\n return`<div class=\"box\"><h3>${gi('power',19)} التحديثات</h3>\n <div class=\"sum\"><div><span>الإصدار الحالي</span><b>${APP_VER}</b></div><div><span>آخر إصدار متوفر</span><b>${i?esc(i.ver):'—'}</b></div><div><span>طريقة التحديث</span><b style=\"font-size:14px\">${NET.on?'عبر السيرفر (كل الأجهزة)':'ملف البرنامج على هذا الجهاز'}</b></div></div>\n ${UPD.err?`<div class=\"warn\">${esc(UPD.err)}</div>`:''}\n ${i?(nw?`<div class=\"lics tr\">يتوفر تحديث جديد: <b>${esc(i.ver)}</b>${i.date?' — '+esc(i.date):''}${i.notes?`<div style=\"font-weight:500;margin-top:6px;white-space:pre-line\">${esc(i.notes)}</div>`:''}</div><button class=\"btn g\" ${UPD.busy?'disabled':''} onclick=\"updOnline()\">${ic('power',18)} تحميل وتثبيت التحديث</button>`:`<div class=\"lics ok\">✓ البرنامج محدّث لآخر إصدار</div>`):''}\n <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn\" ${UPD.busy?'disabled':''} onclick=\"updCheck()\">${UPD.busy?'جاري الفحص...':'فحص التحديثات من الإنترنت'}</button>\n <label class=\"btn o\" style=\"cursor:pointer\">تثبيت تحديث من ملف .buc<input type=\"file\" accept=\".buc\" style=\"display:none\" onchange=\"updFile(this)\"></label></div>\n <p style=\"color:var(--mut);font-size:12.5px;margin-top:10px\">التحديث يغيّر البرنامج فقط، والبيانات تبقى مثل ما هي. قبل التثبيت تنزل نسخة احتياطية تلقائياً.${NET.on?' بوضع السيرفر يتحدث ملف البرنامج على السيرفر، وكل الأجهزة المتصلة تتحدث لوحدها خلال ثواني.':' بوضع الملف المحلي، أول مرة يطلب منك تختار ملف ByteFuel.html حتى ينكتب التحديث فوقه (Chrome أو Edge).'}</p></div>`}\n/* ================= المظهر: الخطوط وألوان الثيم ================= */\nconst FONTK='byte_fuel_font',THK='byte_fuel_theme';\nconst FONTS=[\n {k:'segoe',n:'Segoe UI (الافتراضي)',css:'\"Segoe UI\",Tahoma,Arial,sans-serif'},\n {k:'tahoma',n:'Tahoma',css:'Tahoma,\"Segoe UI\",Arial,sans-serif'},\n {k:'arial',n:'Arial',css:'Arial,\"Segoe UI\",Tahoma,sans-serif'},\n {k:'calibri',n:'Calibri',css:'Calibri,\"Segoe UI\",Tahoma,sans-serif'},\n {k:'simplified',n:'Simplified Arabic',css:'\"Simplified Arabic\",\"Segoe UI\",Tahoma,sans-serif'},\n {k:'traditional',n:'Traditional Arabic',css:'\"Traditional Arabic\",\"Segoe UI\",Tahoma,serif'},\n {k:'majalla',n:'Sakkal Majalla',css:'\"Sakkal Majalla\",\"Segoe UI\",Tahoma,sans-serif'},\n {k:'cairo',n:'Cairo',web:'Cairo'},{k:'tajawal',n:'Tajawal',web:'Tajawal'},{k:'almarai',n:'Almarai',web:'Almarai',w:'400;700;800'},\n {k:'plex',n:'IBM Plex Sans Arabic',web:'IBM Plex Sans Arabic'},{k:'kufi',n:'Noto Kufi Arabic',web:'Noto Kufi Arabic'},\n {k:'readex',n:'Readex Pro',web:'Readex Pro'},{k:'changa',n:'Changa',web:'Changa'},{k:'messiri',n:'El Messiri',web:'El Messiri'},\n {k:'harmattan',n:'Harmattan',web:'Harmattan'},{k:'amiri',n:'Amiri (نسخ)',web:'Amiri'}];\nFONTS.forEach(f=>{if(f.web)f.css=`\"BF-${f.k}\",\"Segoe UI\",Tahoma,sans-serif`});\nconst THEMES=[\n {k:'blue',n:'أزرق ملكي',d:['#0b2259','#081a44','#06143a'],a:['#1d6fe0','#2f8cff'],bg:'#e9eff8',th:'#e3ebf7',tx:'#0b2259'},\n {k:'green',n:'أخضر زمردي',d:['#064e3b','#053d2f','#032b21'],a:['#059669','#10b981'],bg:'#e8f5ef',th:'#dcf1e7',tx:'#064e3b'},\n {k:'purple',n:'بنفسجي',d:['#3b0764','#2e0550','#21033a'],a:['#7c3aed','#a855f7'],bg:'#f1ecfa',th:'#ebe2f8',tx:'#3b0764'},\n {k:'red',n:'أحمر عنابي',d:['#7f1d1d','#651515','#4a0f0f'],a:['#dc2626','#f43f5e'],bg:'#f9ecec',th:'#f6dfdf',tx:'#7f1d1d'},\n {k:'orange',n:'برتقالي نحاسي',d:['#7c2d12','#5f220d','#451908'],a:['#ea580c','#f59e0b'],bg:'#fbf1e8',th:'#f8e4d4',tx:'#7c2d12'},\n {k:'teal',n:'تركوازي',d:['#134e4a','#0f3d3a','#0a2c2a'],a:['#0d9488','#06b6d4'],bg:'#e7f4f3',th:'#d8efed',tx:'#134e4a'},\n {k:'gold',n:'أسود وذهبي',d:['#1c1917','#141210','#0c0a09'],a:['#b45309','#eab308'],bg:'#f4f1ea',th:'#ece6d8',tx:'#292524'},\n {k:'slate',n:'رمادي فحمي',d:['#1e293b','#172033','#0f172a'],a:['#475569','#64748b'],bg:'#eef1f5',th:'#e2e8f0',tx:'#1e293b'},\n {k:'pink',n:'وردي',d:['#831843','#6b1337','#500e29'],a:['#db2777','#ec4899'],bg:'#fbecf3',th:'#f8dfeb',tx:'#831843'}];\nconst getFont=()=>{try{return localStorage.getItem(FONTK)||'segoe'}catch(e){return'segoe'}};\nconst getTheme=()=>{try{return JSON.parse(localStorage.getItem(THK)||'null')||{k:'blue'}}catch(e){return{k:'blue'}}};\nconst LOOK={fontMsg:''};\nasync function loadWebFont(f,net){if(!f.web)return true;if(document.fonts&&[...document.fonts].some(x=>x.family==='BF-'+f.k))return true;\n let parts=await idbGet('font_'+f.k);\n if(!parts&&net){try{const css=await(await fetch(`https://fonts.googleapis.com/css2?family=${encodeURIComponent(f.web).replace(/%20/g,'+')}:wght@${f.w||'400;700'}&display=swap`)).text();\n   const re=/\\/\\*\\s*([\\w-]+)\\s*\\*\\/\\s*@font-face\\s*{([^}]*)}/g;let m;parts=[];\n   while(m=re.exec(css)){if(!/^(arabic|latin)$/.test(m[1]))continue;const b=m[2];const url=(b.match(/url\\(([^)]+)\\)/)||[])[1];if(!url)continue;const wt=(b.match(/font-weight:\\s*(\\d+)/)||[])[1]||'400',ur=(b.match(/unicode-range:\\s*([^;]+);/)||[])[1]||'';\n    const buf=await(await fetch(url.replace(/['\"]/g,''))).arrayBuffer();parts.push({wt,ur,buf})}\n   if(parts.length)await idbSet('font_'+f.k,parts);else parts=null}catch(e){parts=null}}\n if(!parts)return false;for(const p of parts){try{const ff=new FontFace('BF-'+f.k,p.buf,{weight:p.wt,unicodeRange:p.ur||undefined});await ff.load();document.fonts.add(ff)}catch(e){}}return true}\nasync function applyFont(k,net){const f=FONTS.find(x=>x.k===k)||FONTS[0];let ok=await loadWebFont(f,net);\n document.documentElement.style.setProperty('--ff',ok?f.css:FONTS[0].css);return ok}\nasync function setFont(k){const f=FONTS.find(x=>x.k===k);if(!f)return;LOOK.fontMsg=f.web?'جاري تحميل الخط...':'';render();const ok=await applyFont(k,true);\n if(ok){try{localStorage.setItem(FONTK,k)}catch(e){}LOOK.fontMsg=''}else LOOK.fontMsg='تعذر تحميل خط «'+f.n+'» — يحتاج اتصال بالإنترنت أول مرة فقط، وبعدها يشتغل بدون إنترنت.';render()}\nfunction themeCSS(t){if(t.k==='custom'){const c=t.c||'#1565d8';t={d:[`color-mix(in srgb,${c} 38%,#000)`,`color-mix(in srgb,${c} 28%,#000)`,`color-mix(in srgb,${c} 18%,#000)`],a:[c,`color-mix(in srgb,${c} 70%,#fff)`],bg:`color-mix(in srgb,${c} 9%,#f4f6f9)`,th:`color-mix(in srgb,${c} 14%,#fff)`,tx:`color-mix(in srgb,${c} 45%,#000)`}}\n const[d1,d2,d3]=t.d,[a1,a2]=t.a;\n return`:root{--nav:${d1};--nav2:${d2};--blue:${a1};--bg:${t.bg}}\n .side{background:linear-gradient(180deg,${d1},${d2} 60%,${d3})!important}\n .hero{background:linear-gradient(100deg,${d3} 0%,${d1} 45%,color-mix(in srgb,${a1} 55%,${d1}) 100%)!important}\n .nav a.on,.stabs a.on{background:linear-gradient(90deg,${a1},${a2})!important;box-shadow:0 4px 14px color-mix(in srgb,${a1} 50%,transparent)!important}\n .stabs{background:linear-gradient(180deg,${d1},${d2})!important}.tabs a.on{background:${d2}!important;border-color:${d2}!important}\n .ptitle h2,.box h3,.ddt,.tank.gt .th b,.tank.gt .q{color:${t.tx}!important}th{background:${t.th}!important;color:${t.tx}!important}\n .login{background:linear-gradient(135deg,${d3},${d1} 50%,${a1})!important}.lbox .lg{color:${t.tx}!important}.devc{background:${d1}!important}\n .foot,.logo{border-color:color-mix(in srgb,#fff 10%,transparent)!important}.topbar{background:color-mix(in srgb,${d3} 82%,transparent)!important}.sd .sl,.dd-sd .sl{background:${d2}!important}`}\nconst CMX_OK=(()=>{try{return CSS.supports('color','color-mix(in srgb,red 50%,blue)')}catch(e){return false}})();\nfunction CMX(css){if(CMX_OK)return css;const P=c=>{c=c.trim().toLowerCase();if(c==='transparent')return[0,0,0,0];if(c[0]==='#'){let h=c.slice(1);if(h.length===3)h=h.split('').map(x=>x+x).join('');return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16),1]}return null};\n const R=/color-mix\\(in srgb,\\s*([#a-z0-9]+)\\s+(\\d+(?:\\.\\d+)?)%\\s*,\\s*([#a-z0-9]+)\\s*\\)/gi;let prev;\n do{prev=css;css=css.replace(R,(m,a,p,b)=>{const A=P(a),B=P(b);if(!A||!B)return m;const k=+p/100,mx=i=>A[i]*A[3]*k+B[i]*B[3]*(1-k),al=A[3]*k+B[3]*(1-k);if(al<=0)return'transparent';const c=[0,1,2].map(i=>Math.round(mx(i)/al));return al>=0.999?'#'+c.map(x=>x.toString(16).padStart(2,'0')).join(''):`rgba(${c[0]},${c[1]},${c[2]},${+al.toFixed(3)})`})}while(css!==prev);return css}\nfunction applyTheme(t){t=t||getTheme();const T=t.k==='custom'?t:(THEMES.find(x=>x.k===t.k)||THEMES[0]);let el=document.getElementById('bf-theme');if(!el){el=document.createElement('style');el.id='bf-theme';document.head.appendChild(el)}el.textContent=T.k==='blue'?'':CMX(themeCSS(T))}\nfunction setTheme(k,c){const t=k==='custom'?{k,c:c||getTheme().c||'#1565d8'}:{k};try{localStorage.setItem(THK,JSON.stringify(t))}catch(e){}applyTheme(t);render()}\nfunction lookBox(){const cf=getFont(),th=getTheme(),sample='بايت لمحطات الوقود — 1,234,567 د.ع';\n const fc=f=>`<div class=\"fopt ${cf===f.k?'on':''}\" onclick=\"setFont('${f.k}')\" style=\"font-family:${f.css.replace(/\"/g,\"'\")}\"><b>${esc(f.n)}</b><span>${sample}</span>${f.web?`<small>${'خط من الإنترنت (يتحمل مرة وحدة)'}</small>`:'<small>خط الجهاز</small>'}</div>`;\n return`<div class=\"box\"><h3>${gi('list',19)} ألوان الثيم</h3><div class=\"thg\">${THEMES.map(t=>`<div class=\"thopt ${th.k===t.k?'on':''}\" onclick=\"setTheme('${t.k}')\"><div class=\"thp\" style=\"background:linear-gradient(135deg,${t.d[0]},${t.d[2]})\"><i style=\"background:linear-gradient(90deg,${t.a[0]},${t.a[1]})\"></i><i style=\"background:${t.bg}\"></i></div><b>${esc(t.n)}</b></div>`).join('')}\n <div class=\"thopt ${th.k==='custom'?'on':''}\"><div class=\"thp\" style=\"background:${th.c||'#1565d8'}\"><input type=\"color\" value=\"${esc(th.c||'#1565d8')}\" oninput=\"setTheme('custom',this.value)\" title=\"اختار لون\"></div><b>لون مخصص</b></div></div>\n <p style=\"color:var(--mut);font-size:12.5px;margin:8px 0 0\">الثيم والخط ينحفظون على هذا الجهاز، وكل جهاز يكدر يختار شكله.</p></div>\n <div class=\"box\"><h3>${gi('list',19)} الخط</h3>${LOOK.fontMsg?`<div class=\"warn\">${esc(LOOK.fontMsg)}</div>`:''}<div class=\"fg\">${FONTS.map(fc).join('')}</div></div>`}\n\n/* ================= الترخيص والسيريل ================= */\n/* BYTE-LIC core: SHA-256 + ECDSA P-256 (pure JS, BigInt) + base32 */\nconst BL=(()=>{\nconst K=new Uint32Array([0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]);\nfunction sha256(msg){const m=typeof msg==='string'?new TextEncoder().encode(msg):msg;const l=m.length,bl=((l+9+63)>>6)<<6,b=new Uint8Array(bl);b.set(m);b[l]=0x80;const bits=l*8;const dv=new DataView(b.buffer);dv.setUint32(bl-4,bits>>>0);dv.setUint32(bl-8,Math.floor(bits/4294967296));\n const H=new Uint32Array([0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19]),W=new Uint32Array(64);const r=(x,n)=>(x>>>n)|(x<<(32-n));\n for(let o=0;o<bl;o+=64){for(let i=0;i<16;i++)W[i]=dv.getUint32(o+i*4);for(let i=16;i<64;i++){const s0=r(W[i-15],7)^r(W[i-15],18)^(W[i-15]>>>3),s1=r(W[i-2],17)^r(W[i-2],19)^(W[i-2]>>>10);W[i]=(W[i-16]+s0+W[i-7]+s1)>>>0}\n  let[a,b2,c,d,e,f,g,h]=H;for(let i=0;i<64;i++){const S1=r(e,6)^r(e,11)^r(e,25),ch=(e&f)^(~e&g),t1=(h+S1+ch+K[i]+W[i])>>>0,S0=r(a,2)^r(a,13)^r(a,22),mj=(a&b2)^(a&c)^(b2&c),t2=(S0+mj)>>>0;h=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b2;b2=a;a=(t1+t2)>>>0}\n  H[0]+=a;H[1]+=b2;H[2]+=c;H[3]+=d;H[4]+=e;H[5]+=f;H[6]+=g;H[7]+=h}\n const out=new Uint8Array(32),ov=new DataView(out.buffer);H.forEach((x,i)=>ov.setUint32(i*4,x));return out}\nconst P=0xffffffff00000001000000000000000000000000ffffffffffffffffffffffffn,N=0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551n,\n G=[0x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296n,0x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5n,1n];\nconst md=(a,m=P)=>{a%=m;return a<0n?a+m:a};\nfunction pw(b,e,m){let r=1n;b=md(b,m);while(e>0n){if(e&1n)r=r*b%m;b=b*b%m;e>>=1n}return r}\nconst inv=(a,m=P)=>pw(a,m-2n,m);\nfunction dbl(p){const[X,Y,Z]=p;if(Z===0n||Y===0n)return[0n,1n,0n];const de=Z*Z%P,ga=Y*Y%P,be=X*ga%P,al=3n*md(X-de)*(X+de)%P;const X3=md(al*al-8n*be),Z3=md((Y+Z)*(Y+Z)-ga-de),Y3=md(al*md(4n*be-X3)-8n*ga*ga);return[X3,Y3,Z3]}\nfunction add(p,q){if(p[2]===0n)return q;if(q[2]===0n)return p;const[X1,Y1,Z1]=p,[X2,Y2,Z2]=q;const z1=Z1*Z1%P,z2=Z2*Z2%P,U1=X1*z2%P,U2=X2*z1%P,S1=Y1*z2*Z2%P,S2=Y2*z1*Z1%P;\n if(U1===U2)return S1===S2?dbl(p):[0n,1n,0n];const H=md(U2-U1),R=md(S2-S1),H2=H*H%P,H3=H2*H%P,X3=md(R*R-H3-2n*U1*H2),Y3=md(R*md(U1*H2-X3)-S1*H3),Z3=H*Z1*Z2%P;return[X3,Y3,Z3]}\nfunction mul(k,p){let r=[0n,1n,0n],a=p;while(k>0n){if(k&1n)r=add(r,a);a=dbl(a);k>>=1n}return r}\nfunction aff(p){if(p[2]===0n)return null;const zi=inv(p[2]),z2=zi*zi%P;return[p[0]*z2%P,p[1]*z2*zi%P]}\nconst b2n=b=>{let x=0n;for(const v of b)x=(x<<8n)|BigInt(v);return x};\nconst n2b=(x,l=32)=>{const o=new Uint8Array(l);for(let i=l-1;i>=0;i--){o[i]=Number(x&255n);x>>=8n}return o};\nfunction verify(msg,sig,Qx,Qy){const r=b2n(sig.slice(0,32)),s=b2n(sig.slice(32,64));if(r<1n||r>=N||s<1n||s>=N)return false;const z=b2n(sha256(msg))%N,w=inv(s,N),u1=z*w%N,u2=r*w%N;\n const X=aff(add(mul(u1,G),mul(u2,[Qx,Qy,1n])));return!!X&&X[0]%N===r}\nfunction sign(msg,d){const z=b2n(sha256(msg))%N;for(;;){const kb=new Uint8Array(32);crypto.getRandomValues(kb);const k=b2n(kb)%N;if(!k)continue;const R=aff(mul(k,G));const r=R[0]%N;if(!r)continue;const s=inv(k,N)*(z+r*d)%N;if(!s)continue;const o=new Uint8Array(64);o.set(n2b(r),0);o.set(n2b(s),32);return o}}\nfunction pub(d){const Q=aff(mul(d,G));return Q}\nconst AL='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nfunction b32e(b){let bits=0,v=0,o='';for(const x of b){v=(v<<8)|x;bits+=8;while(bits>=5){o+=AL[(v>>>(bits-5))&31];bits-=5}}if(bits>0)o+=AL[(v<<(5-bits))&31];return o}\nfunction b32d(s){s=String(s).toUpperCase().replace(/O/g,'0').replace(/[^A-Z2-9]/g,'').replace(/[IO01]/g,'');let bits=0,v=0;const o=[];for(const c of s){const i=AL.indexOf(c);if(i<0)continue;v=((v<<5)|i)&0xffff;bits+=5;if(bits>=8){o.push((v>>>(bits-8))&255);bits-=8}}return new Uint8Array(o)}\nconst grp=(s,n)=>s.match(new RegExp('.{1,'+n+'}','g')).join('-');\nconst normDev=c=>String(c||'').toUpperCase().replace(/[^A-Z2-9]/g,'');\nconst devHash=c=>sha256('BYTE-FUEL-DEV|'+normDev(c)).slice(0,8);\nconst EPOCH=Date.UTC(2024,0,1),dayNo=t=>Math.floor((t-EPOCH)/864e5),dayDate=n=>new Date(EPOCH+n*864e5);\nconst TYPES={1:['اشتراك شهري',30],2:['اشتراك سنوي',365],3:['دائمي (مدى الحياة)',0],4:['مدة مخصصة',0]};\nfunction makePayload(dev,type,days,issue){const p=new Uint8Array(16);p[0]=0x46;p[1]=type;const dd=type===1?30:type===2?365:type===3?0:days;p[2]=(dd>>8)&255;p[3]=dd&255;const i=issue==null?dayNo(Date.now()):issue;p[4]=(i>>8)&255;p[5]=i&255;p.set(devHash(dev),6);const rn=new Uint8Array(2);crypto.getRandomValues(rn);p.set(rn,14);return p}\nfunction parseSerial(serial,dev,Qx,Qy){const b=b32d(serial);if(b.length<80)return{ok:false,err:'السيريل ناقص أو غير صحيح'};const p=b.slice(0,16),sg=b.slice(16,80);\n if(p[0]!==0x46)return{ok:false,err:'السيريل مو لهذا البرنامج'};if(!verify(p,sg,Qx,Qy))return{ok:false,err:'السيريل غير صحيح'};\n const dh=devHash(dev);for(let i=0;i<8;i++)if(dh[i]!==p[6+i])return{ok:false,err:'السيريل مو لهذا الجهاز (رمز الجهاز مختلف)'};\n const type=p[1],days=(p[2]<<8)|p[3],issue=(p[4]<<8)|p[5];const exp=type===3?null:dayDate(issue+days+1);return{ok:true,type,days,issue:dayDate(issue),exp,name:(TYPES[type]||['?'])[0]}}\nreturn{sha256,verify,sign,pub,b32e,b32d,grp,normDev,devHash,makePayload,parseSerial,TYPES,b2n,n2b,dayNo,dayDate,AL}})();\n\n\nconst LIC_Q=[0xf86bbf9f80131236c836c2b8f82f12d45f13caabc657214042a600cafe7cb959n,0x5373bb932500f3470725b7e7f932f976fcfdca7dab2d93496b7ca74bb75bac9fn];const LK='byte_fuel_lic',DK2='byte_fuel_dev',TK='byte_fuel_t0',SKL='byte_fuel_seen',TRIAL_DAYS=7,WA='9647867492096';\nconst LIC={dev:'',serial:'',t0:0,seen:0,st:null,skip:(()=>{try{return sessionStorage.getItem('byte_fuel_tok')==='1'}catch(e){return false}})()};\nfunction newDev(){const b=new Uint8Array(10);crypto.getRandomValues(b);return BL.grp(BL.b32e(b).slice(0,16),4)}\nasync function licInit(){let dev='',ser='',t0=0,seen=0;try{dev=localStorage.getItem(DK2)||'';ser=localStorage.getItem(LK)||'';t0=+localStorage.getItem(TK)||0;seen=+localStorage.getItem(SKL)||0}catch(e){}\n const I=await idbGet('lic')||{};dev=dev||I.dev||'';ser=ser||I.serial||'';t0=Math.min(...[t0,I.t0].filter(x=>x>0).concat([Date.now()]));seen=Math.max(seen,+I.seen||0);\n if(NET.on&&NET.info&&NET.info.mid){dev=BL.grp(BL.b32e(BL.sha256('BYTE-FUEL|'+NET.info.mid)).slice(0,16),4);ser=(db.settings.lic||'');const ft=NET.info.first?Date.parse(NET.info.first):0;t0=Math.min(...[ft,+db.settings.t0||0].filter(x=>x>0).concat([Date.now()]));seen=Math.max(seen,+db.settings.seen||0)}\n if(!dev)dev=newDev();LIC.dev=dev;LIC.serial=ser;LIC.t0=t0;LIC.seen=seen;licStore();licEval()}\nfunction licStore(){try{if(!NET.on){localStorage.setItem(DK2,LIC.dev);if(LIC.serial)localStorage.setItem(LK,LIC.serial)}localStorage.setItem(TK,String(LIC.t0));localStorage.setItem(SKL,String(Math.max(LIC.seen,Date.now())))}catch(e){}\n idbSet('lic',{dev:NET.on?'':LIC.dev,serial:NET.on?'':LIC.serial,t0:LIC.t0,seen:Math.max(LIC.seen,Date.now())});\n if(NET.on&&db){let ch=false;if(+db.settings.t0!==LIC.t0&&(!db.settings.t0||LIC.t0<db.settings.t0)){db.settings.t0=LIC.t0;ch=true}const sd=Math.floor(Date.now()/864e5)*864e5;if((+db.settings.seen||0)<sd){db.settings.seen=sd;ch=true}if(ch)persist()}}\nfunction licEval(){if(NET.on&&db)LIC.serial=db.settings.lic||'';const now=Date.now();const back=LIC.seen&&now<LIC.seen-36*3600e3;let s={ok:false,trial:false,left:0,msg:'',lic:null,back};\n if(LIC.serial){const r=BL.parseSerial(LIC.serial,LIC.dev,LIC_Q[0],LIC_Q[1]);if(r.ok){s.lic=r;if(back)s.msg='تاريخ الجهاز مرجوع لورا — صحّح التاريخ والوقت';else if(r.exp&&now>r.exp.getTime())s.msg='انتهى الاشتراك بتاريخ '+fmtDate(today(r.exp));else{s.ok=true;s.left=r.exp?Math.ceil((r.exp.getTime()-now)/864e5):null}}else s.msg=r.err}\n if(!s.ok){const left=Math.ceil((LIC.t0+TRIAL_DAYS*864e5-now)/864e5);if(!back&&left>0&&!s.lic){s.trial=true;s.left=left}else if(!s.msg)s.msg=back?'تاريخ الجهاز مرجوع لورا — صحّح التاريخ والوقت':'انتهت الفترة التجريبية ('+TRIAL_DAYS+' أيام)'}\n LIC.st=s;return s}\nfunction activate(serial){const r=BL.parseSerial(serial,LIC.dev,LIC_Q[0],LIC_Q[1]);if(!r.ok){alert(r.err);return false}if(r.exp&&Date.now()>r.exp.getTime()){alert('هذا السيريل منتهي بتاريخ '+fmtDate(today(r.exp)));return false}\n LIC.serial=BL.normDev(serial);if(NET.on){db.settings.lic=LIC.serial;persist()}licStore();licEval();try{save('تفعيل البرنامج',r.name+(r.exp?' — لغاية '+today(r.exp):''))}catch(e){}alert('تم تفعيل البرنامج ✓\\n'+r.name+(r.exp?'\\nلغاية: '+fmtDate(today(r.exp)):''));return true}\nfunction licWA(){const m=encodeURIComponent('السلام عليكم، أريد تفعيل برنامج بايت لمحطات الوقود\\nرمز الجهاز: '+LIC.dev+'\\nاسم المحطة: '+(db&&db.settings.name||''));return'https://wa.me/'+WA+'?text='+m}\nfunction copyTxt(t){try{navigator.clipboard.writeText(t).then(()=>alert('تم النسخ'),()=>prompt('انسخ:',t))}catch(e){prompt('انسخ:',t)}}\nfunction licPanel(compact){const s=LIC.st||licEval();const L=s.lic;\n return`<div class=\"licp\">${s.ok?`<div class=\"lics ok\">✓ البرنامج مفعّل — ${esc(L.name)}${L.exp?` — لغاية <b>${fmtDate(today(L.exp))}</b> (متبقي ${s.left} يوم)`:''}</div>`:s.trial?`<div class=\"lics tr\">نسخة تجريبية — متبقي <b>${s.left}</b> ${s.left===1?'يوم':'أيام'}</div>`:`<div class=\"lics bad\">⚠ ${esc(s.msg)}</div>`}\n <div class=\"f\" style=\"margin:10px 0\"><label>رمز الجهاز (ابعثه للبائع حتى يطلعلك السيريل)</label><div class=\"row\" style=\"align-items:center\"><b class=\"devc\" dir=\"ltr\">${esc(LIC.dev)}</b><button class=\"btn sm s\" onclick=\"copyTxt(LIC.dev)\">نسخ</button><a class=\"btn sm g\" target=\"_blank\" rel=\"noopener\" href=\"${licWA()}\">إرسال واتساب</a></div></div>\n ${NET.on?`<p style=\"color:var(--mut);font-size:12px;margin:0 0 6px\">بوضع السيرفر: سيريل واحد للسيرفر يشمل كل الأجهزة المتصلة بيه.</p>`:''}\n <div class=\"f\"><label>السيريل</label><textarea id=\"licIn\" rows=\"3\" dir=\"ltr\" style=\"font-family:Consolas,monospace;letter-spacing:1px\" placeholder=\"الصق السيريل هنا\"></textarea></div>\n <div class=\"row\" style=\"margin-top:8px\"><button class=\"btn g\" onclick=\"if(activate(V('licIn')))render()\">${ic('lock',18)} تفعيل</button>${compact&&s.trial?`<button class=\"btn s\" onclick=\"LIC.skip=true;try{sessionStorage.setItem('byte_fuel_tok','1')}catch(e){}render()\">متابعة الفترة التجريبية</button>`:''}</div>\n <p style=\"color:var(--mut);font-size:12px;margin-top:10px\">للشراء والتفعيل: واتساب <b dir=\"ltr\">+964 786 749 2096</b></p></div>`}\nfunction gateView(){$('#root').innerHTML=`<div class=\"login\"><div class=\"lbox\" style=\"width:min(560px,94%)\"><div class=\"lg bw\">BYTE<sup>®</sup></div><p>بايت لمحطات الوقود — تفعيل البرنامج</p>${licPanel(true)}<div class=\"copy\">${COPY}</div></div></div>`}\n\n/* ================= بيانات تجريبية (مؤقتة) ================= */\nconst DK=['users','employees','tanks','disps','pumps','shifts','sales','receipts','dips','items','moves','suppliers','customers','debts','cash','advances','payroll','log'];\nconst demoCount=()=>DK.reduce((a,k)=>a+(db[k]||[]).filter(x=>x&&x.demo&&k!=='log').length,0);\nfunction loadDemo(silent){if(db.settings.demoLoaded){if(!silent)alert('البيانات التجريبية محملة مسبقاً');return}\n if(!silent&&!confirm('تحميل بيانات تجريبية للعرض؟ تقدر تمسحها لاحقاً من الإعدادات.'))return;\n while(db.fuels.length<3)db.fuels.push({id:uid(),name:'وقود '+(db.fuels.length+1),price:0,cost:0,color:'#0ea5e9'});DEMO=true;\n try{const dm=o=>Object.assign(o,{id:uid(),demo:true});const day=n=>{const x=new Date();x.setDate(x.getDate()-n);return today(x)};const rnd=a=>a[Math.floor(Math.random()*a.length)];\n const[f1,f2,f3]=db.fuels;db.settings.demoFuels={};[[f1,1100,950],[f2,1250,1080],[f3,850,720]].forEach(([f,p,c])=>{db.settings.demoFuels[f.id]={oldPrice:f.price,oldCost:f.cost,price:p,cost:c};f.price=p;f.cost=c});\n // الخزانات والمضخات\n const T=[dm({name:'خزان البنزين العادي',fuelId:f1.id,capacity:50000,qty:0}),dm({name:'خزان البنزين المحسن',fuelId:f2.id,capacity:50000,qty:0}),dm({name:'خزان الكاز',fuelId:f3.id,capacity:50000,qty:0})];db.tanks.push(...T);\n [['المضخة 1',T[1],152340,149870,true,'A'],['المضخة 2',T[0],98110,96540,true,'A'],['المضخة 3',T[2],76420,74100,true,'B'],['المضخة 4',T[0],45000,44210,false,'C']].forEach(([n,t,r,l,on,ln])=>{const d=dm({name:n,lane:ln});db.disps.push(d);\n  db.pumps.push(dm({name:n+' — يمين',dispId:d.id,side:'R',tankId:t.id,fuelId:t.fuelId,meter:r,active:on}),dm({name:n+' — يسار',dispId:d.id,side:'L',tankId:t.id,fuelId:t.fuelId,meter:l,active:on}))});\n // الموظفون\n const E=[['علي حسين','عامل مضخة','07701234561',600000,'2024-03-01'],['مصطفى كريم','عامل مضخة','07801234562',600000,'2024-06-15'],['حيدر عباس','عامل مضخة','07711234563',600000,'2025-01-10'],\n  ['محمد صالح','عامل مضخة (شفت ليلي)','07821234564',650000,'2025-02-01'],['أحمد جاسم','محاسب','07701234565',850000,'2023-09-01'],['زينب علي','كاشير','07731234566',700000,'2025-04-20'],\n  ['سجاد فاضل','حارس ليلي','07751234567',450000,'2024-11-01'],['كرار ناصر','عامل غسل سيارات','07761234568',500000,'2025-07-01']].map(([name,job,phone,salary,start])=>dm({name,job,phone,salary,start,active:true}));\n db.employees.push(...E);\n // الموردين والعملاء\n const S=[dm({name:'شركة توزيع المنتجات النفطية',phone:'07801111111',kind:'وقود',opening:0}),dm({name:'مكتب الرافدين لتجارة الزيوت',phone:'07702222222',kind:'زيوت ومواد',opening:250000})];db.suppliers.push(...S);\n const C=[dm({name:'شركة النقل السريع',phone:'07700000000',opening:0,limit:5000000,note:''}),dm({name:'مولدة الحي',phone:'07803333333',opening:150000,limit:0,note:''}),dm({name:'مكتب تكسي الأمل',phone:'07714444444',opening:0,limit:1000000,note:''})];db.customers.push(...C);\n // المواد\n const IT=[['دهن محرك 4 لتر','علبة',40,25000,19000,5],['دهن محرك 1 لتر','علبة',60,8000,6000,10],['دهن گير 1 لتر','علبة',30,9000,6500,5],['فلتر دهن','قطعة',25,7000,4500,5],\n  ['فلتر هواء','قطعة',20,10000,7000,4],['فلتر بنزين','قطعة',4,8000,5500,5],['ماء راديتر 4 لتر','علبة',35,4000,2500,6],['سائل فرامل','علبة',18,6000,4000,4],['ماء مساحات','قنينة',50,2500,1500,10],\n  ['بطارية 70 أمبير','قطعة',6,95000,80000,2],['طقم بواجي','طقم',12,20000,14000,3],['معطر سيارة','قطعة',45,2500,1200,10],['مناديل ورقية','علبة',70,1500,900,15]].map(([name,unit,qty,price,cost,min])=>dm({name,unit,qty,price,cost,min}));\n db.items.push(...IT);\n const mv=(d,i,q,pay,cid)=>{const m=dm({date:d,type:'out',itemId:i.id,qty:q,price:i.price,amount:r2(q*i.price),cost:i.cost,note:'',by:'النظام',pay,customerId:cid||''});i.qty=r2(i.qty-q);db.moves.push(m);if(pay==='cash')addCash({type:'in',kind:'stock',amount:m.amount,ref:m.id,date:d,note:'بيع '+i.name+' × '+fmt(q)})};\n // مبيعات آخر 7 أيام\n const ap=db.pumps.filter(p=>p.active);for(let i=6;i>=0;i--){const d=day(i);const n=8+Math.round(Math.random()*6)+(6-i);for(let k=0;k<n;k++){const p=ap[k%ap.length];const l=rnd([20,30,40,50,60,80,100])*(1+Math.round(Math.random()*2));\n  const h=String(7+Math.floor(k*14/n)).padStart(2,'0')+':'+String(Math.floor(Math.random()*60)).padStart(2,'0');const cr=k%9===4;mkSale({pumpId:p.id,liters:l,pay:cr?'credit':'cash',customerId:cr?C[k%2===0?0:2].id:'',date:d,time:h,shiftId:''})}\n  for(let k=0;k<3;k++)mv(d,rnd(IT.slice(0,9).concat(IT.slice(11))),1+Math.floor(Math.random()*2),'cash');\n  if(i%2===0)addCash({type:'out',kind:'exp',cat:'مولدة',amount:75000,date:d,note:'وقود المولدة'});if(i===3)addCash({type:'out',kind:'exp',cat:'صيانة',amount:120000,date:d,note:'صيانة المضخة 4'});if(i%3===1)addCash({type:'in',kind:'rev',cat:'غسل سيارات',amount:45000,date:d,note:'غسل سيارات'})}\n mv(day(2),IT[0],4,'credit',C[0].id);\n // أرصدة الخزانات والصندوق والمشتريات\n [31500,36000,29000].forEach((q,i)=>T[i].qty=q);addCash({type:'in',kind:'cap',amount:10000000,date:day(7),note:'رأس مال افتتاحي'});\n db.receipts.push(dm({date:today(),inv:'1001',supplierId:S[0].id,tankId:T[1].id,fuelId:f2.id,liters:10000,cost:1080,total:10800000,paid:0,note:'تجريبي',by:'النظام'}));\n // سلف الموظفين\n [[E[0],50000,'سلفة شخصية'],[E[2],75000,'سلفة علاج'],[E[6],30000,'سلفة']].forEach(([e,a,n])=>{const v=dm({empId:e.id,date:day(3),amount:a,note:n});const c=addCash({type:'out',kind:'adv',amount:a,empId:e.id,date:v.date,note:'سلفة — '+e.name+' '+n});v.cashId=c.id;db.advances.push(v)});\n db.settings.demoLoaded=true;save('تحميل بيانات تجريبية','')}finally{DEMO=false}\n if(!silent)render()}\nfunction wipeDemo(){if(!demoCount()){alert('لا توجد بيانات تجريبية');return}\n const ids=new Set();DK.forEach(k=>(db[k]||[]).forEach(x=>{if(x&&x.demo)ids.add(x.id)}));\n if(db.shifts.some(s=>s.status==='open'&&s.readings.some(r=>ids.has(r.pumpId)))){alert('أكو شفت مفتوح على مضخة تجريبية — أغلقه أو ألغِه أولاً');return}\n if(!confirm('سيتم حذف جميع البيانات المؤقتة (التجريبية): الموظفين، المواد، الخزانات، المضخات، العملاء، الموردين، المبيعات، حركات الصندوق والسلف التجريبية.\\n\\nالبيانات اللي أدخلتها أنت تبقى. متابعة؟'))return;\n exportDB();\n DK.forEach(k=>{if(k!=='users'&&db[k])db[k]=db[k].filter(x=>!(x&&x.demo))});\n db.cash=db.cash.filter(c=>!(c.ref&&ids.has(c.ref)));db.advances.forEach(a=>{if(a.cashId&&ids.has(a.cashId))a.cashId=null});\n const df=db.settings.demoFuels||{};db.fuels.forEach(f=>{const o=df[f.id];if(!o)return;if(f.price===o.price)f.price=o.oldPrice||0;if(f.cost===o.cost)f.cost=o.oldCost||0});\n db.settings.demoFuels=null;db.settings.demoLoaded=false;db.settings.demoAuto=2;\n save('مسح جميع البيانات المؤقتة',ids.size+' سجل');alert('تم مسح جميع البيانات المؤقتة. البرنامج جاهز لإدخال بياناتك الفعلية.');render()}\n\n/* ================= تشغيل ================= */\napplyZoom(getZoom());applyPS(getPS());applyTheme();applyFont(getFont(),false);\nasync function boot(){if(/^https?:$/.test(location.protocol)){$('#root').innerHTML='<div class=\"login\"><div class=\"lbox\"><div class=\"lg bw\">BYTE<sup>®</sup></div><p>جاري الاتصال بالسيرفر...</p></div></div>';\n  try{await netInit()}catch(e){try{const r=await fetch('/api/ping',{cache:'no-store'});const j=await r.json();if(j.app==='byte-fuel')netLoadOffline();else load()}catch(x){if(localStorage.getItem(NETK))netLoadOffline();else load()}}}else load();\nif(db.settings.layoutV!==2){db.disps.forEach(d=>{delete d.px;delete d.py});db.settings.pumpLayout=false;db.settings.layoutV=2;persist()}if(db.settings.demoAuto!==2){if(!db.settings.demoLoaded)loadDemo(true);db.settings.demoAuto=2;persist()}\n{const sid=sessionStorage.getItem(SES);const u=sid&&byId(db.users,sid);if(u&&u.active!==false)me=u}\ninitBk();setTimeout(checkAutoBk,5000);\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#modal').style.display==='flex')closeM()});\nawait licInit();render();netBadge()}\nboot();\n</script>\n</body>\n</html>"}