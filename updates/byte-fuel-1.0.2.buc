{"app": "byte-fuel", "ver": "1.0.2", "date": "2026-11-19", "notes": "تصليح ألوان الخزانات والثيم على كل الأجهزة، ويشمل كل التحديثات السابقة", "sha256": "eaba3a579c21770711b8ab26e73e0c770ba71d564a29127c1a74043fcb39666a", "html": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>بايت لمحطات الوقود</title>\n<style>\n:root{--nav:#0a1f4d;--nav2:#0d2a66;--blue:#1565d8;--bg:#e9eff8;--card:#fff;--tx:#14213d;--mut:#64748b;--bd:#d6dfec;--red:#dc2626;--grn:#16a34a;--or:#f97316;--pur:#6d28d9}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%}\nbody{font-family:var(--ff,\"Segoe UI\",Tahoma,Arial,sans-serif);background:var(--bg);color:var(--tx);font-size:14px}\nbutton,input,select,textarea{font-family:inherit;font-size:14px}\n.app{display:flex;min-height:calc(100vh / var(--z,1))}\n/* sidebar */\n.side{width:250px;flex-shrink:0;background:linear-gradient(180deg,#0b2259,#081a44 60%,#06143a);color:#dbe6ff;display:flex;flex-direction:column;position:sticky;top:0;height:calc(100vh / var(--z,1));overflow:auto}\n.logo{padding:22px 18px 14px;text-align:center;border-bottom:1px solid rgba(255,255,255,.08)}\n.logo b{display:block;font-size:40px;letter-spacing:6px;font-weight:900;color:#fff;font-family:Arial Black,Arial,sans-serif;line-height:1}\n.logo span{font-size:17px;color:#cfe0ff}\n.nav{padding:10px 10px;flex:1}\n.nav a{display:flex;align-items:center;gap:12px;padding:11px 14px;margin:3px 0;border-radius:12px;color:#e6eeff;text-decoration:none;cursor:pointer;font-weight:600;font-size:15px;border-bottom:1px solid rgba(255,255,255,.05)}\n.nav a:hover{background:rgba(255,255,255,.07)}\n.nav a.on{background:linear-gradient(90deg,#1d6fe0,#2f8cff);color:#fff;box-shadow:0 4px 14px rgba(30,120,255,.45)}\n.nav a svg{flex-shrink:0;opacity:.95}\n.nav .out{color:#ffb4b4;margin-top:14px}\n.foot{font-size:11px;color:#8ea5d4;padding:10px 12px;text-align:center;border-top:1px solid rgba(255,255,255,.08)}\n/* main */\n.main{flex:1;min-width:0;display:flex;flex-direction:column}\n.hero{position:relative;height:230px;background:linear-gradient(100deg,#07194a 0%,#0c2d72 45%,#123b8f 100%);overflow:hidden;color:#fff}\n.hero .img{position:absolute;left:0;top:0;bottom:0;height:100%;width:auto;aspect-ratio:520/232;max-width:72%;background:url(data:image/jpeg;base64,) center/100% 100% no-repeat;-webkit-mask-image:linear-gradient(90deg,#000 80%,transparent);mask-image:linear-gradient(90deg,#000 80%,transparent)}\n.hero .ttl{position:absolute;right:28px;top:84px;text-align:right}\n.hero h1{margin:0;font-size:30px;display:flex;align-items:center;gap:12px}\n.hero p{margin:8px 0 0;color:#cfe0ff;font-size:15px}\n.topbar{position:absolute;right:28px;top:14px;display:flex;align-items:center;gap:14px;background:rgba(5,18,52,.72);padding:7px 14px;border-radius:12px;backdrop-filter:blur(4px)}\n.topbar .bell{position:relative;cursor:pointer;color:#ffd166}\n.topbar .bell i{position:absolute;top:-7px;left:-8px;background:var(--red);color:#fff;font-style:normal;font-size:11px;border-radius:10px;padding:1px 6px}\n.topbar .usr{display:flex;align-items:center;gap:8px;font-weight:700}\n.topbar .x{cursor:pointer;color:#ffb4b4}\n.burger{display:none;position:absolute;right:12px;top:12px;background:rgba(255,255,255,.15);border:0;color:#fff;border-radius:10px;padding:6px 8px;cursor:pointer}\n.content{padding:18px 20px 30px;flex:1}\n.ptitle{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 14px;flex-wrap:wrap}\n.ptitle h2{margin:0;font-size:21px;display:flex;align-items:center;gap:10px;color:#0b2259}\n/* cards */\n.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px}\n.kpi[onclick]{cursor:pointer;transition:transform .15s,box-shadow .15s}.kpi[onclick]:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(10,30,80,.28)}\n.kpis .kpi .v{font-size:clamp(18px,1.75vw,26px);white-space:nowrap}.kpis .kpi .t{font-size:clamp(13px,1.1vw,16px)}.kpis .kgi{width:54px;height:54px}.kpis .kgi svg{width:30px;height:30px}.kpi{gap:8px}\n.k5{background:linear-gradient(135deg,#be123c,#f43f5e)}.k7{background:linear-gradient(135deg,#b45309,#f59e0b)}.k8{background:linear-gradient(135deg,#1e40af,#06b6d4)}.k6{background:linear-gradient(135deg,#0f766e,#14b8a6)}\n.kpi{border-radius:16px;padding:16px 18px;color:#fff;display:flex;align-items:center;justify-content:space-between;box-shadow:0 6px 16px rgba(10,30,80,.18);border:2px solid rgba(255,255,255,.55);min-height:92px}\n.kpi .t{font-size:16px;font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,.35)}\n.kpi .v{font-size:27px;font-weight:800;margin-top:8px;direction:ltr;text-align:right;text-shadow:0 2px 4px rgba(0,0,0,.4)}\n.kpi .v small{font-size:15px;font-weight:600}\n.kpi svg{opacity:.95}\n.k1{background:linear-gradient(135deg,#0f9b3c,#22c55e)}\n.k2{background:linear-gradient(135deg,#ea580c,#fb923c)}\n.k3{background:linear-gradient(135deg,#0b3fa8,#2f7cf0)}\n.k4{background:linear-gradient(135deg,#4c1d95,#7c3aed)}\n.grid2{display:grid;grid-template-columns:1.15fr 1fr;gap:16px;margin-bottom:16px}\n.box{background:linear-gradient(180deg,#f7faff,#eef4fd);border:1px solid var(--bd);border-radius:16px;padding:14px 16px;box-shadow:0 4px 14px rgba(10,30,80,.07);margin-bottom:16px}\n.grid2 .box{margin-bottom:0}\n.box h3{margin:0 0 12px;font-size:18px;display:flex;align-items:center;gap:10px;color:#0b2259}\n.pumps{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px}\n.pump{background:#fff;border:1px solid var(--bd);border-radius:14px;padding:12px 8px;text-align:center}\n.pump.on{background:linear-gradient(180deg,#fff,#e9f8ee)}\n.pump b{display:block;font-size:15px;margin-bottom:6px}\n.pump .st{display:inline-block;margin-top:6px;padding:4px 16px;border-radius:8px;font-weight:700;cursor:pointer;border:0}\n.pump.on .st{background:#15803d;color:#fff}\n.pump.off .st{background:#e5e7eb;color:#374151;border:1px solid #cbd5e1}\n.pump small{display:block;color:var(--mut);font-size:12px;margin-top:4px;min-height:15px}\n.tanks{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}\n.tank{background:#fff;border:1px solid var(--bd);border-radius:14px;padding:12px 8px;text-align:center}\n.tank b{display:block;font-size:15px}\n.ring{width:96px;height:96px;border-radius:50%;margin:10px auto 8px;display:grid;place-items:center}\n.ring>div{width:78px;height:78px;border-radius:50%;background:#fff;position:relative;overflow:hidden;display:grid;place-items:center}\n.ring .liq{position:absolute;left:0;right:0;bottom:0;opacity:.85}\n.ring span{position:relative;font-weight:800;font-size:20px;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.45)}\n.tank .q{font-weight:800}\n.tank .c{color:var(--mut);font-size:12px}\n.chart{display:flex;align-items:flex-end;gap:12px;height:190px;padding:10px 6px 0;border-bottom:2px solid #94a3b8;direction:ltr}\n.bar{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%}\n.bar div{width:100%;max-width:46px;background:linear-gradient(180deg,#38a1ff,#1565d8);border-radius:4px 4px 0 0;min-height:2px}\n.bar em{font-style:normal;font-size:11px;color:var(--mut);margin-bottom:3px;white-space:nowrap}\n.blabels{display:flex;gap:12px;padding:5px 6px 0;direction:ltr}\n.blabels span{flex:1;text-align:center;font-size:12px;font-weight:600}\n/* tables */\n.tw{overflow:auto;border-radius:10px;border:1px solid var(--bd);background:#fff}\ntable{width:100%;border-collapse:collapse}\nth{background:#e3ebf7;color:#0b2259;font-weight:700;padding:9px 8px;text-align:right;white-space:nowrap;position:sticky;top:0}\ntd{padding:8px;border-top:1px solid #edf1f7;white-space:nowrap}\ntr:hover td{background:#f5f9ff}\n.num{direction:ltr;text-align:right;font-variant-numeric:tabular-nums}\n.neg{color:var(--red);font-weight:700}\n.pos{color:var(--grn);font-weight:700}\n.tag{display:inline-block;padding:2px 9px;border-radius:7px;font-size:12px;font-weight:700}\n.tg{background:#dcfce7;color:#166534}.tr{background:#fee2e2;color:#991b1b}.tb{background:#dbeafe;color:#1e40af}.ty{background:#fef3c7;color:#92400e}.tx{background:#e5e7eb;color:#374151}\n.dot{display:inline-block;width:10px;height:10px;border-radius:3px;margin-left:6px;vertical-align:middle}\n/* forms */\n.btn{background:var(--blue);color:#fff;border:0;border-radius:10px;padding:8px 16px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px}\n.btn:hover{filter:brightness(1.08)}\n.btn.g{background:var(--grn)}.btn.r{background:var(--red)}.btn.o{background:var(--or)}.btn.s{background:#e2e8f0;color:#0f172a}\n.btn.sm{padding:4px 10px;font-size:12.5px;border-radius:8px}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}\n.f{display:flex;flex-direction:column;gap:4px;min-width:130px;flex:1}\n.f label{font-size:12.5px;color:var(--mut);font-weight:600}\n.f input,.f select,.f textarea{border:1px solid #c7d2e3;border-radius:9px;padding:8px 10px;background:#fff;width:100%}\n.f input:focus,.f select:focus,.f textarea:focus{outline:2px solid #93c5fd;border-color:#60a5fa}\n.tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}\n.tabs a{padding:7px 16px;border-radius:10px;background:#fff;border:1px solid var(--bd);cursor:pointer;font-weight:700;color:#334155}\n.tabs a.on{background:var(--nav2);color:#fff;border-color:var(--nav2)}\n.sum{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;margin-bottom:12px}\n.sum div{background:#fff;border:1px solid var(--bd);border-radius:12px;padding:10px 12px}\n.sum span{display:block;color:var(--mut);font-size:12.5px}\n.sum b{font-size:19px;direction:ltr;display:block;text-align:right}\n.empty{padding:26px;text-align:center;color:var(--mut)}\n.warn{background:#fff7ed;border:1px solid #fdba74;color:#9a3412;border-radius:12px;padding:10px 14px;margin-bottom:12px}\n/* modal */\n#modal{position:fixed;inset:0;background:rgba(8,20,50,.55);display:none;align-items:flex-start;justify-content:center;z-index:50;overflow:auto;padding:30px 10px}\n.mbox{background:#fff;border-radius:16px;width:min(720px,100%);box-shadow:0 20px 50px rgba(0,0,0,.3)}\n.mbox h3{margin:0;padding:14px 18px;background:var(--nav2);color:#fff;border-radius:16px 16px 0 0;font-size:17px}\n.mbody{padding:16px 18px}\n.mfoot{padding:12px 18px;border-top:1px solid var(--bd);display:flex;gap:8px;justify-content:flex-start}\n.chk{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:6px}\n.chk label{display:flex;gap:6px;align-items:center;background:#f8fafc;border:1px solid var(--bd);border-radius:8px;padding:6px 8px;cursor:pointer}\n/* login */\n.login{min-height:calc(100vh / var(--z,1));display:grid;place-items:center;background:linear-gradient(135deg,#06143a,#0d2a66 50%,#1565d8)}\n.lbox{background:#fff;border-radius:20px;padding:28px;width:min(380px,92%);box-shadow:0 25px 60px rgba(0,0,0,.35);text-align:center}\n.lbox .lg{font-size:44px;font-weight:900;letter-spacing:6px;color:#0b2259;font-family:Arial Black,Arial,sans-serif}\n.lbox p{color:var(--mut);margin:4px 0 18px}\n.lbox .f{margin-bottom:10px;text-align:right}\n.copy{font-size:12px;color:var(--mut);margin-top:16px}\n.pumps{position:relative}\n.pump{position:relative;overflow:hidden;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}\n.pump .hb{position:absolute;bottom:0;right:0;height:5px;width:0;background:linear-gradient(90deg,#22c55e,#1565d8);border-radius:0 0 14px 14px}\n.pump.holding{transform:scale(.97);transition:transform 5s}\n.pump.holding .hb{width:100%;transition:width 5s linear}\n.pumps.free{display:block;min-height:170px;transition:height .2s}\n.pumps.free .pump{position:absolute;width:auto}\n.ln{display:inline-block;min-width:22px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;color:#fff;font-weight:900;border-radius:6px;padding:0 6px;font-size:12.5px;line-height:20px;box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 1px 3px rgba(0,0,0,.25);vertical-align:middle}.ln.big{font-size:15px;line-height:24px;min-width:28px}\n.lnh{display:flex;align-items:center;gap:8px;margin:10px 0 6px;padding:5px 10px;border-radius:9px;color:#fff;font-weight:800}.lnh label{margin-right:auto;font-weight:600;font-size:12.5px;display:flex;gap:4px;align-items:center;cursor:pointer}\n.chk label.lnl{border-right:5px solid var(--lc);white-space:nowrap}.lnh+.chk{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}\n.pumps.disps{grid-template-columns:repeat(auto-fill,minmax(calc(230px * var(--ps,1)),1fr))}\n.pump.disp{padding:calc(10px * var(--ps,1)) calc(8px * var(--ps,1))}.pin{zoom:var(--ps,1);width:212px;margin:auto}\n.psz{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--mut)}.psz input{width:110px;accent-color:#1565d8}.psz b{min-width:40px;color:#0b2259}\n.pump.disp>b{margin-bottom:8px}\n.sides{display:flex;gap:6px}\n.sd{flex:1;border:1px solid var(--bd);border-radius:10px;padding:6px 4px 8px;background:#f8fafc;min-width:0}\n.sd.on{background:linear-gradient(180deg,#fff,#e9f8ee);border-color:#bbf7d0}\n.sd .sl{display:inline-block;font-size:11.5px;font-weight:800;color:#fff;background:#0d2a66;border-radius:6px;padding:1px 8px;margin-bottom:2px}\n.sd .pi{display:block}.sd .pi svg{filter:drop-shadow(0 3px 4px rgba(0,0,0,.25)) drop-shadow(0 0 8px currentColor)}\n.sd small{display:block;color:var(--mut);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sd small.w{color:#0b2259;font-weight:700}.sd small.tm{color:#1d4ed8;font-size:11px}.sd small.mt{direction:ltr;text-align:center;color:#475569}\n.sd .st{display:inline-block;margin-top:5px;padding:3px 12px;border-radius:8px;font-weight:700;cursor:pointer;border:0;font-size:12.5px}\n.sd.on .st{background:#15803d;color:#fff}.sd.off .st{background:#e5e7eb;color:#374151;border:1px solid #cbd5e1}\n.pumps.edit .pump .st,.pumps.edit .sd .st{pointer-events:none}\n.pumps.edit{border:2px dashed #60a5fa;border-radius:12px;background-color:#f8fbff;background-image:linear-gradient(#e1eaf7 1px,transparent 1px),linear-gradient(90deg,#e1eaf7 1px,transparent 1px);background-size:20px 20px}\n.pumps.edit .pump{cursor:grab;touch-action:none;box-shadow:0 6px 16px rgba(21,101,216,.28);animation:wig .35s ease-in-out infinite alternate}\n.pumps.edit .pump.drag{cursor:grabbing;z-index:9;animation:none;box-shadow:0 14px 30px rgba(0,0,0,.32);transform:scale(1.05)}\n.pumps.edit .pump .st{pointer-events:none}\n@keyframes wig{from{transform:rotate(-1.2deg)}to{transform:rotate(1.2deg)}}\n.pedit{display:flex;gap:8px;align-items:center;flex-wrap:wrap;background:#eff6ff;border:1px solid #93c5fd;color:#1e40af;border-radius:10px;padding:8px 12px;margin-bottom:10px;font-weight:600}\n.phint{color:var(--mut);font-size:12px;margin:8px 0 0}\n.pump.disp{cursor:pointer}.pumps.edit .pump.disp{cursor:grab}\n.gi.xl{width:66px;height:66px;border-radius:18px}\n.dd-h{display:flex;align-items:center;gap:14px;margin-bottom:12px}.dd-h h2{margin:0;font-size:24px;color:#0b2259;display:flex;gap:8px;align-items:center}\n.dd-sides{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}\n.dd-sd{border:1px solid var(--bd);border-radius:14px;padding:12px;background:linear-gradient(180deg,#fff,#f3f7fd)}.dd-sd.on{background:linear-gradient(180deg,#fff,#e9f8ee);border-color:#bbf7d0}\n.dd-sd .top{display:flex;align-items:center;gap:10px;margin-bottom:8px}.dd-sd .top .pi svg{filter:drop-shadow(0 3px 4px rgba(0,0,0,.25)) drop-shadow(0 0 10px currentColor)}\n.dd-sd .top b{font-size:17px}.dd-sd .sum{grid-template-columns:repeat(2,1fr);margin:8px 0}.dd-sd .sum b{font-size:16px}\n.rcv{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;border-radius:10px;padding:8px 10px;font-size:14px}.rcv b{font-size:15px}.rcv span{display:inline-flex;align-items:center;gap:4px}.rcv.no{background:#f8fafc;border-color:var(--bd);color:var(--mut)}\n.ddt{display:flex;align-items:center;gap:8px;font-size:16px;color:#0b2259;margin:16px 0 8px}\n.dd-dirty{display:none;color:#b45309;font-weight:700;font-size:12.5px;margin-left:auto}.dd-dirty.on{display:inline}\n@media (max-width:760px){.dd-sides{grid-template-columns:1fr}}\n.dti-w{position:relative}.dti-w input.dti{color:transparent;cursor:pointer}.dti-w input.dti::-webkit-datetime-edit{opacity:0}\n.dti-w .dts{position:absolute;right:38px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--tx);font-variant-numeric:tabular-nums;unicode-bidi:isolate}\n.stabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;background:linear-gradient(180deg,#0b2259,#0d2a66);padding:8px;border-radius:14px;box-shadow:0 6px 16px rgba(10,30,80,.18)}\n.stabs a{display:flex;align-items:center;gap:8px;padding:8px 14px;white-space:nowrap;border-radius:10px;color:#dbe6ff;font-weight:700;cursor:pointer;flex:1 1 auto;justify-content:center;transition:background .15s}\n.stabs a:hover{background:rgba(255,255,255,.08)}.stabs a.on{background:linear-gradient(90deg,#1d6fe0,#2f8cff);color:#fff;box-shadow:0 4px 14px rgba(30,120,255,.45)}\n.stabs .gi{width:28px;height:28px;border-radius:9px}\n.ltw{display:flex;align-items:center;gap:4px;direction:ltr}.ltw input.lt{flex:1;min-width:0;text-align:right}.ltw .ldot{font-size:20px;line-height:1;color:#0b2259}\n.ltw input.lf{width:32px!important;flex:0 0 32px;text-align:center;padding:8px 0!important;font-weight:800;font-size:15px;background:#fff7ed;border:1px solid #fdba74!important;border-radius:7px}\n.ltw input.lf:focus{outline:2px solid #fb923c}.ltw .lml{color:var(--mut);font-size:11.5px;margin-left:2px}\n.tank.gt{position:relative;overflow:hidden;background:linear-gradient(180deg,#fff 0%,color-mix(in srgb,var(--c) 7%,#fff) 60%,color-mix(in srgb,var(--c) 14%,#fff));border:1px solid color-mix(in srgb,var(--c) 30%,#d6dfec);border-radius:16px;padding:10px 8px 12px;box-shadow:0 6px 16px -6px color-mix(in srgb,var(--c) 45%,transparent),inset 0 1px 0 #fff}\n.tank.gt{cursor:pointer;transition:transform .15s,box-shadow .15s}.tank.gt:hover{transform:translateY(-3px);box-shadow:0 12px 22px -8px color-mix(in srgb,var(--c) 60%,transparent)}\n.orb.big{width:150px;height:150px}.orb.big span{font-size:30px}\n.tank.gt::before{content:'';position:absolute;inset:0 0 auto 0;height:42%;background:linear-gradient(180deg,rgba(255,255,255,.85),rgba(255,255,255,0));pointer-events:none}\n.tank.gt .th{display:flex;align-items:center;justify-content:center;gap:6px;position:relative}.tank.gt .th b{font-size:15.5px;color:#0b2259}\n.tank.gt .nz{color:var(--c);filter:drop-shadow(0 2px 2px rgba(0,0,0,.25)) drop-shadow(0 0 6px color-mix(in srgb,var(--c) 70%,transparent));display:inline-flex}\n.orb{position:relative;width:104px;height:104px;border-radius:50%;margin:10px auto 8px;overflow:hidden;background:radial-gradient(circle at 50% 35%,#fff,#e6edf6 70%,#cfd9e8);border:3px solid #fff;box-shadow:0 0 0 2px color-mix(in srgb,var(--c) 55%,#fff),0 8px 18px -4px color-mix(in srgb,var(--c) 60%,transparent),inset 0 -6px 14px rgba(0,0,0,.18),inset 0 4px 10px rgba(255,255,255,.9)}\n.orb .liq{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(180deg,color-mix(in srgb,var(--c) 65%,#fff),var(--c) 55%,color-mix(in srgb,var(--c) 75%,#000));transition:height .6s}\n.orb .wv{position:absolute;left:-50%;top:-9px;width:200%;height:18px;background:radial-gradient(ellipse at 25% 100%,color-mix(in srgb,var(--c) 60%,#fff) 0 45%,transparent 46%) 0 0/50% 100% repeat-x;animation:wave 3.2s linear infinite;opacity:.95}\n.orb .wv.w2{top:-6px;opacity:.5;animation-duration:5s;animation-direction:reverse}\n@supports not (color:color-mix(in srgb,red 50%,blue)){\n.tank.gt{background:linear-gradient(180deg,#fff 0%,#f6f9fd 60%,#eef3fa);border:1px solid #d6dfec;box-shadow:0 6px 16px -6px rgba(15,35,80,.28),inset 0 1px 0 #fff}\n.tank.gt:hover{box-shadow:0 12px 22px -8px rgba(15,35,80,.35)}\n.tank.gt .nz{filter:drop-shadow(0 2px 2px rgba(0,0,0,.25))}\n.orb{box-shadow:0 0 0 2px var(--c),0 8px 18px -4px rgba(15,35,80,.3),inset 0 -6px 14px rgba(0,0,0,.18),inset 0 4px 10px rgba(255,255,255,.9)}\n.orb .liq{background:linear-gradient(180deg,rgba(255,255,255,.38),rgba(255,255,255,0) 50%,rgba(0,0,0,.22)),var(--c)}\n.orb .wv{background:radial-gradient(ellipse at 25% 100%,var(--c) 0 45%,transparent 46%) 0 0/50% 100% repeat-x;opacity:.75}\n.orb .wv.w2{opacity:.4}\n}\n@keyframes wave{from{transform:translateX(0)}to{transform:translateX(25%)}}\n.orb .gl{position:absolute;left:14%;top:8%;width:52%;height:34%;border-radius:50%;background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,.05));transform:rotate(-18deg);pointer-events:none}\n.orb::after{content:'';position:absolute;top:-60%;left:-80%;width:40%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);transform:rotate(25deg);animation:gshine 5s ease-in-out infinite;pointer-events:none}\n.orb span{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-weight:900;font-size:22px;color:#fff;background:rgba(8,18,45,.62);border:1.5px solid rgba(255,255,255,.85);border-radius:14px;padding:1px 10px;line-height:1.3;text-shadow:0 1px 2px #000;box-shadow:0 3px 8px rgba(0,0,0,.35);z-index:2;direction:ltr;unicode-bidi:isolate;letter-spacing:.5px}\n.tank.gt .q{font-weight:800;font-size:15px;color:#0b2259;position:relative}.tank.gt .c{color:var(--mut);font-size:12px;position:relative}.tank.gt .fn{display:inline-block;margin-top:5px;font-size:11.5px;font-weight:800;color:var(--ct,#fff);background:var(--c);text-shadow:none;box-shadow:0 1px 3px rgba(0,0,0,.25);border-radius:7px;padding:1px 10px;position:relative}\n.tank.gt.low .orb{animation:lowp 1.4s ease-in-out infinite}@keyframes lowp{50%{box-shadow:0 0 0 3px #ef4444,0 0 18px 4px rgba(239,68,68,.55),inset 0 -6px 14px rgba(0,0,0,.18)}}\n@media (prefers-reduced-motion:reduce){.orb .wv,.orb::after,.tank.gt.low .orb{animation:none}}\n.mbox>h3{display:flex;align-items:center;ga